<% locals.currentPath = '/logs'; %>
<%- include('../partials/head', { title: 'Logi aktywności' }) %>
<%- include('../partials/nav') %>

<main class="md:ml-60 min-h-screen p-6 pt-20 md:pt-6">
  <div class="max-w-6xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-bold text-slate-800">Logi aktywności</h1>
      <span class="text-sm text-slate-500"><%= total %> wpisów</span>
    </div>

    <form method="GET" action="/logs" class="bg-white rounded-xl border border-slate-200 p-4 mb-4 flex flex-wrap gap-3 items-end">
      <div class="flex-1 min-w-48">
        <label class="block text-xs font-medium text-slate-600 mb-1">Szukaj</label>
        <input type="text" name="q" value="<%= search %>" placeholder="akcja, użytkownik, szczegóły…"
          class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-600 mb-1">Od</label>
        <input type="date" name="from" value="<%= dateFrom %>"
          class="px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-600 mb-1">Do</label>
        <input type="date" name="to" value="<%= dateTo %>"
          class="px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <button type="submit" class="btn btn-primary">Filtruj</button>
      <% if (search || dateFrom || dateTo) { %>
        <a href="/logs" class="btn btn-secondary">Wyczyść</a>
      <% } %>
    </form>

    <div class="bg-white rounded-xl border border-slate-200 overflow-x-auto">
      <% if (logs.length === 0) { %>
        <div class="p-12 text-center text-slate-400">Brak wpisów.</div>
      <% } else { %>
      <table class="w-full min-w-[640px]">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide w-36">Data i czas</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide w-32">Użytkownik</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide w-24">Rola</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide w-56">Akcja</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wide">Szczegóły</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% logs.forEach(function(entry) { %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-2.5 text-xs text-slate-400 whitespace-nowrap font-mono">
              <%= entry.created_at ? entry.created_at.replace('T',' ').substring(0,16) : '' %>
            </td>
            <td class="px-4 py-2.5 text-xs font-medium text-slate-800"><%= entry.user_name %></td>
            <td class="px-4 py-2.5">
              <span class="text-xs px-2 py-0.5 rounded-full font-medium
                <%= entry.user_role === 'admin' ? 'bg-red-100 text-red-700' : entry.user_role === 'location_manager' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700' %>">
                <%= entry.user_role === 'admin' ? 'Admin' : entry.user_role === 'location_manager' ? 'Kierownik' : 'Pracownik' %>
              </span>
            </td>
            <td class="px-4 py-2.5 text-xs text-slate-700 font-medium"><%= entry.action %></td>
            <td class="px-4 py-2.5 text-xs text-slate-500 max-w-xs truncate" title="<%= entry.details || '' %>"><%= entry.details || '' %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>

    <% if (totalPages > 1) { %>
    <% const qs = (p) => `?page=${p}&q=${encodeURIComponent(search)}&from=${dateFrom}&to=${dateTo}`; %>
    <div class="flex items-center justify-between mt-4 text-sm">
      <span class="text-slate-500">Strona <%= page %> z <%= totalPages %></span>
      <div class="flex gap-2">
        <% if (page > 1) { %><a href="/logs<%= qs(page-1) %>" class="btn btn-secondary">← Poprzednia</a><% } %>
        <% if (page < totalPages) { %><a href="/logs<%= qs(page+1) %>" class="btn btn-secondary">Następna →</a><% } %>
      </div>
    </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
