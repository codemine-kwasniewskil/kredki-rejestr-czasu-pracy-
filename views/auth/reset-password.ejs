<!DOCTYPE html>
<html lang="pl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Nowe hasło – Graficzek</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-900 min-h-screen flex items-center justify-center">
  <div class="w-full max-w-sm">
    <div class="text-center mb-8">
      <div class="text-5xl mb-3">☕</div>
      <h1 class="text-2xl font-bold text-white">Graficzek</h1>
      <p class="text-slate-400 text-sm mt-1">Ustaw nowe hasło</p>
    </div>

    <div class="bg-white rounded-2xl shadow-xl p-8">
      <% if (error && error.length) { %>
        <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm"><%= error[0] %></div>
      <% } %>

      <form action="/reset-password" method="POST" class="space-y-4">
        <input type="hidden" name="token" value="<%= token %>">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Nowe hasło</label>
          <input
            type="password" name="password" required autofocus autocomplete="new-password"
            class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
            placeholder="min. 6 znaków"
          >
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1">Powtórz hasło</label>
          <input
            type="password" name="password_confirm" required autocomplete="new-password"
            class="w-full px-3 py-2.5 border border-slate-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent text-sm"
            placeholder="••••••••"
          >
        </div>
        <button type="submit" class="w-full bg-blue-600 text-white py-2.5 rounded-lg font-medium hover:bg-blue-700 transition-colors text-sm">
          Zapisz hasło
        </button>
      </form>
    </div>

    <p class="text-center text-slate-400 text-xs mt-4">
      <a href="/login" class="text-blue-400 hover:text-blue-300 underline">Wróć do logowania</a>
    </p>
    <p class="text-center text-slate-500 text-xs mt-3">graficzek.pl &copy; 2026</p>
  </div>
</body>
</html>
