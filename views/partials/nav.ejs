<% const p = locals.currentPath || ''; %>
<% const locName = locals.currentLocation ? locals.currentLocation.name : 'Cafe'; %>
<% const f = locals.features || {}; %>

<!-- Mobile top bar -->
<div class="no-print md:hidden fixed top-0 left-0 right-0 h-14 bg-slate-800 flex items-center px-4 z-30 border-b border-slate-700">
  <button id="menuToggle" onclick="openSidebar()" class="text-slate-300 hover:text-white p-1.5 rounded-md hover:bg-slate-700 transition-colors">
    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
  </button>
  <div class="flex items-center gap-2 ml-3">
    <span class="text-xl">☕</span>
    <span class="text-white font-bold text-sm"><%= locName %></span>
  </div>
</div>

<!-- Backdrop -->
<div id="sidebarBackdrop" onclick="closeSidebar()" class="hidden fixed inset-0 bg-black/50 z-20 md:hidden"></div>

<aside id="sidebar" class="no-print fixed inset-y-0 left-0 w-60 bg-slate-800 flex flex-col z-30 -translate-x-full md:translate-x-0 transition-transform duration-300" style="min-height: 100dvh">
  <div class="px-4 py-5 border-b border-slate-700">
    <div class="flex items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="text-2xl">☕</span>
        <div>
          <div class="text-white font-bold text-base leading-tight"><%= locName %></div>
          <div class="text-slate-400 text-xs">Rejestr czasu pracy</div>
        </div>
      </div>
      <button onclick="closeSidebar()" class="md:hidden text-slate-400 hover:text-white p-1 rounded transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <% if (user && user.role === 'super_admin' && locals.allLocations && allLocations.length > 1) { %>
    <form method="POST" action="/locations/switch" class="mt-3">
      <select name="locationId" onchange="this.form.submit()" class="w-full text-xs bg-slate-700 text-slate-200 border border-slate-600 rounded px-2 py-1.5 focus:outline-none focus:border-blue-400">
        <% allLocations.forEach(loc => { %>
          <option value="<%= loc.id %>" <%= (currentLocation && currentLocation.id === loc.id) ? 'selected' : '' %>><%= loc.name %></option>
        <% }) %>
      </select>
    </form>
    <% } %>
  </div>

  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
    <a href="/dashboard" class="nav-link <%= p.startsWith('/dashboard') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      Panel główny
    </a>

    <% if (f.schedule !== false) { %>
    <a href="/schedule" class="nav-link <%= p.startsWith('/schedule') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      Grafik
    </a>
    <% } %>

    <% if (f.availability !== false) { %>
    <a href="/availability" class="nav-link <%= p.startsWith('/availability') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Dostępność
    </a>
    <% } %>

    <% if (f.stock !== false) { %>
    <a href="/stock" class="nav-link <%= p.startsWith('/stock') && !p.startsWith('/stock/admin') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
      Raport Stanów
    </a>
    <% if (user && (user.role === 'admin' || user.role === 'location_manager' || user.role === 'super_admin')) { %>
    <a href="/stock/admin" class="nav-link pl-9 text-xs <%= p.startsWith('/stock/admin') ? 'active' : '' %>">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      Zarządzaj stanami
    </a>
    <% } %>
    <% } %>

    <% if (user && user.role === 'location_manager') { %>
    <div class="pt-2 pb-1 px-1">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Zarządzanie</div>
    </div>
    <% if (f.shifts !== false) { %>
    <a href="/shifts" class="nav-link <%= p.startsWith('/shifts') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Szablony zmian
    </a>
    <% } %>
    <% if (f.reports !== false) { %>
    <a href="/reports" class="nav-link <%= p === '/reports' ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      Raport dostępności
    </a>
    <a href="/reports/employee" class="nav-link <%= p.startsWith('/reports/employee') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
      Raport godzin
    </a>
    <% } %>
    <% } %>

    <% if (user && (user.role === 'admin' || user.role === 'super_admin')) { %>
    <div class="pt-2 pb-1 px-1">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Zarządzanie</div>
    </div>
    <% if (f.shifts !== false) { %>
    <a href="/shifts" class="nav-link <%= p.startsWith('/shifts') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Szablony zmian
    </a>
    <% } %>
    <% if (f.contracts !== false) { %>
    <a href="/contracts" class="nav-link <%= p.startsWith('/contracts') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
      Umowy
    </a>
    <% } %>
    <% if (f.users !== false) { %>
    <a href="/users" class="nav-link <%= p.startsWith('/users') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      Użytkownicy
      <% if (user && user.role === 'super_admin' && locals.pendingRegistrations && pendingRegistrations > 0) { %>
        <span class="ml-auto inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 bg-amber-500 text-white text-xs font-bold rounded-full"><%= pendingRegistrations %></span>
      <% } %>
    </a>
    <% } %>
    <% if (f.logs !== false) { %>
    <a href="/logs" class="nav-link <%= p.startsWith('/logs') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
      Logi aktywności
    </a>
    <% } %>
    <% if (f.reports !== false) { %>
    <a href="/reports" class="nav-link <%= p === '/reports' ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
      Raport dostępności
    </a>
    <a href="/reports/employee" class="nav-link <%= p.startsWith('/reports/employee') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/></svg>
      Raport godzin
    </a>
    <% } %>

    <% if (f.finance !== false) { %>
    <div class="pt-2 pb-1 px-1">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">Finanse</div>
    </div>
    <a href="/finance/monthly" class="nav-link <%= p.startsWith('/finance/monthly') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      Raport finansowy
    </a>
    <a href="/finance/payroll" class="nav-link <%= p.startsWith('/finance/payroll') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      Koszty pracownicze
    </a>
    <a href="/finance/import" class="nav-link <%= p.startsWith('/finance/import') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
      Import wyciągu
    </a>
    <% } %>

    <% if (user.role === 'super_admin') { %>
    <div class="pt-2 pb-1 px-1">
      <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider">System</div>
    </div>
    <a href="/locations" class="nav-link <%= p.startsWith('/locations') ? 'active' : '' %>">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      Lokalizacje
    </a>
    <% } %>
    <% } %>
  </nav>

  <div class="px-3 py-4 border-t border-slate-700">
    <div class="flex items-center gap-3 px-1 mb-2">
      <div class="w-8 h-8 rounded-full bg-blue-600 flex items-center justify-center text-white text-sm font-bold">
        <%= user ? user.name.charAt(0).toUpperCase() : '?' %>
      </div>
      <div class="flex-1 min-w-0">
        <div class="text-white text-sm font-medium truncate"><%= user ? user.name : '' %></div>
        <div class="text-slate-400 text-xs">
          <% if (user) { %>
            <%= user.role === 'super_admin' ? 'Super Admin' : user.role === 'admin' ? 'Administrator' : user.role === 'location_manager' ? 'Kierownik' : 'Pracownik' %>
          <% } %>
        </div>
      </div>
    </div>
    <a href="/logout" class="nav-link text-slate-400 hover:text-red-400">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
      Wyloguj
    </a>
    <p class="text-slate-600 text-xs mt-3 px-1">
      <a href="mailto:hello@graficzek.pl" class="hover:text-slate-300 transition-colors">hello@graficzek.pl</a>
    </p>
  </div>
</aside>

<script>
function openSidebar() {
  document.getElementById('sidebar').classList.remove('-translate-x-full');
  document.getElementById('sidebarBackdrop').classList.remove('hidden');
  document.body.style.overflow = 'hidden';
}
function closeSidebar() {
  document.getElementById('sidebar').classList.add('-translate-x-full');
  document.getElementById('sidebarBackdrop').classList.add('hidden');
  document.body.style.overflow = '';
}
</script>
