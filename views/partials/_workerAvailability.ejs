<!-- Worker availability completeness (current + next month). Expects: workerAvailability, availCurLabel, availNextLabel -->
<div class="bg-white rounded-xl border border-slate-200 p-5 mb-4">
  <div class="flex items-center justify-between mb-3">
    <h2 class="font-semibold text-slate-700 flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-blue-400"></span> Dostępność pracowników
    </h2>
    <a href="/availability" class="text-xs text-blue-600 hover:underline">Otwórz dostępność →</a>
  </div>
  <% if (!workerAvailability || workerAvailability.length === 0) { %>
    <p class="text-slate-400 text-sm">Brak pracowników.</p>
  <% } else { %>
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs text-slate-400 border-b border-slate-100">
            <th class="py-1.5 pr-2 font-medium">Pracownik</th>
            <th class="py-1.5 px-2 font-medium text-center capitalize"><%= availCurLabel %></th>
            <th class="py-1.5 px-2 font-medium text-center capitalize"><%= availNextLabel %></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-50">
          <% workerAvailability.forEach(function(w) { %>
          <tr>
            <td class="py-1.5 pr-2 text-slate-700 truncate max-w-[10rem]"><%= w.name %></td>
            <td class="py-1.5 px-2 text-center">
              <% if (w.curFilled) { %>
                <span title="Komplet (<%= w.curCnt %>/<%= w.curDays %> dni)" class="inline-flex items-center gap-1 text-emerald-600">●</span>
              <% } else { %>
                <a href="/availability?userId=<%= w.id %>" title="Brakuje dni (<%= w.curCnt %>/<%= w.curDays %>)" class="inline-flex items-center gap-1 text-red-500 hover:underline">● <span class="text-xs text-slate-400"><%= w.curCnt %>/<%= w.curDays %></span></a>
              <% } %>
            </td>
            <td class="py-1.5 px-2 text-center">
              <% if (w.nextFilled) { %>
                <span title="Komplet (<%= w.nextCnt %>/<%= w.nextDays %> dni)" class="inline-flex items-center gap-1 text-emerald-600">●</span>
              <% } else { %>
                <a href="/availability?userId=<%= w.id %>" title="Brakuje dni (<%= w.nextCnt %>/<%= w.nextDays %>)" class="inline-flex items-center gap-1 text-red-500 hover:underline">● <span class="text-xs text-slate-400"><%= w.nextCnt %>/<%= w.nextDays %></span></a>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <p class="text-xs text-slate-400 mt-2"><span class="text-emerald-600">●</span> komplet dni &nbsp; <span class="text-red-500">●</span> brakuje dni (kliknij, aby uzupełnić)</p>
  <% } %>
</div>
