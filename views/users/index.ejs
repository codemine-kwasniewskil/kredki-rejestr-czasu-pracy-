<% locals.currentPath = '/users'; %>
<%- include('../partials/head', { title: 'Użytkownicy' }) %>
<%- include('../partials/nav') %>

<main class="md:ml-60 min-h-screen p-6 pt-20 md:pt-6">
  <div class="max-w-5xl mx-auto">
    <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
      <h1 class="text-xl font-bold text-slate-800">Użytkownicy</h1>
      <div class="flex items-center gap-2 flex-wrap">
        <button onclick="document.getElementById('addUserModal').classList.remove('hidden')" class="btn btn-primary">
          + Dodaj użytkownika
        </button>
      </div>
    </div>

    <% if (success && success.length) { %>
      <div class="mb-4 p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-700 text-sm"><%= success[0] %></div>
    <% } %>
    <% if (error && error.length) { %>
      <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm"><%= error[0] %></div>
    <% } %>

    <% if (user && user.role === 'super_admin' && pendingUsers && pendingUsers.length > 0) { %>
    <div class="mb-6">
      <h2 class="text-sm font-semibold text-amber-700 uppercase tracking-wide mb-2 flex items-center gap-2">
        <span class="inline-flex items-center justify-center w-5 h-5 bg-amber-500 text-white text-xs rounded-full font-bold"><%= pendingUsers.length %></span>
        Oczekujące rejestracje
      </h2>
      <div class="bg-white rounded-xl border border-amber-200 overflow-x-auto">
        <table class="w-full min-w-[520px]">
          <thead class="bg-amber-50 border-b border-amber-200">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold text-amber-700 uppercase">Imię i nazwisko</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-amber-700 uppercase">Email</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-amber-700 uppercase">Kawiarnia / Restauracja</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-amber-700 uppercase">Data rejestracji</th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-amber-700 uppercase">Akcje</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-amber-100">
            <% pendingUsers.forEach(pu => { %>
            <tr class="hover:bg-amber-50">
              <td class="px-4 py-3 text-sm font-medium text-slate-800"><%= pu.name %></td>
              <td class="px-4 py-3 text-sm text-slate-600"><%= pu.email || '—' %></td>
              <td class="px-4 py-3 text-sm text-slate-600"><%= pu.company_name || '—' %></td>
              <td class="px-4 py-3 text-sm text-slate-500"><%= pu.created_at ? new Date(pu.created_at).toLocaleDateString('pl-PL') : '—' %></td>
              <td class="px-4 py-3 text-right flex items-center justify-end gap-2">
                <button onclick="openApprove(<%= JSON.stringify({id: pu.id, name: pu.name, email: pu.email}) %>)" class="btn btn-primary text-xs">Zatwierdź</button>
                <form action="/users/<%= pu.id %>/pending?_method=DELETE" method="POST" onsubmit="return confirm('Odrzucić rejestrację użytkownika <%= pu.name %>?')">
                  <button type="submit" class="btn btn-danger text-xs">Odrzuć</button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

    <div class="bg-white rounded-xl border border-slate-200 overflow-x-auto">
      <table class="w-full min-w-[640px]">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Imię i nazwisko</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Użytkownik / Kontakt</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Rola</th>
            <% if (user && user.role === 'super_admin') { %>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Lokalizacja</th>
            <% } %>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Min. godz.</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Status</th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Akcje</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% users.forEach(u => { %>
          <tr class="hover:bg-slate-50">
            <td class="px-4 py-3 text-sm font-medium text-slate-800"><%= u.name %></td>
            <td class="px-4 py-3">
              <div class="text-sm font-mono text-slate-700"><%= u.username || u.email || '—' %></div>
              <% if (u.contact_email) { %><div class="text-xs text-slate-400">✉ <%= u.contact_email %></div><% } %>
              <% if (u.phone) { %><div class="text-xs text-slate-400">📞 <%= u.phone %></div><% } %>
            </td>
            <td class="px-4 py-3">
              <span class="text-xs px-2 py-1 rounded-full font-medium
                <%= u.role === 'super_admin' ? 'bg-red-100 text-red-700' : u.role === 'admin' ? 'bg-purple-100 text-purple-700' : u.role === 'location_manager' ? 'bg-blue-100 text-blue-700' : 'bg-slate-100 text-slate-600' %>">
                <%= u.role === 'super_admin' ? 'Super Admin' : u.role === 'admin' ? 'Administrator' : u.role === 'location_manager' ? 'Kierownik' : 'Pracownik' %>
              </span>
            </td>
            <% if (user && user.role === 'super_admin') { %>
            <td class="px-4 py-3 text-sm text-slate-500"><%= u.location_name || '—' %></td>
            <% } %>
            <td class="px-4 py-3 text-sm text-slate-500">
              <%= u.min_hours_per_month != null ? u.min_hours_per_month + 'h/mies.' : '—' %>
            </td>
            <td class="px-4 py-3">
              <div class="flex flex-col gap-1">
                <span class="text-xs px-2 py-1 rounded-full <%= u.active ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-600' %>">
                  <%= u.active ? 'Aktywny' : 'Nieaktywny' %>
                </span>
                <% if (u.must_change_password) { %>
                <span class="text-xs px-2 py-1 rounded-full bg-amber-100 text-amber-700">Zmiana hasła</span>
                <% } %>
              </div>
            </td>
            <td class="px-4 py-3 text-right flex items-center justify-end gap-2 flex-wrap">
              <a href="/users/<%= u.id %>/edit" class="btn btn-secondary text-xs">Edytuj</a>
              <% if (u.id !== user.id) { %>
              <form action="/users/<%= u.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Dezaktywować użytkownika?')">
                <button type="submit" class="btn btn-danger text-xs">Dezaktywuj</button>
              </form>
              <% if (user.role === 'super_admin' && u.role !== 'super_admin') { %>
              <form action="/users/<%= u.id %>/delete" method="POST" onsubmit="return confirm('Trwale usunąć użytkownika &quot;<%= u.name %>&quot; i jego dane (umowy, dostępność)?\n\nTej operacji NIE można cofnąć.')">
                <button type="submit" class="btn btn-danger text-xs">Usuń trwale</button>
              </form>
              <% } %>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<!-- Add User Modal -->
<div id="addUserModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between p-5 border-b border-slate-200">
      <h3 class="font-semibold text-slate-800">Dodaj użytkownika</h3>
      <button onclick="document.getElementById('addUserModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 text-xl">✕</button>
    </div>
    <form action="/users" method="POST" class="p-5 space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Imię i nazwisko <span class="text-red-500">*</span></label>
        <input type="text" name="name" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Nazwa użytkownika <span class="text-red-500">*</span></label>
        <input type="text" name="username" required autocomplete="off"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono"
          placeholder="np. jan.kowalski">
        <p class="text-xs text-slate-400 mt-1">Służy do logowania. Bez spacji, najlepiej bez polskich liter.</p>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Email do logowania</label>
        <input type="email" name="email" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="opcjonalnie — umożliwia logowanie emailem">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">E-mail kontaktowy</label>
          <input type="email" name="contact_email" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="opcjonalnie">
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Telefon</label>
          <input type="tel" name="phone" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="opcjonalnie">
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Hasło <span class="text-red-500">*</span></label>
        <div class="flex gap-2">
          <input type="text" id="addPasswordField" name="password" required class="flex-1 px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Wpisz lub wygeneruj">
          <button type="button" onclick="generatePassword('addPasswordField')" class="btn btn-secondary text-xs whitespace-nowrap">Generuj</button>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Rola <span class="text-red-500">*</span></label>
        <select name="role" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="worker">Pracownik</option>
          <option value="location_manager">Kierownik</option>
          <option value="admin">Administrator</option>
          <% if (user && user.role === 'super_admin') { %>
          <option value="super_admin">Super Admin</option>
          <% } %>
        </select>
      </div>
      <% if (user && user.role === 'super_admin' && locals.locations && locations.length > 1) { %>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Lokalizacja</label>
        <select name="location_id" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <% locations.forEach(loc => { %>
          <option value="<%= loc.id %>" <%= currentLocationId === loc.id ? 'selected' : '' %>><%= loc.name %></option>
          <% }) %>
        </select>
      </div>
      <% } %>
      <div class="flex gap-3 pt-1">
        <button type="button" onclick="document.getElementById('addUserModal').classList.add('hidden')" class="flex-1 py-2.5 border border-slate-300 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50">Anuluj</button>
        <button type="submit" class="flex-1 py-2.5 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Dodaj</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit User Modal (shown when editUser is set) -->
<% if (editUser) { %>
<div id="editUserModal" class="fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between p-5 border-b border-slate-200">
      <h3 class="font-semibold text-slate-800">Edytuj użytkownika</h3>
      <a href="/users" class="text-slate-400 hover:text-slate-600 text-xl">✕</a>
    </div>
    <form action="/users/<%= editUser.id %>?_method=PUT" method="POST" class="p-5 space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Imię i nazwisko <span class="text-red-500">*</span></label>
        <input type="text" name="name" value="<%= editUser.name %>" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Nazwa użytkownika <span class="text-red-500">*</span></label>
        <input type="text" name="username" value="<%= editUser.username || editUser.email || '' %>" required autocomplete="off"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono">
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Email do logowania</label>
        <input type="email" name="email" value="<%= editUser.email || '' %>"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="opcjonalnie">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">E-mail kontaktowy</label>
          <input type="email" name="contact_email" value="<%= editUser.contact_email || '' %>"
            class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="opcjonalnie">
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Telefon</label>
          <input type="tel" name="phone" value="<%= editUser.phone || '' %>"
            class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="opcjonalnie">
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Nowe hasło (puste = bez zmian)</label>
        <div class="flex gap-2">
          <input type="text" id="editPasswordField" name="password" class="flex-1 px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Pozostaw puste by nie zmieniać">
          <button type="button" onclick="generatePassword('editPasswordField')" class="btn btn-secondary text-xs whitespace-nowrap">Generuj</button>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Rola</label>
        <select name="role" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="worker" <%= editUser.role === 'worker' ? 'selected' : '' %>>Pracownik</option>
          <option value="location_manager" <%= editUser.role === 'location_manager' ? 'selected' : '' %>>Kierownik</option>
          <option value="admin" <%= editUser.role === 'admin' ? 'selected' : '' %>>Administrator</option>
          <% if (user && user.role === 'super_admin') { %>
          <option value="super_admin" <%= editUser.role === 'super_admin' ? 'selected' : '' %>>Super Admin</option>
          <% } %>
        </select>
      </div>
      <% if (user && user.role === 'super_admin' && locals.locations && locations.length > 1) { %>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Lokalizacja</label>
        <select name="location_id" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="">— brak (super admin) —</option>
          <% locations.forEach(loc => { %>
          <option value="<%= loc.id %>" <%= editUser.location_id === loc.id ? 'selected' : '' %>><%= loc.name %></option>
          <% }) %>
        </select>
      </div>
      <% } %>
      <div class="flex items-center gap-2">
        <input type="checkbox" name="active" id="activeCheck" value="1" <%= editUser.active ? 'checked' : '' %> class="rounded">
        <label for="activeCheck" class="text-sm font-medium text-slate-700">Konto aktywne</label>
      </div>
      <div class="flex items-center gap-2">
        <input type="checkbox" name="must_change_password" id="mustChangePasswordCheck" value="1" <%= editUser.must_change_password ? 'checked' : '' %> class="rounded">
        <label for="mustChangePasswordCheck" class="text-sm font-medium text-slate-700">Wymagaj zmiany hasła przy logowaniu</label>
      </div>
      <div class="flex gap-3 pt-1">
        <a href="/users" class="flex-1 py-2.5 border border-slate-300 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50 text-center">Anuluj</a>
        <button type="submit" class="flex-1 py-2.5 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Zapisz</button>
      </div>
    </form>
  </div>
</div>
<% } %>

<!-- Approve Registration Modal -->
<div id="approveModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md">
    <div class="flex items-center justify-between p-5 border-b border-slate-200">
      <h3 class="font-semibold text-slate-800">Zatwierdź rejestrację</h3>
      <button onclick="document.getElementById('approveModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 text-xl">✕</button>
    </div>
    <form id="approveForm" method="POST" class="p-5 space-y-4">
      <p class="text-sm text-slate-600">Użytkownik: <strong id="approveName"></strong></p>
      <p class="text-xs text-slate-400" id="approveEmail"></p>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Nazwa użytkownika <span class="text-red-500">*</span></label>
        <input type="text" name="username" id="approveUsername" required autocomplete="off"
          class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 font-mono"
          placeholder="np. jan.kowalski">
        <p class="text-xs text-slate-400 mt-1">Służy do logowania (razem z emailem).</p>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Rola <span class="text-red-500">*</span></label>
        <select name="role" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <option value="worker">Pracownik</option>
          <option value="location_manager">Kierownik</option>
          <option value="admin">Administrator</option>
        </select>
      </div>
      <% if (user && user.role === 'super_admin' && locals.locations && locations.length > 1) { %>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Lokalizacja <span class="text-red-500">*</span></label>
        <select name="location_id" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
          <% locations.forEach(loc => { %>
          <option value="<%= loc.id %>" <%= currentLocationId === loc.id ? 'selected' : '' %>><%= loc.name %></option>
          <% }) %>
        </select>
      </div>
      <% } %>
      <p class="text-xs text-slate-500">Użytkownik otrzyma flagę "zmiana hasła" i będzie musiał ustawić nowe hasło przy pierwszym logowaniu.</p>
      <div class="flex gap-3 pt-1">
        <button type="button" onclick="document.getElementById('approveModal').classList.add('hidden')" class="flex-1 py-2.5 border border-slate-300 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50">Anuluj</button>
        <button type="submit" class="flex-1 py-2.5 bg-emerald-600 text-white rounded-lg text-sm font-medium hover:bg-emerald-700">Zatwierdź</button>
      </div>
    </form>
  </div>
</div>

<script>
function generatePassword(fieldId) {
  const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghjkmnpqrstuvwxyz23456789';
  let pwd = '';
  for (let i = 0; i < 10; i++) pwd += chars[Math.floor(Math.random() * chars.length)];
  const field = document.getElementById(fieldId);
  field.value = pwd;
  field.type = 'text';
}
function openApprove(pu) {
  document.getElementById('approveForm').action = '/users/' + pu.id + '/approve';
  document.getElementById('approveName').textContent = pu.name;
  document.getElementById('approveEmail').textContent = pu.email ? 'Email: ' + pu.email : '';
  document.getElementById('approveUsername').value = '';
  document.getElementById('approveModal').classList.remove('hidden');
}
</script>
<%- include('../partials/footer') %>
