<% locals.currentPath = '/shifts'; %>
<%- include('../partials/head', { title: 'Szablony zmian' }) %>
<%- include('../partials/nav') %>

<main class="md:ml-60 min-h-screen p-6 pt-20 md:pt-6">
  <div class="max-w-3xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-xl font-bold text-slate-800">Szablony zmian</h1>
      <button onclick="document.getElementById('addModal').classList.remove('hidden')" class="btn btn-primary">
        + Nowy szablon
      </button>
    </div>

    <% if (success && success.length) { %>
      <div class="mb-4 p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-700 text-sm"><%= success[0] %></div>
    <% } %>
    <% if (error && error.length) { %>
      <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm"><%= error[0] %></div>
    <% } %>

    <div class="bg-white rounded-xl border border-slate-200 overflow-x-auto">
      <% if (templates.length === 0) { %>
        <div class="p-12 text-center text-slate-400">Brak szablonów zmian.</div>
      <% } else { %>
      <p class="px-4 pt-3 text-xs text-slate-400">Przeciągnij wiersze aby zmienić kolejność szablonów.</p>
      <table class="w-full min-w-[480px]">
        <thead class="bg-slate-50 border-b border-slate-200">
          <tr>
            <th class="w-8 px-2 py-3"></th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Kolor</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Nazwa</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Czas</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Czas trwania</th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Akcje</th>
          </tr>
        </thead>
        <tbody id="templatesList" class="divide-y divide-slate-100">
          <% templates.forEach(t => {
            const [sh, sm] = t.start_time.split(':').map(Number);
            const [eh, em] = t.end_time.split(':').map(Number);
            let mins = (eh * 60 + em) - (sh * 60 + sm);
            if (mins < 0) mins += 24 * 60;
            const dur = mins >= 60 ? `${Math.floor(mins/60)}h ${mins%60>0 ? mins%60+'m' : ''}`.trim() : `${mins}m`;
          %>
          <tr class="hover:bg-slate-50 draggable-row" data-id="<%= t.id %>" draggable="true">
            <td class="px-2 py-3 text-center text-slate-300 cursor-grab select-none text-lg leading-none" title="Przeciągnij aby zmienić kolejność">☰</td>
            <td class="px-4 py-3">
              <span class="inline-block w-8 h-8 rounded-lg shadow-sm" style="background-color:<%= t.color %>"></span>
            </td>
            <td class="px-4 py-3 text-sm font-medium text-slate-800"><%= t.name %></td>
            <td class="px-4 py-3 text-sm text-slate-600 font-mono"><%= t.start_time %> – <%= t.end_time %></td>
            <td class="px-4 py-3 text-sm text-slate-500"><%= dur %></td>
            <td class="px-4 py-3 text-right flex items-center justify-end gap-2">
              <button onclick="openEdit(<%= JSON.stringify(t) %>)" class="btn btn-secondary text-xs">Edytuj</button>
              <form action="/shifts/<%= t.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Usunąć ten szablon?')">
                <button type="submit" class="btn btn-danger text-xs">Usuń</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </div>
</main>

<!-- Add Modal -->
<div id="addModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md">
    <div class="flex items-center justify-between p-5 border-b border-slate-200">
      <h3 class="font-semibold text-slate-800">Nowy szablon zmiany</h3>
      <button onclick="document.getElementById('addModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 text-xl">✕</button>
    </div>
    <form action="/shifts" method="POST" class="p-5 space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Nazwa</label>
        <input type="text" name="name" required placeholder="np. Zmiana ranna" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Początek</label>
          <div id="addStartPicker" class="time-picker flex items-center gap-1">
            <select required class="tp-hour flex-1 px-2 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="syncTimePicker(this.closest('.time-picker'))">
              <option value="">hh</option>
              <% for(let h=0;h<24;h++){const hh=String(h).padStart(2,'0'); %><option value="<%= hh %>"><%= hh %></option><% } %>
            </select>
            <span class="text-slate-400 font-semibold">:</span>
            <select required class="tp-min w-16 px-2 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="syncTimePicker(this.closest('.time-picker'))">
              <option value="">mm</option>
              <option value="00">00</option><option value="15">15</option><option value="30">30</option><option value="45">45</option>
            </select>
            <input type="hidden" name="start_time">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Koniec</label>
          <div id="addEndPicker" class="time-picker flex items-center gap-1">
            <select required class="tp-hour flex-1 px-2 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="syncTimePicker(this.closest('.time-picker'))">
              <option value="">hh</option>
              <% for(let h=0;h<24;h++){const hh=String(h).padStart(2,'0'); %><option value="<%= hh %>"><%= hh %></option><% } %>
            </select>
            <span class="text-slate-400 font-semibold">:</span>
            <select required class="tp-min w-16 px-2 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="syncTimePicker(this.closest('.time-picker'))">
              <option value="">mm</option>
              <option value="00">00</option><option value="15">15</option><option value="30">30</option><option value="45">45</option>
            </select>
            <input type="hidden" name="end_time">
          </div>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Kolor</label>
        <div class="flex items-center gap-3">
          <input type="color" name="color" value="#3B82F6" class="w-10 h-10 rounded cursor-pointer border border-slate-300">
          <span class="text-xs text-slate-500">Kliknij by wybrać kolor zmiany</span>
        </div>
      </div>
      <div class="flex gap-3 pt-1">
        <button type="button" onclick="document.getElementById('addModal').classList.add('hidden')" class="flex-1 py-2.5 border border-slate-300 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50">Anuluj</button>
        <button type="submit" class="flex-1 py-2.5 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Dodaj</button>
      </div>
    </form>
  </div>
</div>

<!-- Edit Modal -->
<div id="editModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-md">
    <div class="flex items-center justify-between p-5 border-b border-slate-200">
      <h3 class="font-semibold text-slate-800">Edytuj szablon</h3>
      <button onclick="document.getElementById('editModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 text-xl">✕</button>
    </div>
    <form id="editForm" method="POST" class="p-5 space-y-4">
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Nazwa</label>
        <input type="text" name="name" id="editName" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
      </div>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Początek</label>
          <div id="editStartPicker" class="time-picker flex items-center gap-1">
            <select required class="tp-hour flex-1 px-2 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="syncTimePicker(this.closest('.time-picker'))">
              <option value="">hh</option>
              <% for(let h=0;h<24;h++){const hh=String(h).padStart(2,'0'); %><option value="<%= hh %>"><%= hh %></option><% } %>
            </select>
            <span class="text-slate-400 font-semibold">:</span>
            <select required class="tp-min w-16 px-2 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="syncTimePicker(this.closest('.time-picker'))">
              <option value="">mm</option>
              <option value="00">00</option><option value="15">15</option><option value="30">30</option><option value="45">45</option>
            </select>
            <input type="hidden" name="start_time">
          </div>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Koniec</label>
          <div id="editEndPicker" class="time-picker flex items-center gap-1">
            <select required class="tp-hour flex-1 px-2 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="syncTimePicker(this.closest('.time-picker'))">
              <option value="">hh</option>
              <% for(let h=0;h<24;h++){const hh=String(h).padStart(2,'0'); %><option value="<%= hh %>"><%= hh %></option><% } %>
            </select>
            <span class="text-slate-400 font-semibold">:</span>
            <select required class="tp-min w-16 px-2 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="syncTimePicker(this.closest('.time-picker'))">
              <option value="">mm</option>
              <option value="00">00</option><option value="15">15</option><option value="30">30</option><option value="45">45</option>
            </select>
            <input type="hidden" name="end_time">
          </div>
        </div>
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Kolor</label>
        <input type="color" name="color" id="editColor" class="w-10 h-10 rounded cursor-pointer border border-slate-300">
      </div>
      <div class="flex gap-3 pt-1">
        <button type="button" onclick="document.getElementById('editModal').classList.add('hidden')" class="flex-1 py-2.5 border border-slate-300 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50">Anuluj</button>
        <button type="submit" class="flex-1 py-2.5 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Zapisz</button>
      </div>
    </form>
  </div>
</div>

<script>
function openEdit(t) {
  document.getElementById('editForm').action = `/shifts/${t.id}?_method=PUT`;
  document.getElementById('editName').value = t.name;
  setTimePicker('editStartPicker', t.start_time);
  setTimePicker('editEndPicker', t.end_time);
  document.getElementById('editColor').value = t.color || '#3B82F6';
  document.getElementById('editModal').classList.remove('hidden');
}

// Drag-and-drop reorder (admin only)
(function() {
  const tbody = document.getElementById('templatesList');
  if (!tbody) return;
  const rows = tbody.querySelectorAll('.draggable-row');
  if (!rows.length) return;

  let dragSrc = null;

  rows.forEach(row => {
    row.addEventListener('dragstart', e => {
      dragSrc = row;
      row.classList.add('opacity-50');
      e.dataTransfer.effectAllowed = 'move';
    });
    row.addEventListener('dragend', () => {
      row.classList.remove('opacity-50');
      tbody.querySelectorAll('.draggable-row').forEach(r => r.classList.remove('bg-blue-50'));
    });
    row.addEventListener('dragover', e => {
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      tbody.querySelectorAll('.draggable-row').forEach(r => r.classList.remove('bg-blue-50'));
      if (row !== dragSrc) row.classList.add('bg-blue-50');
    });
    row.addEventListener('drop', e => {
      e.preventDefault();
      if (row === dragSrc) return;
      const allRows = [...tbody.querySelectorAll('.draggable-row')];
      const srcIdx = allRows.indexOf(dragSrc);
      const tgtIdx = allRows.indexOf(row);
      if (srcIdx < tgtIdx) tbody.insertBefore(dragSrc, row.nextSibling);
      else tbody.insertBefore(dragSrc, row);
      saveOrder();
    });
  });

  function saveOrder() {
    const ids = [...tbody.querySelectorAll('.draggable-row')].map(r => parseInt(r.dataset.id));
    fetch('/shifts/reorder', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids }),
    }).catch(console.error);
  }
})();
</script>

<%- include('../partials/footer') %>
