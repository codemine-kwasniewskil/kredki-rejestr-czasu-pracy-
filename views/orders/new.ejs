<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4/dist/l10n/pl.js"></script>

<div class="md:ml-60 pt-14 md:pt-0 min-h-screen bg-slate-50">
  <div class="max-w-5xl mx-auto px-4 py-6">

    <div class="flex items-center gap-3 mb-6">
      <a href="/orders" class="text-slate-400 hover:text-slate-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <h1 class="text-2xl font-bold text-slate-800">Nowe zamówienie</h1>
    </div>

    <% if (error && error.length) { %>
      <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm"><%= error[0] %></div>
    <% } %>

    <!-- Vendor selector -->
    <div class="bg-white border border-slate-200 rounded-xl p-4 mb-5">
      <label class="block font-semibold text-slate-700 mb-2">Dostawca <span class="text-red-500">*</span></label>
      <% if (vendors.length === 0) { %>
        <p class="text-sm text-amber-700">Brak dostawców – <a href="/orders/vendors" class="underline">dodaj dostawcę</a> przed złożeniem zamówienia.</p>
      <% } else { %>
        <select id="vendorId" onchange="onVendorChange()"
          class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
          <option value="">-- wybierz dostawcę --</option>
          <% for (const v of vendors) { %>
            <option value="<%= v.id %>" data-api="<%= v.api_type %>"><%= v.name %></option>
          <% } %>
        </select>
      <% } %>
    </div>

    <!-- Vendor product search (shown only for API vendors) -->
    <div id="vendorSearchPanel" class="bg-white border border-slate-200 rounded-xl p-4 mb-5 hidden">
      <h2 class="font-semibold text-slate-700 mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        Szukaj produktów u dostawcy
      </h2>
      <div class="flex gap-2 mb-3 items-center">
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" id="vendorSearch" placeholder="Wpisz nazwę produktu – wyniki pojawiają się podczas pisania…"
            class="w-full pl-9 pr-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
        </div>
        <div id="vendorSpinner" class="hidden flex-shrink-0">
          <svg class="animate-spin w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/></svg>
        </div>
      </div>
      <div id="vendorResults" class="hidden">
        <div class="overflow-x-auto max-h-72 border border-slate-100 rounded-lg">
          <table class="w-full text-sm" id="vendorResultsTable">
            <thead class="bg-slate-50 sticky top-0">
              <tr class="text-left text-slate-500 text-xs border-b border-slate-200">
                <th class="px-3 py-2 font-medium">Nazwa produktu</th>
                <th class="px-3 py-2 font-medium">SKU</th>
                <th class="px-3 py-2 font-medium">Jedn.</th>
                <th class="px-3 py-2 font-medium text-right">Cena netto</th>
                <th class="px-3 py-2 font-medium text-center">Dostępny</th>
                <th class="px-3 py-2 font-medium"></th>
              </tr>
            </thead>
            <tbody id="vendorResultsBody"></tbody>
          </table>
        </div>
        <p id="vendorResultsCount" class="text-xs text-slate-400 mt-1"></p>
      </div>
      <div id="vendorError" class="hidden text-sm text-red-600 mt-2"></div>
      <div id="vendorLoading" class="hidden text-sm text-slate-400 mt-2">Wyszukiwanie…</div>
    </div>

    <!-- Cafe stock search (shown when any vendor selected) -->
    <div id="stockSearchPanel" class="bg-white border border-slate-200 rounded-xl p-4 mb-5 hidden">
      <h2 class="font-semibold text-slate-700 mb-3 flex items-center gap-2">
        <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
        Szukaj w produktach kawiarni
      </h2>
      <div class="flex gap-2 mb-3 items-center">
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" id="stockSearch" placeholder="Wpisz nazwę produktu z magazynu…"
            class="w-full pl-9 pr-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-emerald-400 focus:ring-1 focus:ring-emerald-200">
        </div>
        <div id="stockSpinner" class="hidden flex-shrink-0">
          <svg class="animate-spin w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/></svg>
        </div>
      </div>
      <div id="stockResults" class="hidden">
        <div class="overflow-x-auto max-h-64 border border-slate-100 rounded-lg">
          <table class="w-full text-sm">
            <thead class="bg-slate-50 sticky top-0">
              <tr class="text-left text-slate-500 text-xs border-b border-slate-200">
                <th class="px-3 py-2 font-medium">Produkt (magazyn)</th>
                <th class="px-3 py-2 font-medium">SKU</th>
                <th class="px-3 py-2 font-medium">Dostawca</th>
                <th class="px-3 py-2 font-medium"></th>
              </tr>
            </thead>
            <tbody id="stockResultsBody"></tbody>
          </table>
        </div>
        <p id="stockResultsCount" class="text-xs text-slate-400 mt-1"></p>
      </div>
      <div id="stockError" class="hidden text-sm text-red-600 mt-2"></div>
    </div>

    <!-- Order form -->
    <form method="POST" action="/orders" id="orderForm">
      <input type="hidden" name="vendor_id" id="vendorIdHidden">

      <div class="bg-white border border-slate-200 rounded-xl overflow-hidden mb-5">
        <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between">
          <h2 class="font-semibold text-slate-700">Produkty w zamówieniu</h2>
          <span id="itemCount" class="text-xs text-slate-400">0 pozycji</span>
        </div>

        <!-- Low-stock pre-fill -->
        <div id="lowStockBanner" class="<%= lowStock.length > 0 ? '' : 'hidden' %> px-4 py-3 bg-amber-50 border-b border-amber-100 text-sm text-amber-800 flex items-center justify-between gap-3">
          <span id="lowStockBannerText"></span>
          <button type="button" onclick="prefillLowStock()" class="btn btn-warning text-xs flex-shrink-0">Dodaj wszystkie</button>
        </div>

        <!-- Items table -->
        <div class="overflow-x-auto">
          <table class="w-full text-sm" id="itemsTable">
            <thead class="bg-slate-50 border-b border-slate-100">
              <tr class="text-left text-slate-500">
                <th class="px-4 py-2 font-medium">Produkt</th>
                <th class="px-4 py-2 font-medium">SKU dostawcy</th>
                <th class="px-4 py-2 font-medium">Nazwa u dostawcy</th>
                <th class="px-4 py-2 font-medium">Jedn.</th>
                <th class="px-4 py-2 font-medium text-right">Ilość</th>
                <th class="px-4 py-2 font-medium text-right">Cena netto</th>
                <th class="px-4 py-2 font-medium text-right">Suma netto</th>
                <th class="px-4 py-2 font-medium"></th>
              </tr>
            </thead>
            <tbody id="orderItems">
              <tr id="emptyRow">
                <td colspan="8" class="px-4 py-8 text-center text-slate-400">
                  Brak produktów. Wyszukaj produkty powyżej lub kliknij „Dodaj produkt".
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Add product row -->
        <div class="px-4 py-3 border-t border-slate-100">
          <button type="button" onclick="onAddProductClick()" class="btn btn-secondary text-sm flex items-center gap-1.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            Dodaj produkt
          </button>
        </div>

        <!-- Total -->
        <div class="px-4 py-3 border-t border-slate-100 flex justify-between items-center">
          <div>
            <span id="minOrderInfo" class="text-xs text-slate-400 hidden"></span>
          </div>
          <div class="text-right">
            <span class="text-slate-500 text-sm">Suma netto:</span>
            <span id="orderTotal" class="ml-2 text-xl font-bold text-slate-800">0,00 PLN</span>
          </div>
        </div>
      </div>

      <!-- Delivery / payment details -->
      <div class="bg-white border border-slate-200 rounded-xl p-4 mb-5">
        <h3 class="font-semibold text-slate-700 mb-4">Szczegóły dostawy i płatności</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Data dostawy <span class="text-slate-400">(bez niedziel)</span></label>
            <input type="text" name="delivery_date" id="deliveryDate" autocomplete="off" placeholder="RRRR-MM-DD"
              class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200 bg-white">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Własny numer zamówienia</label>
            <input type="text" name="own_order_number" placeholder="np. ZAM/2026/001"
              class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Forma płatności</label>
            <% const dpm = typeof defaultPaymentMethod !== 'undefined' ? defaultPaymentMethod : ''; %>
            <select name="payment_method"
              class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm bg-white focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
              <option value="" <%= dpm === '' ? 'selected' : '' %>>— wybierz —</option>
              <option value="przelew"   <%= dpm === 'przelew'   ? 'selected' : '' %>>Przelew</option>
              <option value="gotowka"   <%= dpm === 'gotowka'   ? 'selected' : '' %>>Gotówka</option>
              <option value="karta"     <%= dpm === 'karta'     ? 'selected' : '' %>>Karta</option>
              <option value="odroczona" <%= dpm === 'odroczona' ? 'selected' : '' %>>Płatność odroczona</option>
            </select>
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-2">Adres dostawy</label>
            <div class="flex gap-4 mb-2 text-sm">
              <label class="flex items-center gap-1.5 cursor-pointer">
                <input type="radio" name="delivery_address_type" value="cafe" checked onchange="onAddressTypeChange(this.value)">
                Adres kawiarni
              </label>
              <label class="flex items-center gap-1.5 cursor-pointer">
                <input type="radio" name="delivery_address_type" value="custom" onchange="onAddressTypeChange(this.value)">
                Inny adres
              </label>
            </div>
            <input type="hidden" name="delivery_address" id="deliveryAddressHidden" value="<%- cafeAddress %>">
            <div id="cafeAddressDisplay" class="text-sm text-slate-600 bg-slate-50 rounded-lg px-3 py-2 border border-slate-200 min-h-[38px]">
              <% if (cafeAddress) { %><%= cafeAddress %><% } else { %><span class="text-slate-400 italic">Brak skonfigurowanego adresu — <a href="/orders/settings" class="underline text-blue-500">ustaw w ustawieniach</a></span><% } %>
            </div>
            <input type="text" id="customAddressInput" placeholder="ul. Przykładowa 1, 00-000 Warszawa"
              class="hidden w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200"
              oninput="document.getElementById('deliveryAddressHidden').value=this.value">
          </div>
        </div>
        <div class="mt-4">
          <label class="block text-xs font-medium text-slate-600 mb-1">Uwagi do zamówienia</label>
          <textarea name="notes" rows="2" placeholder="Opcjonalne uwagi…"
            class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200 resize-none"></textarea>
        </div>
      </div>

      <div class="flex gap-3 justify-end">
        <a href="/orders" class="btn btn-secondary">Anuluj</a>
        <button type="submit" class="btn btn-primary" id="saveBtn">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
          Zapisz jako szkic
        </button>
      </div>
    </form>

  </div>
</div>

<script>
const VENDOR_MINS = <%- JSON.stringify(Object.fromEntries(vendors.map(v => [v.id, v.min_order_value]))) %>;

const LOW_STOCK = <%- JSON.stringify(lowStock.map(i => ({
  id: i.id,
  vendorId: i.vendor_id,
  name: i.name,
  sku: i.vendor_product_key || '',
  unit: i.unit || '',
  price: priceMap[i.vendor_product_key]?.price ?? null,
  priceGross: priceMap[i.vendor_product_key]?.priceGross ?? null,
  vat: priceMap[i.vendor_product_key]?.vat ?? null,
  vendorName: priceMap[i.vendor_product_key]?.vendorName || '',
  need: i.min_qty ? (parseFloat(i.min_qty) - (parseFloat(i.last_qty) || 0)).toFixed(2) : 1,
}))) %>;

let rowIndex = 0;

function onVendorChange() {
  const sel = document.getElementById('vendorId');
  const opt = sel.selectedOptions[0];
  const vendorId = sel.value;
  const hasApi = opt && opt.dataset.api === 'intermlecz';

  document.getElementById('vendorIdHidden').value = vendorId;
  document.getElementById('vendorSearchPanel').classList.toggle('hidden', !hasApi);
  document.getElementById('stockSearchPanel').classList.toggle('hidden', !vendorId);

  // Clear search results when vendor changes
  if (!hasApi) {
    document.getElementById('vendorResults').classList.add('hidden');
  }

  // Update low-stock banner for selected vendor
  const banner = document.getElementById('lowStockBanner');
  const bannerText = document.getElementById('lowStockBannerText');
  if (vendorId) {
    const forVendor = LOW_STOCK.filter(i => String(i.vendorId) === String(vendorId));
    if (forVendor.length > 0) {
      bannerText.textContent = forVendor.length + ' produktów poniżej minimum dla tego dostawcy – kliknij by dodać automatycznie.';
      banner.classList.remove('hidden');
    } else {
      banner.classList.add('hidden');
    }
  } else {
    const all = LOW_STOCK;
    if (all.length > 0) {
      bannerText.textContent = all.length + ' produktów poniżej minimum – kliknij by dodać je automatycznie.';
      banner.classList.remove('hidden');
    } else {
      banner.classList.add('hidden');
    }
  }

  updateTotal();
}

function updateTotal() {
  let total = 0;
  let count = 0;
  document.querySelectorAll('.order-row').forEach(row => {
    const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
    const price = parseFloat(row.querySelector('.price-input').value) || 0;
    const sub = qty * price;
    row.querySelector('.subtotal').textContent = sub > 0 ? sub.toFixed(2).replace('.', ',') + ' PLN' : '—';
    total += sub;
    count++;
  });
  document.getElementById('orderTotal').textContent = total.toFixed(2).replace('.', ',') + ' PLN';
  document.getElementById('itemCount').textContent = count + ' pozycj' + (count === 1 ? 'a' : count < 5 ? 'e' : 'i');
  document.getElementById('emptyRow').style.display = count > 0 ? 'none' : '';

  const vendorId = document.getElementById('vendorId').value;
  const min = vendorId ? VENDOR_MINS[vendorId] : null;
  const minEl = document.getElementById('minOrderInfo');
  if (min !== null && min !== undefined && parseFloat(min) > 0) {
    const minVal = parseFloat(min);
    const diff = minVal - total;
    if (diff > 0.005) {
      minEl.textContent = `Minimum logistyczne: ${minVal.toFixed(2)} PLN netto — brakuje ${diff.toFixed(2)} PLN`;
      minEl.className = 'text-xs text-amber-600 font-medium';
    } else {
      minEl.textContent = `Minimum logistyczne: ${minVal.toFixed(2)} PLN netto ✓`;
      minEl.className = 'text-xs text-green-600 font-medium';
    }
    minEl.classList.remove('hidden');
  } else {
    minEl.classList.add('hidden');
  }
}

function escHtml(s) {
  return (s || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

function addRow({ name = '', sku = '', unit = '', qty = 1, price = null, priceGross = null, vat = null, stockId = '', vendorName = '', readonly = false } = {}) {
  const emptyRow = document.getElementById('emptyRow');
  const tr = document.createElement('tr');
  tr.className = 'order-row border-b border-slate-100';
  const priceVal = price !== null ? parseFloat(price).toFixed(2) : '';
  const vn = escHtml(vendorName);
  const nameHtml = readonly
    ? `<input type="hidden" name="item_name[]" value="${escHtml(name)}"><span class="text-sm text-slate-700">${escHtml(name) || '—'}</span>`
    : `<input type="text" name="item_name[]" value="${escHtml(name)}" required class="w-full border border-slate-200 rounded px-2 py-1 text-sm focus:outline-none focus:border-blue-400 min-w-[140px]">`;
  const skuHtml = readonly
    ? `<input type="hidden" name="item_sku[]" value="${escHtml(sku)}"><span class="font-mono text-xs bg-slate-100 px-1.5 py-0.5 rounded text-slate-600">${escHtml(sku) || '—'}</span>`
    : `<input type="text" name="item_sku[]" value="${escHtml(sku)}" placeholder="SKU" class="w-28 border border-slate-200 rounded px-2 py-1 text-sm font-mono focus:outline-none focus:border-blue-400">`;
  const unitHtml = readonly
    ? `<input type="hidden" name="item_unit[]" value="${unit}"><span class="text-sm text-slate-500">${unit || '—'}</span>`
    : `<input type="text" name="item_unit[]" value="${unit}" placeholder="szt." class="w-16 border border-slate-200 rounded px-2 py-1 text-sm focus:outline-none focus:border-blue-400">`;
  tr.innerHTML = `
    <td class="px-4 py-2">
      <input type="hidden" name="item_stock_id[]" value="${stockId}">
      ${nameHtml}
    </td>
    <td class="px-4 py-2">${skuHtml}</td>
    <td class="px-4 py-2 text-slate-600 text-xs">
      ${vn ? `<span class="leading-tight" title="${vn}">${vn}</span>` : '<span class="text-slate-300">—</span>'}
    </td>
    <td class="px-4 py-2">${unitHtml}</td>
    <td class="px-4 py-2 text-right">
      <input type="number" name="item_qty[]" value="${parseFloat(qty) || 1}" min="0.001" step="any" required
        class="qty-input w-20 border border-slate-200 rounded px-2 py-1 text-sm text-right focus:outline-none focus:border-blue-400"
        oninput="updateTotal()">
    </td>
    <td class="px-4 py-2 text-right">
      <input type="number" name="item_price[]" value="${priceVal}" min="0" step="0.01" placeholder="—"
        class="price-input w-24 border border-slate-200 rounded px-2 py-1 text-sm text-right focus:outline-none focus:border-blue-400"
        oninput="updateTotal()">
      ${priceGross !== null ? `<span class="block text-xs text-slate-400 mt-0.5 text-right">${parseFloat(priceGross).toFixed(4)} brutto${vat !== null ? ` (${vat}% VAT)` : ''}</span>` : ''}
    </td>
    <td class="px-4 py-2 text-right subtotal font-mono text-slate-600 whitespace-nowrap">—</td>
    <td class="px-4 py-2">
      <button type="button" onclick="this.closest('tr').remove(); updateTotal();"
        class="text-red-400 hover:text-red-600 p-1" title="Usuń">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </td>
  `;
  emptyRow.parentNode.insertBefore(tr, emptyRow);
  updateTotal();
}

function onAddProductClick() {
  const sel = document.getElementById('vendorId');
  const opt = sel.selectedOptions[0];
  const hasApi = opt && opt.dataset.api === 'intermlecz' && sel.value;
  if (hasApi) {
    document.getElementById('vendorSearchPanel').classList.remove('hidden');
    document.getElementById('vendorSearch').focus();
    document.getElementById('vendorSearchPanel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  } else if (sel.value) {
    document.getElementById('stockSearch').focus();
    document.getElementById('stockSearchPanel').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  } else {
    document.getElementById('vendorId').focus();
    alert('Wybierz najpierw dostawcę.');
  }
}

function prefillLowStock() {
  const vendorId = document.getElementById('vendorId').value;
  const items = vendorId
    ? LOW_STOCK.filter(i => String(i.vendorId) === String(vendorId))
    : LOW_STOCK;
  items.forEach(item => {
    addRow({ name: item.name, sku: item.sku, unit: item.unit, qty: Math.max(0.001, parseFloat(item.need)), price: item.price, priceGross: item.priceGross, vat: item.vat, stockId: item.id, vendorName: item.vendorName || '', readonly: true });
  });
}

// Stock items search
let _stockDebounce = null;
function triggerStockSearch(phrase) {
  clearTimeout(_stockDebounce);
  if (!phrase || phrase.trim().length < 2) {
    document.getElementById('stockResults').classList.add('hidden');
    return;
  }
  _stockDebounce = setTimeout(() => doStockSearch(phrase.trim()), 300);
}

async function doStockSearch(phrase) {
  const vendorId = document.getElementById('vendorId').value;
  document.getElementById('stockSpinner').classList.remove('hidden');
  document.getElementById('stockError').classList.add('hidden');
  document.getElementById('stockResults').classList.add('hidden');
  try {
    const qs = '/orders/stock-items?q=' + encodeURIComponent(phrase) + (vendorId ? '&vendor_id=' + vendorId : '');
    const items = await (await fetch(qs)).json();
    if (items.error) throw new Error(items.error);
    const tbody = document.getElementById('stockResultsBody');
    tbody.innerHTML = '';
    if (!items.length) {
      tbody.innerHTML = '<tr><td colspan="4" class="px-3 py-4 text-center text-slate-400">Brak wyników.</td></tr>';
    } else {
      items.forEach(p => {
        const tr = document.createElement('tr');
        tr.className = 'border-b border-slate-100 hover:bg-emerald-50';
        tr.innerHTML = `
          <td class="px-3 py-2 text-slate-800 font-medium">${p.name}</td>
          <td class="px-3 py-2 font-mono text-xs text-slate-500">${p.sku || '—'}</td>
          <td class="px-3 py-2 text-xs text-slate-400">${p.vendor_name || '—'}</td>
          <td class="px-3 py-2">
            <button type="button" id="stock-add-${p.id}" class="btn btn-secondary text-xs py-0.5"
              onclick='addStockItem(${p.id}, ${JSON.stringify(p.name)}, ${JSON.stringify(p.sku||"")}, ${JSON.stringify(p.unit||"")}, ${p.vendor_id||null}, "stock-add-${p.id}")'>
              + Dodaj
            </button>
          </td>`;
        tbody.appendChild(tr);
      });
    }
    document.getElementById('stockResultsCount').textContent = `Wyniki: ${items.length}`;
    document.getElementById('stockResults').classList.remove('hidden');
  } catch (e) {
    document.getElementById('stockError').textContent = 'Błąd: ' + e.message;
    document.getElementById('stockError').classList.remove('hidden');
  } finally {
    document.getElementById('stockSpinner').classList.add('hidden');
  }
}

async function addStockItem(stockId, name, sku, unit, vendorId, btnId) {
  const btn = document.getElementById(btnId);
  if (btn) { btn.disabled = true; btn.textContent = '…'; }
  let price = null, vendorName = '';
  let priceGross = null, vat = null;
  try {
    if (sku && vendorId) {
      const resp = await fetch('/orders/vendor/sku-info?sku=' + encodeURIComponent(sku) + '&vendor_id=' + vendorId);
      const data = await resp.json();
      if (data) { price = data.price; priceGross = data.priceGross; vat = data.vat; vendorName = data.vendorName || ''; unit = data.unit || unit; }
    }
  } catch (_) {}
  addRow({ name, sku, unit, qty: 1, price, priceGross, vat, stockId, vendorName, readonly: true });
  if (btn) { btn.disabled = false; btn.textContent = '+ Dodaj'; }
}

document.getElementById('stockSearch').addEventListener('input', e => triggerStockSearch(e.target.value));

// Vendor search — debounced on input
let _vendorDebounce = null;
function triggerVendorSearch(phrase) {
  clearTimeout(_vendorDebounce);
  if (!phrase || phrase.trim().length < 2) return;
  _vendorDebounce = setTimeout(() => doVendorSearch(phrase.trim()), 300);
}

async function doVendorSearch(phrase) {
  const q = phrase || document.getElementById('vendorSearch').value.trim();
  if (!q) return;
  const vendorId = document.getElementById('vendorId').value;
  document.getElementById('vendorSpinner').classList.remove('hidden');
  document.getElementById('vendorLoading').classList.remove('hidden');
  document.getElementById('vendorError').classList.add('hidden');
  document.getElementById('vendorResults').classList.add('hidden');
  try {
    const qs = '/orders/vendor/search?q=' + encodeURIComponent(q) + (vendorId ? '&vendor_id=' + vendorId : '');
    const resp = await fetch(qs);
    const data = await resp.json();
    if (data.error) throw new Error(data.error);
    renderVendorResults(data.items, data.total);
  } catch (e) {
    document.getElementById('vendorError').textContent = 'Błąd wyszukiwania: ' + e.message;
    document.getElementById('vendorError').classList.remove('hidden');
  } finally {
    document.getElementById('vendorSpinner').classList.add('hidden');
    document.getElementById('vendorLoading').classList.add('hidden');
  }
}

function renderVendorResults(items, total) {
  const tbody = document.getElementById('vendorResultsBody');
  tbody.innerHTML = '';
  if (!items.length) {
    tbody.innerHTML = '<tr><td colspan="6" class="px-3 py-4 text-center text-slate-400">Brak wyników.</td></tr>';
  } else {
    items.forEach(p => {
      const price = p.PriceAfterDiscountNet?.Value ?? '';
      const inStock = p.InStock ? '✓' : '✗';
      const stockColor = p.InStock ? 'text-green-600' : 'text-red-500';
      const tr = document.createElement('tr');
      tr.className = 'border-b border-slate-100 hover:bg-blue-50 cursor-pointer';
      tr.innerHTML = `
        <td class="px-3 py-2 text-slate-800">
          <div class="flex items-center gap-2">
            ${p.Photo ? `<img src="${p.Photo}" alt="" class="w-9 h-9 object-contain rounded border border-slate-100 bg-white flex-shrink-0" loading="lazy" onerror="this.remove()">` : '<span class="w-9 h-9 flex-shrink-0 rounded bg-slate-50 border border-slate-100"></span>'}
            <span>${p.Name || ''}</span>
          </div>
        </td>
        <td class="px-3 py-2 font-mono text-xs text-slate-500">${p.Sku || ''}</td>
        <td class="px-3 py-2 text-slate-500">${p.Unit || ''}</td>
        <td class="px-3 py-2 text-right font-mono text-slate-700">
          ${price ? parseFloat(price).toFixed(2) + ' PLN' : '—'}
          ${(p.Vat !== undefined && p.Vat !== null) ? `<span class="block text-xs text-slate-400">VAT ${p.Vat}%</span>` : ''}
        </td>
        <td class="px-3 py-2 text-center ${stockColor} font-bold">${inStock}</td>
        <td class="px-3 py-2">
          <button type="button" class="btn btn-secondary text-xs py-0.5"
            onclick='addRow({name:${JSON.stringify(p.Name)},sku:${JSON.stringify(p.Sku)},unit:${JSON.stringify(p.Unit||"")},qty:1,price:${price||null},priceGross:${p.PriceAfterDiscountNet?.Value&&p.Vat!=null?Math.round(p.PriceAfterDiscountNet.Value*(1+p.Vat/100)*10000)/10000:null},vat:${p.Vat??null},vendorName:${JSON.stringify(p.Name||"")},readonly:true})'>
            + Dodaj
          </button>
        </td>
      `;
      tbody.appendChild(tr);
    });
  }
  document.getElementById('vendorResultsCount').textContent =
    `Pokazano ${items.length} z ${total} wyników`;
  document.getElementById('vendorResults').classList.remove('hidden');
}

document.getElementById('vendorSearch').addEventListener('input', e => triggerVendorSearch(e.target.value));
document.getElementById('vendorSearch').addEventListener('keydown', e => {
  if (e.key === 'Enter') { e.preventDefault(); doVendorSearch(); }
});

document.getElementById('orderForm').addEventListener('submit', e => {
  if (!document.getElementById('vendorIdHidden').value) {
    e.preventDefault();
    alert('Wybierz dostawcę przed zapisaniem zamówienia.');
    document.getElementById('vendorId').focus();
    return;
  }
  const rows = document.querySelectorAll('.order-row');
  if (!rows.length) { e.preventDefault(); alert('Dodaj co najmniej jeden produkt.'); }
});

// Delivery address type toggle
const CAFE_ADDRESS = <%- JSON.stringify(cafeAddress) %>;
function onAddressTypeChange(type) {
  const cafeDisplay = document.getElementById('cafeAddressDisplay');
  const customInput = document.getElementById('customAddressInput');
  const hidden = document.getElementById('deliveryAddressHidden');
  if (type === 'cafe') {
    cafeDisplay.classList.remove('hidden');
    customInput.classList.add('hidden');
    hidden.value = CAFE_ADDRESS;
  } else {
    cafeDisplay.classList.add('hidden');
    customInput.classList.remove('hidden');
    hidden.value = customInput.value;
    customInput.focus();
  }
}

// Delivery date: Sundays disabled; default = next day if ordering before 12:00,
// otherwise the day after tomorrow (cutoff). Sundays are skipped for the default.
(function() {
  const el = document.getElementById('deliveryDate');
  if (!el || typeof flatpickr === 'undefined') return;

  const now = new Date();
  const base = new Date(); base.setHours(0, 0, 0, 0);
  base.setDate(base.getDate() + (now.getHours() < 12 ? 1 : 2));
  if (base.getDay() === 0) base.setDate(base.getDate() + 1); // never default to Sunday

  flatpickr(el, {
    locale: 'pl',
    dateFormat: 'Y-m-d',
    minDate: base,
    defaultDate: base,
    disable: [ d => d.getDay() === 0 ],   // block all Sundays in the calendar
  });
})();

// Init low-stock banner
onVendorChange();
</script>

