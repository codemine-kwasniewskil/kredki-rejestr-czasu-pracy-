<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="md:ml-60 pt-14 md:pt-0 min-h-screen bg-slate-50">
  <div class="max-w-xl mx-auto px-4 py-6">

    <div class="flex items-center gap-3 mb-6">
      <a href="/orders" class="text-slate-400 hover:text-slate-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <h1 class="text-2xl font-bold text-slate-800">Ustawienia zamówień</h1>
    </div>

    <% if (success && success.length) { %>
      <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm"><%= success[0] %></div>
    <% } %>
    <% if (error && error.length) { %>
      <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm"><%= error[0] %></div>
    <% } %>

    <div class="bg-white border border-slate-200 rounded-xl p-6">
      <form method="POST" action="/orders/settings">

        <div class="mb-6">
          <label class="block text-sm font-semibold text-slate-700 mb-1">
            Minimalna wartość zamówienia (PLN netto)
          </label>
          <p class="text-xs text-slate-400 mb-2">
            Zamówienie musi przekroczyć tę kwotę zanim będzie mogło być złożone u dostawcy.
          </p>
          <div class="flex items-center gap-2">
            <input type="number" name="min_order_value" value="<%= minOrderValue %>"
              min="0" step="1" required
              class="w-40 border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200 text-right font-mono">
            <span class="text-slate-500 text-sm">PLN netto</span>
          </div>
        </div>

        <div class="mb-6 p-4 bg-slate-50 rounded-lg border border-slate-100">
          <p class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Dane dostawcy (Inter-Mlecz)</p>
          <p class="text-xs text-slate-500">API: <span class="font-mono text-slate-700">b2b.intermlecz.pl</span></p>
          <p class="text-xs text-slate-500">Client ID: <span class="font-mono text-slate-700"><%= process.env.VENDOR_CLIENT_ID || '17456' %></span></p>
          <p class="text-xs text-slate-400 mt-1">Klucz API konfigurowany przez zmienną środowiskową <code class="bg-slate-200 px-1 rounded">VENDOR_API_KEY</code>.</p>
        </div>

        <div class="flex gap-3 justify-end">
          <a href="/orders" class="btn btn-secondary">Anuluj</a>
          <button type="submit" class="btn btn-primary">Zapisz ustawienia</button>
        </div>
      </form>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>
