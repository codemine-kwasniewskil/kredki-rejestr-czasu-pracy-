<%- include('../partials/head') %>
<%- include('../partials/nav') %>


<div class="md:ml-60 pt-14 md:pt-0 min-h-screen bg-slate-50">
  <div class="max-w-3xl mx-auto px-4 py-6">

    <div class="flex items-center gap-3 mb-6">
      <a href="/orders" class="text-slate-400 hover:text-slate-600">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <div>
        <h1 class="text-2xl font-bold text-slate-800">Ustawienia zamówień</h1>
        <p class="text-slate-500 text-sm mt-0.5">Dostawcy i minimum logistyczne</p>
      </div>
    </div>

    <% if (success && success.length) { %>
      <div class="mb-4 p-3 bg-green-50 border border-green-200 text-green-800 rounded-lg text-sm"><%= success[0] %></div>
    <% } %>
    <% if (error && error.length) { %>
      <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-800 rounded-lg text-sm"><%= error[0] %></div>
    <% } %>

    <!-- Cafe address -->
    <div class="bg-white border border-slate-200 rounded-xl p-5 mb-5">
      <div class="mb-4 flex flex-wrap items-center gap-3">
        <button type="button" onclick="fillKnownAddress()"
          class="btn btn-primary text-sm flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Wpisz adres KAWIARNIA KREDKI
        </button>
        <button type="button" onclick="loadApiAddresses()"
          class="btn btn-secondary text-sm flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
          Pobierz z API
        </button>
        <span id="apiAddrStatus" class="text-sm text-slate-400"></span>
      </div>
      <div id="apiAddrList"></div>
      <h2 class="font-semibold text-slate-700 mb-4 flex items-center gap-2">
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        Adres kawiarni (domyślny adres dostawy)
      </h2>
      <form method="POST" action="/orders/settings/address">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <div class="sm:col-span-2">
            <label class="block text-xs font-medium text-slate-600 mb-1">Nazwa (do adresu dostawy)</label>
            <input type="text" name="cafe_name" value="<%= orderSettings.cafe_name || '' %>"
              placeholder="np. KAWIARNIA KREDKI"
              class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Ulica</label>
            <input type="text" name="cafe_street" value="<%= orderSettings.cafe_street || '' %>"
              placeholder="np. Ludwika Mierosławskiego"
              class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Numer budynku</label>
            <input type="text" name="cafe_house_number" value="<%= orderSettings.cafe_house_number || '' %>"
              placeholder="np. 29A"
              class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Kod pocztowy</label>
            <input type="text" name="cafe_postal_code" value="<%= orderSettings.cafe_postal_code || '' %>"
              placeholder="np. 01-567"
              class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Miasto</label>
            <input type="text" name="cafe_city" value="<%= orderSettings.cafe_city || '' %>"
              placeholder="np. Warszawa"
              class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">Telefon</label>
            <input type="text" name="cafe_phone" value="<%= orderSettings.cafe_phone || '' %>"
              placeholder="np. 604938975"
              class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">E-mail</label>
            <input type="email" name="cafe_email" value="<%= orderSettings.cafe_email || '' %>"
              placeholder="np. hello@kredki.store"
              class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
          </div>
          <div>
            <label class="block text-xs font-medium text-slate-600 mb-1">
              Address ID w Inter-Mlecz
              <span class="text-slate-400 font-normal">(opcjonalnie)</span>
            </label>
            <input type="number" name="cafe_address_id" value="<%= orderSettings.cafe_address_id || '' %>"
              placeholder="np. 123"
              class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
          </div>
          <div class="sm:col-span-2">
            <label class="block text-xs font-medium text-slate-600 mb-1">
              Nazwa dostawy (DeliveryName) <span class="text-red-500">*</span>
              <span class="text-slate-400 font-normal ml-1">— wymagane przez API Inter-Mlecz. Skontaktuj się z Inter-Mlecz, aby uzyskać poprawną wartość dla Twojego konta.</span>
            </label>
            <input type="text" name="cafe_delivery_name" value="<%= orderSettings.cafe_delivery_name || '' %>"
              placeholder="np. dost.7-9 TR24 GOTÓWKA"
              class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
          </div>
          <div class="sm:col-span-2">
            <label class="block text-xs font-medium text-slate-600 mb-1">
              Sposób płatności (PaymentName)
              <span class="text-slate-400 font-normal ml-1">— opcje pobrane z platformy Inter-Mlecz.</span>
            </label>
            <% if (typeof paymentOptions !== 'undefined' && paymentOptions.length > 0) { %>
              <select name="cafe_payment_name"
                class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
                <option value="">— wybierz —</option>
                <% paymentOptions.forEach(function(p) { %>
                  <option value="<%= p.Name %>" <%= (typeof selectedPaymentName !== 'undefined' && selectedPaymentName === p.Name) ? 'selected' : '' %>><%= p.Name %></option>
                <% }); %>
              </select>
              <% if (typeof paymentMismatch !== 'undefined' && paymentMismatch) { %>
                <p class="text-xs text-amber-600 mt-1">Zapisana wartość „<%= orderSettings.cafe_payment_name %>" nie pasuje do żadnej opcji platformy — wybierz z listy.</p>
              <% } %>
            <% } else { %>
              <input type="text" name="cafe_payment_name" value="<%= orderSettings.cafe_payment_name || '' %>"
                placeholder="np. Płatność za pobraniem"
                class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
              <p class="text-xs text-slate-400 mt-1">Nie udało się pobrać opcji z platformy — wpisz dokładną nazwę sposobu płatności.</p>
            <% } %>
          </div>
        </div>
        <div class="mt-3">
          <button type="submit" class="btn btn-primary text-sm">Zapisz adres</button>
        </div>
      </form>
    </div>

    <!-- Catalog (XML feed) sync -->
    <div class="bg-white border border-slate-200 rounded-xl p-4 mb-5">
      <div class="flex items-center justify-between gap-3 flex-wrap">
        <div>
          <h2 class="font-semibold text-slate-700">Katalog produktów (plik XML)</h2>
          <% if (typeof catalogStatus !== 'undefined' && catalogStatus.count > 0) { %>
            <p class="text-xs text-slate-500 mt-0.5">
              <strong class="text-slate-700"><%= catalogStatus.count %></strong> produktów
              <% if (catalogStatus.outOfStock > 0) { %>
                · <span class="text-amber-600"><%= catalogStatus.outOfStock %> niedostępnych</span>
              <% } %>
              <% if (catalogStatus.syncedAt) {
                   // stored UTC ("YYYY-MM-DD HH:MM:SS") — render in Polish local time
                   const _synced = new Date(String(catalogStatus.syncedAt).replace(' ', 'T') + 'Z'); %>
                · ostatnia aktualizacja: <span class="font-mono"><%= _synced.toLocaleString('pl-PL', { timeZone: 'Europe/Warsaw' }) %></span>
              <% } %>
            </p>
          <% } else { %>
            <p class="text-xs text-amber-600 mt-0.5">Katalog pusty – ustaw adres pliku XML u dostawcy i zsynchronizuj.</p>
          <% } %>
        </div>
        <div class="flex items-center gap-2 flex-shrink-0">
          <form method="POST" action="/orders/vendor/refresh-availability" id="refreshAvailForm">
            <button type="submit" id="refreshAvailBtn" class="btn btn-secondary text-sm inline-flex items-center gap-2" title="Szybkie odświeżenie stanów magazynowych (lekki plik)">
              <svg id="refreshAvailSpinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.4 0 0 5.4 0 12h4z"></path>
              </svg>
              <span id="refreshAvailLabel">Odśwież dostępność</span>
            </button>
          </form>
          <form method="POST" action="/orders/vendor/sync-catalog" id="syncCatalogForm">
            <button type="submit" id="syncCatalogBtn" class="btn btn-primary text-sm inline-flex items-center gap-2">
              <svg id="syncCatalogSpinner" class="w-4 h-4 animate-spin hidden" fill="none" viewBox="0 0 24 24">
                <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.4 0 0 5.4 0 12h4z"></path>
              </svg>
              <span id="syncCatalogLabel">Synchronizuj katalog</span>
            </button>
          </form>
        </div>
      </div>
    </div>

    <script>
      function bindSyncFeedback(formId, btnId, spinnerId, labelId, busyText) {
        document.getElementById(formId)?.addEventListener('submit', function () {
          const btn = document.getElementById(btnId);
          btn.disabled = true;
          btn.classList.add('opacity-70', 'cursor-wait');
          document.getElementById(spinnerId).classList.remove('hidden');
          document.getElementById(labelId).textContent = busyText;
        });
      }
      bindSyncFeedback('syncCatalogForm', 'syncCatalogBtn', 'syncCatalogSpinner', 'syncCatalogLabel', 'Synchronizacja w toku…');
      bindSyncFeedback('refreshAvailForm', 'refreshAvailBtn', 'refreshAvailSpinner', 'refreshAvailLabel', 'Odświeżanie…');
    </script>

    <!-- Vendors list -->
    <div class="bg-white border border-slate-200 rounded-xl overflow-hidden mb-5">
      <div class="px-4 py-3 border-b border-slate-100 flex items-center justify-between">
        <h2 class="font-semibold text-slate-700">Dostawcy</h2>
        <span class="text-xs text-slate-400"><%= vendors.length %> dostawców</span>
      </div>
      <% if (vendors.length === 0) { %>
        <div class="px-4 py-10 text-center text-slate-400 text-sm">Brak dostawców. Dodaj pierwszego poniżej.</div>
      <% } else { %>
      <div class="divide-y divide-slate-100">
        <% for (const v of vendors) { %>
        <div class="px-4 py-3 flex items-center gap-3 <%= !v.active ? 'opacity-50' : '' %>">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <span class="font-medium text-slate-800"><%= v.name %></span>
              <% if (!v.active) { %>
                <span class="text-xs bg-red-100 text-red-600 px-2 py-0.5 rounded-full">Nieaktywny</span>
              <% } %>
            </div>
            <div class="flex items-center gap-4 mt-0.5 flex-wrap">
              <% if (v.min_order_value !== null && v.min_order_value !== undefined) { %>
                <span class="text-xs text-slate-500">Min. zamówienie: <strong class="font-mono text-slate-700"><%= parseFloat(v.min_order_value).toFixed(2) %> PLN</strong></span>
              <% } else { %>
                <span class="text-xs text-slate-400">Brak min. zamówienia</span>
              <% } %>
              <% if (v.api_type === 'intermlecz' && v.client_id) { %>
                <span class="text-xs text-slate-400">Client ID: <span class="font-mono"><%= v.client_id %></span></span>
              <% } %>
              <% if (v.website) { %>
                <span class="text-xs text-slate-400"><%= v.website %></span>
              <% } %>
            </div>
          </div>
          <div class="flex items-center gap-2 flex-shrink-0">
            <a href="/orders/settings?edit=<%= v.id %>#edit" class="text-blue-600 hover:text-blue-800 text-xs font-medium">Edytuj</a>
            <form method="POST" action="/orders/vendors/<%= v.id %>?_method=DELETE"
              onsubmit="return confirm('Usunąć dostawcę „<%= v.name %>"?')">
              <button type="submit" class="text-red-400 hover:text-red-600 text-xs font-medium">Usuń</button>
            </form>
          </div>
        </div>
        <% } %>
      </div>
      <% } %>
    </div>

    <!-- Edit vendor form (inline) -->
    <% if (editVendor) { %>
    <div id="edit" class="bg-blue-50 border border-blue-200 rounded-xl p-5 mb-5">
      <h2 class="font-semibold text-blue-800 mb-4">Edytuj: <%= editVendor.name %></h2>
      <form method="POST" action="/orders/vendors/<%= editVendor.id %>">
        <%- include('./_vendor_form', { v: editVendor }) %>
        <div class="flex gap-2 mt-4">
          <button type="submit" class="btn btn-primary">Zapisz</button>
          <a href="/orders/settings" class="btn btn-secondary">Anuluj</a>
        </div>
      </form>
    </div>
    <% } %>

    <!-- Add new vendor -->
    <div class="bg-white border border-slate-200 rounded-xl p-5">
      <h2 class="font-semibold text-slate-700 mb-4 flex items-center gap-2">
        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Dodaj nowego dostawcę
      </h2>
      <form method="POST" action="/orders/vendors">
        <%- include('./_vendor_form', { v: null }) %>
        <div class="mt-4">
          <button type="submit" class="btn btn-success">Dodaj dostawcę</button>
        </div>
      </form>
    </div>

  </div>
</div>

<script>
async function loadApiAddresses() {
  const status = document.getElementById('apiAddrStatus');
  const list = document.getElementById('apiAddrList');
  status.textContent = 'Pobieranie…';
  list.innerHTML = '';
  try {
    const resp = await fetch('/orders/settings/api-addresses');
    const data = await resp.json();
    if (data.error) { status.textContent = 'Błąd: ' + data.error; return; }
    if (!data.addresses?.length) {
      status.textContent = '';
      list.innerHTML = `<div class="mb-4 p-3 bg-amber-50 border border-amber-200 rounded-lg text-sm text-amber-800">
        <strong>API nie zwraca adresów.</strong><br>
        <span class="text-slate-600 mt-1 block">Wprowadź dane ręcznie. Znany Address ID z Inter-Mlecz: <strong class="font-mono cursor-pointer underline" onclick="document.querySelector('[name=cafe_address_id]').value='174560000'">174560000</strong> — kliknij aby wpisać.</span>
      </div>`;
      return;
    }
    status.textContent = '';
    list.innerHTML = `<div class="mb-4 p-3 bg-blue-50 border border-blue-200 rounded-lg text-sm text-blue-800">
      <strong>Adresy z Inter-Mlecz:</strong>
      ${data.addresses.map(a => `
        <div class="mt-2 flex items-center justify-between gap-4">
          <span><strong class="font-mono">#${a.Id}</strong> — ${a.Name} — ${a.Street} ${a.HouseNumber}, ${a.PostalCode} ${a.City}</span>
          <button type="button" onclick='fillFromApi(${JSON.stringify(a)})'
            class="btn btn-secondary text-xs flex-shrink-0">Użyj</button>
        </div>`).join('')}
    </div>`;
  } catch (e) {
    status.textContent = 'Błąd: ' + e.message;
  }
}


function fillKnownAddress() {
  fillFromApi({
    Id: '174560000',
    Name: 'KAWIARNIA KREDKI dost.7-9 TR24 GOTÓWKA',
    Street: 'Ludwika Mierosławskiego',
    HouseNumber: '29A',
    PostalCode: '01-567',
    City: 'Warszawa',
    Phone: '604938975',
    Email: 'hello@kredki.store',
  });
}

function fillFromApi(a) {
  const f = n => document.querySelector(`[name="${n}"]`);
  if (f('cafe_address_id')) f('cafe_address_id').value = a.Id || '';
  if (f('cafe_name'))         f('cafe_name').value = a.Name || '';
  if (f('cafe_street'))       f('cafe_street').value = a.Street || '';
  if (f('cafe_house_number')) f('cafe_house_number').value = a.HouseNumber || '';
  if (f('cafe_postal_code'))  f('cafe_postal_code').value = a.PostalCode || '';
  if (f('cafe_city'))         f('cafe_city').value = a.City || '';
  if (f('cafe_phone'))        f('cafe_phone').value = a.Phone || '';
  if (f('cafe_email'))        f('cafe_email').value = a.Email || '';
}
</script>
<%- include('../partials/footer') %>
