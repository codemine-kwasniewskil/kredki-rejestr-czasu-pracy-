<%# Partial: vendor add/edit form fields. v = vendor object or null %>
<div class="grid grid-cols-1 sm:grid-cols-2 gap-4">

  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Nazwa <span class="text-red-500">*</span></label>
    <input type="text" name="name" value="<%= v?.name || '' %>" required placeholder="np. Frisco"
      class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
  </div>

  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Typ integracji</label>
    <select name="api_type" id="apiTypeSelect_<%= v?.id || 'new' %>"
      onchange="toggleApiFields(this)"
      class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 bg-white">
      <% for (const [key, meta] of Object.entries(API_TYPES)) { %>
        <option value="<%= key %>" <%= (v?.api_type || 'manual') === key ? 'selected' : '' %>><%= meta.label %></option>
      <% } %>
    </select>
  </div>

  <div class="api-credentials-fields <%= (v?.api_type === 'intermlecz') ? '' : 'hidden' %>" id="apiCreds_<%= v?.id || 'new' %>">
    <label class="block text-sm font-medium text-slate-700 mb-1">Client ID</label>
    <input type="text" name="client_id" value="<%= v?.client_id || '' %>" placeholder="np. 17456"
      class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm font-mono focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
  </div>

  <div class="api-credentials-fields <%= (v?.api_type === 'intermlecz') ? '' : 'hidden' %>" id="apiKey_<%= v?.id || 'new' %>">
    <label class="block text-sm font-medium text-slate-700 mb-1">API Key</label>
    <input type="text" name="api_key" value="<%= v?.api_key || '' %>" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
      class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm font-mono focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
  </div>

  <div>
    <label class="block text-sm font-medium text-slate-700 mb-1">Strona WWW (opcjonalnie)</label>
    <input type="text" name="website" value="<%= v?.website || '' %>" placeholder="np. b2b.intermlecz.pl"
      class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
  </div>

  <% if (v) { %>
  <div class="flex items-end pb-1">
    <label class="flex items-center gap-2 cursor-pointer py-2">
      <input type="checkbox" name="active" value="1" <%= v.active ? 'checked' : '' %>
        class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-400">
      <span class="text-sm text-slate-700">Aktywny</span>
    </label>
  </div>
  <% } %>

</div>

<script>
function toggleApiFields(sel) {
  const isApi = sel.value === 'intermlecz';
  sel.closest('form').querySelectorAll('.api-credentials-fields').forEach(el => {
    el.classList.toggle('hidden', !isApi);
  });
}
</script>
