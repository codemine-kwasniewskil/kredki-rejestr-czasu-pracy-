            </div>

            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Jednostka</label>
              <select id="addUnitSel" onchange="toggleCustom('addUnitSel','addUnitInput','addUnitHidden')"
                class="stock-input w-full border border-slate-200 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-400 bg-white">
                <option value="">-- brak --</option>
                <% const COMMON_UNITS = ['l','kg','szt','op','worki','par','-']; %>
                <% for (const u of COMMON_UNITS) { %><option value="<%= u %>"><%= u %></option><% } %>
                <% for (const u of units) { if (!COMMON_UNITS.includes(u)) { %>
