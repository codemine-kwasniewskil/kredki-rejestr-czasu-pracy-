                <option value="">-- brak --</option>
                <% for (const cat of categories) { %>
                  <option value="<%= cat %>"><%= cat %></option>
                <% } %>
                <option value="__new__">+ Nowa kategoria…</option>
              </select>
              <input type="text" id="addCatInput" name="category_add" placeholder="Wpisz nazwę kategorii"
                class="stock-input hidden w-full mt-1 border border-blue-300 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-400">
              <input type="hidden" name="category" id="addCatHidden" value="">
            </div>

            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Nazwa <span class="text-red-500">*</span></label>
