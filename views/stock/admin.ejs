<script>
// ── Rename validation ─────────────────────────────────────────────────────
function validateRename(form) {
  const inp = form.querySelector('input[name="new_category"],input[name="new_unit"]');
  if (!inp || !inp.value.trim()) { inp?.focus(); return false; }
  return true;
}

// ── Hopper fields visibility ────────────────────────────────────────────────
function toggleHopperFields(catValue, containerId) {
  const el = document.getElementById(containerId);
  if (!el) return;
  const c = (catValue || '').toLowerCase();
  const isCoffee = c.includes('kawa') || c.includes('coffee');
  el.classList.toggle('hidden', !isCoffee);
}

// ── Category / Unit dropdown toggle ────────────────────────────────────────
function toggleCustom(selId, inputId, hiddenId) {
  const sel = document.getElementById(selId);
  const inp = document.getElementById(inputId);
  const hid = document.getElementById(hiddenId);
  if (sel.value === '__new__') {
    inp.classList.remove('hidden');
    inp.focus();
    // wire the text input to the hidden field
    inp.oninput = () => { hid.value = inp.value; };
    hid.value = '';
  } else {
    inp.classList.add('hidden');
    hid.value = sel.value;
  }
}

// Initialise hidden fields on page load (for edit form pre-filled values)
document.querySelectorAll('[id$="CatSel"],[id$="UnitSel"]').forEach(sel => {
  const suffix = sel.id.replace('CatSel','').replace('UnitSel','');
  const isCat = sel.id.includes('Cat');
  const hidId = suffix + (isCat ? 'CatHidden' : 'UnitHidden');
  const hid = document.getElementById(hidId);
  if (hid && sel.value !== '__new__') hid.value = sel.value;
});

// ── Auto-generate slug from label ─────────────────────────────────────────
function autoSlug(input) {
  const slug = input.value
    .toLowerCase()
    .normalize('NFD').replace(/[̀-ͯ]/g, '')
    .replace(/\s+/g, '_')
    .replace(/[^a-z0-9_]/g, '');
  document.getElementById('newTypeSlug').value = slug;
}

// ── Vendor product search modal ───────────────────────────────────────────
let _vendorTargetId = null;
let _vsDebounceTimer = null;

function vsDebounceSearch(phrase) {
  clearTimeout(_vsDebounceTimer);
  if (!phrase || phrase.trim().length < 2) return;
  _vsDebounceTimer = setTimeout(() => doVendorSearch(phrase.trim()), 300);
}

let _vsVendorId = null;

function onEditVendorChange(sel) {
  const opt = sel.selectedOptions[0];
  const hasApi = opt && opt.dataset.api === 'intermlecz';
  const btn = document.getElementById('editSearchBtn');
  if (btn) btn.classList.toggle('hidden', !hasApi);
}

function openVendorSearch(prefill, targetInputId, vendorId) {
  _vendorTargetId = targetInputId;
  _vsVendorId = vendorId || null;
  document.getElementById('vsInput').value = prefill || '';
  document.getElementById('vsBody').innerHTML = '';
  document.getElementById('vsResults').classList.add('hidden');
  document.getElementById('vsError').classList.add('hidden');
  document.getElementById('vsModal').classList.remove('hidden');
  document.getElementById('vsInput').focus();
  if (prefill) doVendorSearch(prefill);
}

function closeVendorSearch() {
  document.getElementById('vsModal').classList.add('hidden');
}

function selectVendorProduct(sku) {
  if (_vendorTargetId) {
    const el = document.getElementById(_vendorTargetId);
    if (el) { el.value = sku; el.dispatchEvent(new Event('input')); }
  }
  closeVendorSearch();
}

async function doVendorSearch(phrase) {
  const q = phrase || document.getElementById('vsInput').value.trim();
  if (!q) return;
  document.getElementById('vsSpinner').classList.remove('hidden');
  document.getElementById('vsLoading').classList.remove('hidden');
  document.getElementById('vsError').classList.add('hidden');
  document.getElementById('vsResults').classList.add('hidden');
  try {
    const qs = '/orders/vendor/search?q=' + encodeURIComponent(q) + (_vsVendorId ? '&vendor_id=' + _vsVendorId : '');
    const resp = await fetch(qs);
    const data = await resp.json();
    if (data.error) throw new Error(data.error);
    const tbody = document.getElementById('vsBody');
    tbody.innerHTML = '';
    if (!data.items || !data.items.length) {
      tbody.innerHTML = '<tr><td colspan="5" class="px-3 py-4 text-center text-slate-400 text-sm">Brak wyników dla „' + q + '"</td></tr>';
    } else {
      data.items.forEach(p => {
        const price = p.PriceAfterDiscountNet?.Value;
        const tr = document.createElement('tr');
        tr.className = 'border-b border-slate-100 hover:bg-blue-50 cursor-pointer';
        tr.innerHTML = `
          <td class="px-3 py-2 text-slate-800 text-sm">${p.Name || ''}</td>
          <td class="px-3 py-2 font-mono text-xs text-slate-500">${p.Sku || ''}</td>
          <td class="px-3 py-2 text-xs text-slate-500">${p.Unit || ''}</td>
          <td class="px-3 py-2 text-right font-mono text-xs text-slate-700">${price ? parseFloat(price).toFixed(2) + ' PLN' : '—'}</td>
          <td class="px-3 py-2 text-center text-xs ${p.InStock ? 'text-green-600' : 'text-red-500'}">${p.InStock ? '✓' : '✗'}</td>
          <td class="px-3 py-2 text-right">
            <button type="button" onclick="selectVendorProduct(${JSON.stringify(p.Sku)})"
              class="btn btn-primary py-0.5 text-xs">Wybierz</button>
          </td>
        `;
        tbody.appendChild(tr);
      });
    }
    document.getElementById('vsCount').textContent = 'Wyniki: ' + data.items.length + ' z ' + data.total;
    document.getElementById('vsResults').classList.remove('hidden');
  } catch (e) {
    document.getElementById('vsError').textContent = 'Błąd: ' + e.message;
    document.getElementById('vsError').classList.remove('hidden');
  } finally {
    document.getElementById('vsSpinner').classList.add('hidden');
    document.getElementById('vsLoading').classList.add('hidden');
  }
}

document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closeVendorSearch();
});

// ── Edit type panel ───────────────────────────────────────────────────────
function openTypeEdit(id, label, icon, desc, freq, isShift, sort) {
  const panel = document.getElementById('typeEditPanel');
  document.getElementById('typeEditForm').action = '/stock/admin/types/' + id;
  document.getElementById('te_label').value = label;
  document.getElementById('te_icon').value = icon;
  document.getElementById('te_desc').value = desc;
  document.getElementById('te_freq').value = freq;
  document.getElementById('te_sort').value = sort;
  document.getElementById('te_shift').checked = !!isShift;
  panel.classList.remove('hidden');
  panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
}
</script>

<!-- Vendor product search modal -->
<div id="vsModal" class="hidden fixed inset-0 bg-black/40 z-50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl shadow-xl w-full max-w-2xl flex flex-col max-h-[80vh]">
    <div class="flex items-center justify-between px-5 py-4 border-b border-slate-100">
      <h3 class="text-base font-bold text-slate-800">Szukaj produktu u dostawcy (Inter-Mlecz)</h3>
      <button type="button" onclick="closeVendorSearch()" class="text-slate-400 hover:text-slate-600 p-1">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
    <div class="px-5 py-3 border-b border-slate-100">
      <div class="flex gap-2 items-center">
        <div class="relative flex-1">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" id="vsInput" placeholder="Wpisz nazwę produktu – wyniki pojawiają się podczas pisania…"
            oninput="vsDebounceSearch(this.value)"
            onkeydown="if(event.key==='Enter'){event.preventDefault();doVendorSearch();}"
            class="w-full pl-9 pr-3 py-2 border border-slate-200 rounded-lg text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
        </div>
        <div id="vsSpinner" class="hidden flex-shrink-0">
          <svg class="animate-spin w-5 h-5 text-slate-400" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8z"/></svg>
        </div>
      </div>
      <div id="vsLoading" class="hidden text-xs text-slate-400 mt-1">Wyszukiwanie…</div>
      <div id="vsError" class="hidden text-xs text-red-600 mt-1"></div>
    </div>
    <div id="vsResults" class="hidden overflow-y-auto flex-1">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 sticky top-0 border-b border-slate-100">
          <tr class="text-left text-xs text-slate-500">
            <th class="px-3 py-2 font-medium">Nazwa</th>
            <th class="px-3 py-2 font-medium">SKU</th>
            <th class="px-3 py-2 font-medium">Jedn.</th>
            <th class="px-3 py-2 font-medium text-right">Cena netto</th>
            <th class="px-3 py-2 font-medium text-center">Dost.</th>
            <th class="px-3 py-2 font-medium"></th>
          </tr>
        </thead>
        <tbody id="vsBody"></tbody>
      </table>
      <p id="vsCount" class="text-xs text-slate-400 px-3 py-2"></p>
    </div>
    <div class="px-5 py-3 border-t border-slate-100 flex justify-end">
      <button type="button" onclick="closeVendorSearch()" class="btn btn-secondary text-sm">Zamknij</button>
    </div>
  </div>
</div>

