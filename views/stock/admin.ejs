        </div>
        <form method="POST" action="/stock/admin/items">
          <input type="hidden" name="report_type" value="<%= activeType %>">
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3">

            <div>
              <label class="block text-xs font-medium text-slate-600 mb-1">Kategoria</label>
              <select id="addCatSel" onchange="toggleCustom('addCatSel','addCatInput','addCatHidden')"
