<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>

<div class="md:ml-60 pt-14 md:pt-0 min-h-screen bg-slate-50">
  <div class="p-4 md:p-6 max-w-5xl mx-auto">

    <!-- Header -->
    <div class="flex items-center gap-3 mb-5">
      <a href="/stock?date=<%= reportDate %>" class="text-slate-400 hover:text-slate-600 p-1 -ml-1 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xl"><%= meta.icon %></span>
          <h1 class="text-lg font-bold text-slate-800"><%= meta.label %></h1>
        </div>
        <p class="text-sm text-slate-500 ml-8">
          <%= reportDate %>
          <% if (existing) { %><span class="ml-2 text-green-600 text-xs font-medium">• edytowanie</span><% } %>
        </p>
      </div>
      <button type="button" id="toggleHiddenBtn" onclick="toggleHiddenRows()"
        class="ml-auto shrink-0 inline-flex items-center gap-1.5 text-xs font-medium border rounded-lg px-3 py-2 bg-white border-slate-200 text-slate-600 hover:border-slate-300 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>
        <span>Pokaż ukryte</span>
      </button>
    </div>

    <% if (locals.error && error.length) { %>
      <div class="mb-4 bg-red-50 border border-red-200 text-red-800 rounded-lg px-4 py-3 text-sm"><%= error[0] %></div>
    <% } %>
    <% if (locals.success && success.length) { %>
      <div class="mb-4 bg-green-50 border border-green-200 text-green-800 rounded-lg px-4 py-3 text-sm"><%= success[0] %></div>
    <% } %>

    <%
    function isCoffeeCategory(cat, enabled) {
      if (!enabled) return false;
      if (!cat) return false;
      const c = cat.toLowerCase();
      return c.includes('kawa') || c.includes('coffee');
    }
    function hopperLabel(qty) {
      const q = parseFloat(qty);
      if (q === 0.25) return '1/4';
      if (q === 0.5)  return '2/4';
      if (q === 0.75) return '3/4';
      return '4/4';
    }
    function isCakeCategory(cat) {
      if (!cat) return false;
      const c = cat.toLowerCase();
      return c.includes('ciast') || c.includes('cake') || c.includes('cookie');
    }
    function addDaysStr(dateStr, days) {
      const d = new Date(dateStr + 'T00:00:00');
      d.setDate(d.getDate() + days);
      return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
    }
    function shelfDaysOf(item) { return item.shelf_life_days != null ? Number(item.shelf_life_days) : 3; }
    function isExpiredOn(deliveryDate, days, today) {
      if (!deliveryDate) return false;
      return today >= addDaysStr(deliveryDate, days);
    }
    function num(v) { const n = parseFloat(String(v == null ? '' : v).replace(',', '.')); return isNaN(n) ? 0 : n; }
    // Next day's opening stock carried from the last report:
    //   otwarcie = stan 18:00 − uszkodzone − po terminie  (never below 0).
    // Empty when there is no prior closing value to carry.
    function carryOpen(lvs) {
      if (!lvs || lvs.stan_zamkniecie == null || lvs.stan_zamkniecie === '') return '';
      const v = Math.max(0, num(lvs.stan_zamkniecie) - num(lvs.uszkodzone) - num(lvs.po_terminie));
      return String(parseFloat(v.toFixed(3)));
    }
    %>

    <form method="POST" action="/stock/save">
      <input type="hidden" name="report_type" value="<%= type %>">
      <input type="hidden" name="report_date" value="<%= reportDate %>">
      <input type="hidden" name="hidden_items" id="hiddenItemsInput" value="<%= hiddenSet.join(',') %>">
      <%/* Canonical store for cake/cookie delivery batches + shelf-life — one hidden input per item
            (filled by JS), so the dual mobile/desktop layout never double-posts. */%>
      <div id="cakeMetaInputs" class="hidden"></div>

      <% if (meta.isShift) { %>

        <% for (const group of grouped) { %>
          <% if (group.category) { %>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-5 mb-3 px-1"><%= group.category %></div>
          <% } %>

          <%/* ── MOBILE cards ── */%>
          <div class="shift-mobile space-y-3 mb-3">
            <% for (const item of group.items) { %>
              <% const e = entries[item.id] || {}; %>
              <% const lvs = lastValues[item.id]; %>
              <% const isCoffee = isCoffeeCategory(item.category, item.hopper_enabled); %>
              <% const isCake = isCakeCategory(item.category); %>
              <% const hopperWeight = parseFloat(item.hopper_weight) || 1.2; %>
              <% const hopperVal = existing ? (e.hopper_qty || null) : (lvs && lvs.hopper_qty ? lvs.hopper_qty : null); %>
              <div class="bg-white rounded-xl border border-slate-200 shadow-sm px-4 py-3" data-product-row="<%= item.id %>" data-sort-order="<%= item.sort_order %>">
                <div class="mb-3">
                  <div class="flex items-center gap-1.5">
                    <span class="text-sm font-semibold text-slate-800 flex-1"><%= item.name %></span>
                    <% if (canManageItems) { %>
                      <button type="button" onclick="toggleHideItem(<%= item.id %>)"
                        class="item-eye-btn text-slate-300 hover:text-slate-500 transition-colors shrink-0" title="Ukryj/pokaż w tym raporcie">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                      </button>
                    <% } %>
                  </div>
                  <% if (item.unit && item.unit !== '-') { %><div class="text-xs text-slate-400 mt-0.5"><%= item.unit %></div><% } %>
                </div>
                <div class="grid grid-cols-3 gap-2 mb-2">
                  <% const prefillOpen = !existing ? (e.stan_otwarcie || carryOpen(lvs)) : (e.stan_otwarcie || ''); %>
                  <div>
                    <div class="text-xs text-slate-500 mb-1 text-center leading-tight">Otwarcie<br><span class="text-slate-400">(bez dostaw)</span></div>
                    <input type="text" name="stan_otwarcie_<%= item.id %>"
                      value="<%= prefillOpen %>" placeholder="—"
                      inputmode="decimal" enterkeyhint="next" autocomplete="off"
                      onfocus="this.select()"
                      class="stock-input w-full h-11 text-center border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
                  </div>
                  <div>
                    <div class="text-xs text-slate-500 mb-1 text-center leading-tight">Dostawa<br><span class="text-slate-400">(szt.)</span></div>
                    <input type="text" name="dostawa_<%= item.id %>"
                      value="<%= e.dostawa || '' %>" placeholder="—"
                      inputmode="decimal" enterkeyhint="next" autocomplete="off"
                      onfocus="this.select()"
                      class="stock-input w-full h-11 text-center border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
                  </div>
                  <div>
                    <div class="text-xs text-slate-500 mb-1 text-center leading-tight">Stan<br><span class="text-slate-400">16:00</span></div>
                    <input type="text" name="stan_16_<%= item.id %>"
                      value="<%= e.stan_16 || '' %>" placeholder="—"
                      inputmode="decimal" enterkeyhint="next" autocomplete="off"
                      onfocus="this.select()"
                      class="stock-input w-full h-11 text-center border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
                  </div>
                </div>
                <div class="grid grid-cols-3 gap-2">
                  <div>
                    <div class="text-xs text-slate-500 mb-1 text-center leading-tight">Stan 18:00<br><span class="text-slate-400">(zamknięcie)</span></div>
                    <div class="relative">
                      <input type="text" name="stan_zamkniecie_<%= item.id %>"
                        value="<%= e.stan_zamkniecie || '' %>" placeholder="—"
                        inputmode="decimal" enterkeyhint="next" autocomplete="off"
                        onfocus="this.select()"
                        data-item-id="<%= item.id %>"
                        class="stock-input w-full h-11 text-center border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
                      <% const szVal = parseFloat((e.stan_zamkniecie || '').replace(',', '.')); const szBelow = item.min_qty !== null && !isNaN(szVal) && szVal < item.min_qty; %>
                      <span class="min-warn absolute -top-1.5 -right-1.5 bg-amber-500 text-white text-xs w-4 h-4 rounded-full flex items-center justify-center font-bold <%= !szBelow ? 'hidden' : '' %>" title="Poniżej min (<%= item.min_qty %>)">!</span>
                    </div>
                  </div>
                  <div>
                    <div class="text-xs text-slate-500 mb-1 text-center leading-tight">Uszkodzone<br><span class="text-slate-400">(g. 18:00)</span></div>
                    <input type="text" name="uszkodzone_<%= item.id %>"
                      value="<%= e.uszkodzone || '' %>" placeholder="—"
                      inputmode="decimal" enterkeyhint="next" autocomplete="off"
                      onfocus="this.select()"
                      class="stock-input w-full h-11 text-center border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
                  </div>
                  <div>
                    <div class="text-xs text-slate-500 mb-1 text-center leading-tight">Po terminie<br><span class="text-slate-400">(g. 18:00)</span></div>
                    <input type="text" name="po_terminie_<%= item.id %>"
                      value="<%= e.po_terminie || '' %>" placeholder="—"
                      inputmode="decimal" enterkeyhint="next" autocomplete="off"
                      onfocus="this.select()"
                      class="stock-input w-full h-11 text-center border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-400">
                  </div>
                </div>
                <% if (isCake) { %>
                  <div class="mt-2 cake-editor" data-cake-item="<%= item.id %>" data-variant="card"></div>
                <% } %>
                <% if (isCoffee) { %>
                  <div class="mt-3 pt-2 border-t border-slate-100">
                    <div class="text-xs text-slate-500 mb-1.5">Hopper <span class="text-slate-400">(<%= hopperWeight %> kg pełny)</span></div>
                    <div class="flex items-center gap-1.5 flex-wrap">
                      <% for (const [val, lbl] of [[0.25,'1/4'],[0.5,'2/4'],[0.75,'3/4'],[1.0,'4/4']]) { %>
                        <button type="button"
                          class="hopper-btn h-9 px-3 text-sm font-medium border rounded-lg transition-colors <%= parseFloat(hopperVal) === val ? 'bg-amber-500 text-white border-amber-500' : 'bg-white text-slate-600 border-slate-200 hover:border-amber-300' %>"
                          data-hopper-item="<%= item.id %>" data-hopper-val="<%= val %>"
                          onclick="selectHopper(<%= item.id %>, <%= val %>, <%= hopperWeight %>)">
                          <%= lbl %>
                        </button>
                      <% } %>
                      <button type="button"
                        class="h-9 px-2 text-xs text-slate-400 border border-dashed border-slate-200 rounded-lg hover:border-slate-400 hover:text-slate-600 transition-colors"
                        onclick="selectHopper(<%= item.id %>, null, <%= hopperWeight %>)">✕</button>
                      <span class="hopper-kg-<%= item.id %> text-xs text-amber-700 font-medium ml-1"><% if (hopperVal) { %><%= (parseFloat(hopperVal) * hopperWeight).toFixed(2) %> kg<% } %></span>
                    </div>
                    <input type="hidden" name="hopper_qty_<%= item.id %>" class="hopper-input-<%= item.id %>" value="<%= hopperVal || '' %>">
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>

          <%/* ── DESKTOP table ── */%>
          <div class="shift-desktop bg-white rounded-xl border border-slate-200 shadow-sm overflow-x-auto mb-3">
            <table class="w-full text-sm" style="min-width:620px">
              <thead>
                <tr class="border-b border-slate-100 bg-slate-50 text-xs text-slate-500">
                  <th class="text-left px-3 py-2.5 font-semibold w-44">Produkt</th>
                  <th class="px-2 py-2.5 font-semibold text-center"><div>Otwarcie</div><div class="font-normal text-slate-400">(bez dostaw)</div></th>
                  <th class="px-2 py-2.5 font-semibold text-center"><div>Dostawa</div><div class="font-normal text-slate-400">(szt.)</div></th>
                  <th class="px-2 py-2.5 font-semibold text-center"><div>Stan 16:00</div><div class="font-normal text-slate-400">(jednodniowe)</div></th>
                  <th class="px-2 py-2.5 font-semibold text-center"><div>Stan 18:00</div><div class="font-normal text-slate-400">(zamknięcie)</div></th>
                  <th class="px-2 py-2.5 font-semibold text-center"><div>Uszkodzone</div><div class="font-normal text-slate-400">(g. 18:00)</div></th>
                  <th class="px-2 py-2.5 font-semibold text-center"><div>Po terminie</div><div class="font-normal text-slate-400">(g. 18:00)</div></th>
                </tr>
              </thead>
              <tbody>
                <% for (const item of group.items) { %>
                  <% const e = entries[item.id] || {}; %>
                  <% const isCoffee = isCoffeeCategory(item.category, item.hopper_enabled); %>
                  <% const isCake = isCakeCategory(item.category); %>
                  <% const hopperWeight = parseFloat(item.hopper_weight) || 1.2; %>
                  <% const lvsD = lastValues[item.id]; %>
                  <% const hopperVal = existing ? (e.hopper_qty || null) : (lvsD && lvsD.hopper_qty ? lvsD.hopper_qty : null); %>
                  <% const prefillOpenD = !existing ? (e.stan_otwarcie || carryOpen(lvsD)) : (e.stan_otwarcie || ''); %>
                  <tr class="border-b border-slate-50 last:border-0" data-product-row="<%= item.id %>" data-sort-order="<%= item.sort_order %>">
                    <td class="px-3 py-2 text-xs leading-tight">
                      <span class="font-medium text-slate-800"><%= item.name %></span>
                      <% if (item.unit && item.unit !== '-') { %><span class="text-slate-400 ml-1"><%= item.unit %></span><% } %>
                      <% if (canManageItems) { %>
                        <button type="button" onclick="toggleHideItem(<%= item.id %>)"
                          class="item-eye-btn ml-1 align-middle text-slate-300 hover:text-slate-500 transition-colors" title="Ukryj/pokaż w tym raporcie">
                          <svg class="w-3.5 h-3.5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        </button>
                      <% } %>
                      <% if (isCoffee) { %>
                        <div class="flex gap-1 mt-1 flex-wrap">
                          <% for (const [val, lbl] of [[0.25,'1/4'],[0.5,'2/4'],[0.75,'3/4'],[1.0,'4/4']]) { %>
                            <button type="button"
                              class="hopper-btn h-6 px-1.5 text-xs font-medium border rounded transition-colors <%= parseFloat(hopperVal) === val ? 'bg-amber-500 text-white border-amber-500' : 'bg-slate-50 text-slate-500 border-slate-200 hover:border-amber-300' %>"
                              data-hopper-item="<%= item.id %>" data-hopper-val="<%= val %>"
                              onclick="selectHopper(<%= item.id %>, <%= val %>, <%= hopperWeight %>)">
                              <%= lbl %>
                            </button>
                          <% } %>
                          <button type="button"
                            class="h-6 px-1.5 text-xs text-slate-400 border border-dashed border-slate-200 rounded hover:border-slate-400 transition-colors"
                            onclick="selectHopper(<%= item.id %>, null, <%= hopperWeight %>)">✕</button>
                          <span class="hopper-kg-<%= item.id %> text-xs text-amber-700 font-medium"><% if (hopperVal) { %><%= (parseFloat(hopperVal) * hopperWeight).toFixed(2) %> kg<% } %></span>
                        </div>
                      <% } %>
                      <% if (isCake) { %>
                        <div class="mt-1 cake-editor" data-cake-item="<%= item.id %>" data-variant="compact"></div>
                      <% } %>
                    </td>
                    <td class="px-1.5 py-1.5"><input type="text" name="stan_otwarcie_<%= item.id %>" value="<%= prefillOpenD %>" placeholder="—" inputmode="decimal" enterkeyhint="next" autocomplete="off" onfocus="this.select()" class="stock-input w-full text-center border border-slate-200 rounded-md px-1 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-400"></td>
                    <td class="px-1.5 py-1.5"><input type="text" name="dostawa_<%= item.id %>" value="<%= e.dostawa || '' %>" placeholder="—" inputmode="decimal" enterkeyhint="next" autocomplete="off" onfocus="this.select()" class="stock-input w-full text-center border border-slate-200 rounded-md px-1 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-400"></td>
                    <td class="px-1.5 py-1.5"><input type="text" name="stan_16_<%= item.id %>" value="<%= e.stan_16 || '' %>" placeholder="—" inputmode="decimal" enterkeyhint="next" autocomplete="off" onfocus="this.select()" class="stock-input w-full text-center border border-slate-200 rounded-md px-1 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-400"></td>
                    <td class="px-1.5 py-1.5"><input type="text" name="stan_zamkniecie_<%= item.id %>" value="<%= e.stan_zamkniecie || '' %>" placeholder="—" inputmode="decimal" enterkeyhint="next" autocomplete="off" onfocus="this.select()" data-item-id="<%= item.id %>" class="stock-input w-full text-center border border-slate-200 rounded-md px-1 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-400"></td>
                    <td class="px-1.5 py-1.5"><input type="text" name="uszkodzone_<%= item.id %>" value="<%= e.uszkodzone || '' %>" placeholder="—" inputmode="decimal" enterkeyhint="next" autocomplete="off" onfocus="this.select()" class="stock-input w-full text-center border border-slate-200 rounded-md px-1 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-400"></td>
                    <td class="px-1.5 py-1.5"><input type="text" name="po_terminie_<%= item.id %>" value="<%= e.po_terminie || '' %>" placeholder="—" inputmode="decimal" enterkeyhint="next" autocomplete="off" onfocus="this.select()" class="stock-input w-full text-center border border-slate-200 rounded-md px-1 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-400"></td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>

        <% } %>

      <% } else { %>

        <%/* ── Snapshot types ── */%>
        <% for (const group of grouped) { %>
          <% if (group.category) { %>
            <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-5 mb-2 px-1"><%= group.category %></div>
          <% } %>

          <div class="snapshot-card bg-white rounded-xl border border-slate-200 shadow-sm mb-3 divide-y divide-slate-100">
            <% for (const item of group.items) { %>
              <% const e = entries[item.id] || {}; %>
              <% const lv = lastValues[item.id]; %>
              <%/* For new reports, pre-fill with last value so worker can press Enter to confirm unchanged */%>
              <% const lastQty = lv && (lv.quantity || lv.stan_zamkniecie); %>
              <% const inputVal = existing ? (e.quantity || '') : (lastQty || ''); %>
              <% const isCoffee = isCoffeeCategory(item.category, item.hopper_enabled); %>
              <% const isCake = isCakeCategory(item.category); %>
              <% const hopperWeight = parseFloat(item.hopper_weight) || 1.2; %>
              <% const hopperVal = existing ? (e.hopper_qty || null) : (lv && lv.hopper_qty ? lv.hopper_qty : null); %>
              <div class="flex items-center gap-3 px-4 py-3 flex-wrap" data-product-row="<%= item.id %>" data-sort-order="<%= item.sort_order %>">
                <div class="flex-1 min-w-0">
                  <div class="flex items-center gap-1.5">
                    <span class="text-sm font-medium text-slate-800 leading-snug"><%= item.name %></span>
                    <% if (canManageItems) { %>
                      <button type="button" onclick="toggleHideItem(<%= item.id %>)"
                        class="item-eye-btn shrink-0 text-slate-300 hover:text-slate-500 transition-colors" title="Ukryj/pokaż w tym raporcie">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                      </button>
                    <% } %>
                  </div>
                  <% if (item.unit && item.unit !== '-') { %><div class="text-xs text-slate-400 mt-0.5"><%= item.unit %></div><% } %>
                </div>
                <div class="shrink-0">
                  <div class="relative">
                    <input type="text" name="qty_<%= item.id %>"
                      value="<%= inputVal %>"
                      placeholder="—"
                      inputmode="decimal" enterkeyhint="next"
                      autocomplete="off"
                      onfocus="this.select()"
                      data-item-id="<%= item.id %>"
                      class="stock-input w-20 h-11 text-center border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-400">
                    <% const initVal = parseFloat((inputVal || '').replace(',', '.')); const belowMin = item.min_qty !== null && !isNaN(initVal) && initVal < item.min_qty; %>
                    <span class="min-warn absolute -top-1.5 -right-1.5 bg-amber-500 text-white text-xs w-4 h-4 rounded-full flex items-center justify-center font-bold <%= !belowMin ? 'hidden' : '' %>" title="Poniżej minimalnej ilości (<%= item.min_qty %>)">!</span>
                  </div>
                </div>
                <% if (isCoffee) { %>
                  <div class="w-full mt-0.5">
                    <div class="text-xs text-slate-500 mb-1.5">Hopper <span class="text-slate-400">(<%= hopperWeight %> kg pełny)</span></div>
                    <div class="flex items-center gap-1.5 flex-wrap">
                      <% for (const [val, lbl] of [[0.25,'1/4'],[0.5,'2/4'],[0.75,'3/4'],[1.0,'4/4']]) { %>
                        <button type="button"
                          class="hopper-btn h-9 px-3.5 text-sm font-medium border rounded-lg transition-colors <%= parseFloat(hopperVal) === val ? 'bg-amber-500 text-white border-amber-500' : 'bg-slate-50 text-slate-600 border-slate-200 hover:border-amber-300' %>"
                          data-hopper-item="<%= item.id %>" data-hopper-val="<%= val %>"
                          onclick="selectHopper(<%= item.id %>, <%= val %>, <%= hopperWeight %>)">
                          <%= lbl %>
                        </button>
                      <% } %>
                      <button type="button"
                        class="h-9 px-2 text-xs text-slate-400 border border-dashed border-slate-200 rounded-lg hover:border-slate-400 hover:text-slate-600 transition-colors"
                        onclick="selectHopper(<%= item.id %>, null, <%= hopperWeight %>)">✕</button>
                      <span class="hopper-kg-<%= item.id %> text-xs text-amber-700 font-semibold ml-1"><% if (hopperVal) { %><%= (parseFloat(hopperVal) * hopperWeight).toFixed(2) %> kg<% } %></span>
                    </div>
                    <% const initQty = parseFloat((inputVal || '').replace(',', '.')); const initHopperKg = parseFloat(hopperVal || 0) * hopperWeight; const initTotal = (initQty > 0 || initHopperKg > 0) ? (initQty || 0) + initHopperKg : 0; %>
                    <div class="hopper-total-wrap-<%= item.id %> mt-1 text-xs font-semibold text-slate-700 <%= initTotal > 0 ? '' : 'hidden' %>">Razem: <span class="hopper-total-<%= item.id %>"><%= initTotal > 0 ? initTotal.toFixed(2) + ' kg' : '' %></span></div>
                    <input type="hidden" name="hopper_qty_<%= item.id %>" class="hopper-input-<%= item.id %>" value="<%= hopperVal || '' %>">
                  </div>
                <% } %>
                <% if (isCake) { %>
                  <div class="w-full mt-0.5 cake-editor" data-cake-item="<%= item.id %>" data-variant="card"></div>
                <% } %>
              </div>
            <% } %>
          </div>
        <% } %>

      <% } %>

      <!-- Notes -->
      <div class="mt-5 bg-white rounded-xl border border-slate-200 shadow-sm px-4 py-4">
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Uwagi <span class="text-slate-400 font-normal">(opcjonalnie)</span></label>
        <textarea name="notes" rows="2" placeholder="Dodatkowe informacje..."
          class="stock-input w-full border border-slate-200 rounded-lg px-3 py-2.5 focus:outline-none focus:ring-2 focus:ring-blue-400 resize-none"><%= existing && existing.notes ? existing.notes : '' %></textarea>
      </div>

      <!-- Submit -->
      <div class="mt-4 flex gap-3">
        <button type="submit" class="btn btn-primary flex-1 sm:flex-none justify-center py-3 text-base">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          Zapisz raport
        </button>
        <a href="/stock?date=<%= reportDate %>" class="btn btn-secondary py-3 text-base">Anuluj</a>
      </div>
    </form>

    <!-- Quick add product — OUTSIDE main form (nested forms are invalid HTML) -->
    <% if (canManageItems) { %>
    <div class="mt-4 bg-slate-50 border border-dashed border-slate-300 rounded-xl px-4 py-3">
      <div class="text-xs font-semibold text-slate-500 mb-2">
        <svg class="w-3.5 h-3.5 inline -mt-0.5 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Dodaj nowy produkt do listy
      </div>
      <form method="POST" action="/stock/quick-add-item" class="flex flex-wrap gap-2 items-center">
        <input type="hidden" name="report_type" value="<%= type %>">
        <input type="hidden" name="report_date" value="<%= reportDate %>">
        <input type="text" name="name" required placeholder="Nazwa produktu"
          class="stock-input flex-1 min-w-40 border border-slate-200 rounded-lg px-3 py-2.5 text-sm bg-white focus:outline-none focus:ring-2 focus:ring-blue-400" autocomplete="off">
        <button type="submit" class="btn btn-success py-2.5 text-sm whitespace-nowrap">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
          Dodaj
        </button>
      </form>
    </div>
    <% } %>

  </div>
</div>

<script>
const minQtyMap = <%- JSON.stringify(minQtyMap) %>;
const hiddenItems = new Set(<%- JSON.stringify(hiddenSet) %>);
const hopperWeightMap = {<% for (const g of grouped) { for (const item of g.items) { if (isCoffeeCategory(item.category, item.hopper_enabled)) { %><%= item.id %>:<%= parseFloat(item.hopper_weight) || 1.2 %>,<% } } } %>};

// ── Cake/cookie delivery batches + per-product shelf-life ──────────────────
// One product can have several deliveries on the shelf at once, each with its own expiry
// (delivery date + the product's shelf-life). State lives here; a single hidden input per item
// (in #cakeMetaInputs) is the canonical post value, so the dual mobile/desktop layout never doubles.
const TODAY_STR = '<%= todayStr %>';
const cakeInit = {
<% for (const g of grouped) { for (const item of g.items) { if (isCakeCategory(item.category)) { %>  <%= item.id %>: { days: <%= shelfDaysOf(item) %>, dates: <%- JSON.stringify((deliveryMap && deliveryMap[item.id]) || []) %> },
<% } } } %>};
const cakeState = {};
Object.keys(cakeInit).forEach(id => {
  cakeState[id] = { days: cakeInit[id].days || 3, dates: (cakeInit[id].dates || []).slice() };
});

function addDaysISO(dateStr, days) {
  const d = new Date(dateStr + 'T00:00:00');
  d.setDate(d.getDate() + days);
  return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0');
}

function ensureCakeInputs(id) {
  const wrap = document.getElementById('cakeMetaInputs');
  let dd = wrap.querySelector(`input[name="delivery_dates_${id}"]`);
  if (!dd) { dd = document.createElement('input'); dd.type = 'hidden'; dd.name = `delivery_dates_${id}`; wrap.appendChild(dd); }
  let sl = wrap.querySelector(`input[name="shelf_life_${id}"]`);
  if (!sl) { sl = document.createElement('input'); sl.type = 'hidden'; sl.name = `shelf_life_${id}`; wrap.appendChild(sl); }
  return { dd, sl };
}

function syncCakeHidden(id) {
  const s = cakeState[id];
  const { dd, sl } = ensureCakeInputs(id);
  const clean = s.dates.filter(d => /^\d{4}-\d{2}-\d{2}$/.test(d));
  dd.value = clean.length ? JSON.stringify(clean) : '';
  sl.value = s.days != null ? String(s.days) : '';
}

function renderCakeEditor(id) {
  const s = cakeState[id];
  if (!s) return;
  s.dates = s.dates.slice(0, 1); // single delivery per product
  syncCakeHidden(id);
  document.querySelectorAll(`.cake-editor[data-cake-item="${id}"]`).forEach(box => {
    let deliveryHtml;
    if (!s.dates.length) {
      deliveryHtml =
        `<button type="button" data-cake-add="${id}" title="Dodaj dostawę"
           class="inline-flex items-center gap-0.5 h-7 px-1.5 border border-dashed border-slate-300 rounded text-slate-400 hover:text-slate-600 hover:border-slate-400 transition-colors">🚚<span class="font-semibold">+</span></button>`;
    } else {
      const d = s.dates[0];
      const exp = /^\d{4}-\d{2}-\d{2}$/.test(d) ? addDaysISO(d, s.days) : '';
      const expired = exp && TODAY_STR >= exp;
      const expShort = exp ? exp.slice(8, 10) + '.' + exp.slice(5, 7) : '';
      deliveryHtml =
        `<span title="Dostawa">🚚</span>
         <input type="date" value="${d}" data-cake-date="${id}" data-batch-idx="0"
           class="cake-date-input h-7 px-1 border border-slate-200 rounded text-xs focus:outline-none focus:ring-2 focus:ring-blue-400">
         ${exp ? `<span class="whitespace-nowrap ${expired ? 'text-red-600 font-semibold' : 'text-slate-400'}">do ${expShort}${expired ? ' ⚠' : ''}</span>` : ''}
         <button type="button" data-cake-remove="${id}" data-batch-idx="0" title="Usuń dostawę" class="text-slate-300 hover:text-red-500 leading-none px-0.5">✕</button>`;
    }
    box.innerHTML =
      `<div class="flex items-center gap-1.5 text-xs text-slate-500 flex-wrap">
         ${deliveryHtml}
         <span class="text-slate-200">·</span>
         <input type="number" min="1" max="60" value="${s.days}" data-cake-shelf="${id}" title="Przydatność (dni)"
           class="w-10 h-7 text-center border border-slate-200 rounded text-xs focus:outline-none focus:ring-2 focus:ring-blue-400"><span class="text-slate-400">dni</span>
       </div>`;
  });
}

document.addEventListener('change', e => {
  const t = e.target;
  if (!t || !t.dataset) return;
  if (t.dataset.cakeDate !== undefined) {
    const id = t.dataset.cakeDate, idx = parseInt(t.dataset.batchIdx, 10);
    cakeState[id].dates[idx] = t.value || '';
    renderCakeEditor(id);
  } else if (t.dataset.cakeShelf !== undefined) {
    const id = t.dataset.cakeShelf;
    const n = parseInt(t.value, 10);
    cakeState[id].days = Number.isFinite(n) && n > 0 ? n : 3;
    renderCakeEditor(id);
  }
});

document.addEventListener('click', e => {
  const add = e.target.closest('[data-cake-add]');
  if (add) { const id = add.dataset.cakeAdd;
    if (!cakeState[id].dates.length) cakeState[id].dates.push(TODAY_STR); // one delivery max, prefill today
    renderCakeEditor(id);
    const box = document.querySelector(`.cake-editor[data-cake-item="${id}"]`);
    const inp = box ? box.querySelector('input[type="date"]') : null;
    if (inp) { inp.focus(); try { inp.showPicker && inp.showPicker(); } catch (_) {} }
    return; }
  const rem = e.target.closest('[data-cake-remove]');
  if (rem) { const id = rem.dataset.cakeRemove, idx = parseInt(rem.dataset.batchIdx, 10);
    cakeState[id].dates.splice(idx, 1); renderCakeEditor(id); }
});

document.addEventListener('DOMContentLoaded', () => {
  Object.keys(cakeState).forEach(id => renderCakeEditor(id));
});

function updateHiddenInput() {
  document.getElementById('hiddenItemsInput').value = [...hiddenItems].join(',');
}

function resortParent(parent) {
  const rows = Array.from(parent.children).filter(el => el.hasAttribute('data-product-row'));
  if (rows.length <= 1) return;
  rows.sort((a, b) => {
    const aHidden = hiddenItems.has(parseInt(a.dataset.productRow));
    const bHidden = hiddenItems.has(parseInt(b.dataset.productRow));
    if (aHidden !== bHidden) return aHidden ? 1 : -1;
    return (parseInt(a.dataset.sortOrder) || 0) - (parseInt(b.dataset.sortOrder) || 0);
  });
  rows.forEach(row => parent.appendChild(row));
}

function applyHideState(itemId, hide) {
  document.querySelectorAll(`[data-product-row="${itemId}"]`).forEach(row => {
    row.style.opacity = hide ? '0.35' : '';
    // Keep the entered amounts — hiding only greys/locks the row (values stay
    // in the inputs and in the saved entry, so unhiding brings them back)
    row.querySelectorAll('input[inputmode="decimal"]').forEach(inp => {
      inp.disabled = hide;
    });
    const btn = row.querySelector('.item-eye-btn');
    if (btn) btn.style.color = hide ? '#ef4444' : '';
    resortParent(row.parentElement);
  });
}

function toggleHideItem(itemId) {
  const hide = !hiddenItems.has(itemId);
  if (hide) hiddenItems.add(itemId); else hiddenItems.delete(itemId);
  applyHideState(itemId, hide);
  updateHiddenInput();
  applyCollapseHidden();
  // Persist in the DB (global for all users/devices); roll back on failure
  fetch('/stock/toggle-item-hidden', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ item_id: itemId, report_type: '<%= type %>' })
  })
    .then(r => r.json())
    .then(d => { if (!d.ok) throw new Error('save failed'); })
    .catch(() => {
      if (hide) hiddenItems.delete(itemId); else hiddenItems.add(itemId);
      applyHideState(itemId, !hide);
      updateHiddenInput();
      applyCollapseHidden();
      alert('Nie udało się zapisać ukrycia produktu. Spróbuj ponownie.');
    });
}

function updateHopperTotal(itemId, hopperKg) {
  const wrap = document.querySelector(`.hopper-total-wrap-${itemId}`);
  const span = document.querySelector(`.hopper-total-${itemId}`);
  if (!wrap || !span) return;
  const qtyInp = Array.from(document.querySelectorAll(`input[name="qty_${itemId}"]`))
    .find(el => el.offsetParent !== null);
  const qty = qtyInp ? (parseFloat((qtyInp.value || '').replace(',', '.')) || 0) : 0;
  const total = qty + hopperKg;
  if (qty > 0 || hopperKg > 0) {
    span.textContent = `${total.toFixed(2)} kg`;
    wrap.classList.remove('hidden');
  } else {
    wrap.classList.add('hidden');
  }
}

function selectHopper(itemId, val, weight) {
  // Update all hidden inputs for this item (mobile + desktop layouts)
  document.querySelectorAll(`.hopper-input-${itemId}`).forEach(inp => {
    inp.value = val !== null ? val : '';
  });

  // Update button active states for all layouts
  document.querySelectorAll(`[data-hopper-item="${itemId}"].hopper-btn`).forEach(btn => {
    const isActive = val !== null && parseFloat(btn.dataset.hopperVal) === val;
    btn.classList.toggle('bg-amber-500', isActive);
    btn.classList.toggle('text-white', isActive);
    btn.classList.toggle('border-amber-500', isActive);
    btn.classList.toggle('bg-white', !isActive);
    btn.classList.toggle('bg-slate-50', !isActive);
    btn.classList.toggle('text-slate-600', !isActive);
    btn.classList.toggle('text-slate-500', !isActive);
    btn.classList.toggle('border-slate-200', !isActive);
  });

  // Update kg display for all layouts
  document.querySelectorAll(`.hopper-kg-${itemId}`).forEach(el => {
    el.textContent = val ? `${(val * weight).toFixed(2)} kg` : '';
  });

  // Update total
  updateHopperTotal(itemId, val ? val * weight : 0);
}

document.addEventListener('DOMContentLoaded', () => {
  // Clear inputs in the hidden half so pre-filled old values don't override
  // what the user types in the visible half (dual-layout sends both)
  document.querySelectorAll('input[inputmode="decimal"]').forEach(inp => {
    if (inp.offsetParent === null) inp.value = '';
  });

  // Apply per-report hidden items (also triggers resort so hidden start at bottom)
  hiddenItems.forEach(id => applyHideState(id, true));
  updateHiddenInput();
});

// Valid value: empty, dash, or non-negative number (integer or decimal, . or , separator)
function isValidQty(v) {
  const s = (v || '').trim();
  return !s || s === '—' || s === '-' || /^\d+([.,]\d+)?$/.test(s);
}

function applyValidStyle(inp, valid) {
  inp.style.borderColor = valid ? '' : '#f87171';
  inp.style.outline    = valid ? '' : '2px solid rgba(248,113,113,0.5)';
}

// Validation + min-qty check on every input event
document.addEventListener('input', e => {
  const inp = e.target;
  if (inp.getAttribute('inputmode') !== 'decimal') return;

  const valid = isValidQty(inp.value);
  applyValidStyle(inp, valid);

  // min-qty badge + hopper total
  const itemId = inp.dataset.itemId;
  if (itemId) {
    const val = parseFloat((inp.value || '').replace(',', '.'));
    const min = minQtyMap[itemId];
    const warn = inp.parentElement.querySelector('.min-warn');
    if (warn) warn.classList.toggle('hidden', isNaN(val) || min === undefined || val >= min);

    if (hopperWeightMap[itemId] !== undefined) {
      const hopperInput = document.querySelector(`.hopper-input-${itemId}`);
      const hopperFrac = hopperInput ? (parseFloat(hopperInput.value) || 0) : 0;
      updateHopperTotal(itemId, hopperFrac * hopperWeightMap[itemId]);
    }
  }
});

document.querySelector('form').addEventListener('submit', e => {
  // 1. Disable hidden-half inputs (dual layout) so they don't double-post
  document.querySelectorAll('input[inputmode="decimal"]').forEach(inp => {
    if (inp.offsetParent === null) inp.disabled = true;
  });
  document.querySelectorAll('input[type="date"]').forEach(inp => {
    if (inp.offsetParent === null) inp.disabled = true;
  });

  // 2. Block submission if any visible input has a non-integer value
  const bad = Array.from(document.querySelectorAll('input[inputmode="decimal"]'))
    .filter(inp => !inp.disabled && inp.offsetParent !== null && !isValidQty(inp.value));

  if (bad.length) {
    e.preventDefault();
    bad.forEach(inp => applyValidStyle(inp, false));
    bad[0].focus();
    bad[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
});

// Enter/Next key → jump to next visible input
document.addEventListener('DOMContentLoaded', () => {
  function visibleInputs() {
    return Array.from(document.querySelectorAll('input[inputmode="decimal"]'))
      .filter(el => el.offsetParent !== null);
  }

  let lastHandled = 0;
  function handleEnter(e) {
    if (e.key !== 'Enter' && e.keyCode !== 13) return;
    const now = Date.now();
    if (now - lastHandled < 100) return;
    lastHandled = now;
    const inputs = visibleInputs();
    const idx = inputs.indexOf(document.activeElement);
    if (idx === -1) return;
    e.preventDefault();
    const next = inputs[idx + 1];
    if (next) { next.focus(); next.select(); }
  }

  document.addEventListener('keydown', handleEnter);
  document.addEventListener('keyup', handleEnter);
});

// ── Header toggle: collapse hidden (grey) products ──────────────────────────
// Products marked with the eye icon live in `hiddenItems` (grey, sorted to the
// bottom of their section). By default they are fully collapsed so the list
// shows only products in use; the header button reveals them (still grey, at
// the bottom) so they can be unhidden. Choice is remembered per report type.
const COLLAPSE_HIDDEN_KEY = 'stockCollapseHidden_<%= type %>';
let collapseHidden = true;
try { collapseHidden = localStorage.getItem(COLLAPSE_HIDDEN_KEY) !== '0'; } catch (_) {}

function applyCollapseHidden() {
  document.querySelectorAll('[data-product-row]').forEach(row => {
    const id = parseInt(row.dataset.productRow);
    row.style.display = (collapseHidden && hiddenItems.has(id)) ? 'none' : '';
  });
  const btn = document.getElementById('toggleHiddenBtn');
  if (btn) {
    btn.querySelector('span').textContent = collapseHidden
      ? `Pokaż ukryte (${hiddenItems.size})`
      : `Schowaj ukryte (${hiddenItems.size})`;
    btn.classList.toggle('bg-blue-50', !collapseHidden);
    btn.classList.toggle('border-blue-300', !collapseHidden);
    btn.classList.toggle('text-blue-700', !collapseHidden);
    btn.classList.toggle('bg-white', collapseHidden);
    btn.classList.toggle('border-slate-200', collapseHidden);
    btn.classList.toggle('text-slate-600', collapseHidden);
  }
}

function toggleHiddenRows() {
  collapseHidden = !collapseHidden;
  try { localStorage.setItem(COLLAPSE_HIDDEN_KEY, collapseHidden ? '1' : '0'); } catch (_) {}
  applyCollapseHidden();
}

// Runs after the earlier DOMContentLoaded handlers (registration order), so the
// per-report hides (grey + resort to bottom) are already applied.
document.addEventListener('DOMContentLoaded', applyCollapseHidden);
</script>

<%- include('../partials/footer') %>
