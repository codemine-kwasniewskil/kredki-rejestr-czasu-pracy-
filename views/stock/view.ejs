<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>

<div class="md:ml-60 pt-14 md:pt-0 min-h-screen bg-slate-50">
  <div class="p-4 md:p-6 max-w-5xl mx-auto">

    <!-- Header -->
    <div class="flex items-center gap-3 mb-5">
      <a href="/stock?date=<%= report.report_date %>" class="text-slate-400 hover:text-slate-600 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <div class="flex-1 min-w-0">
        <div class="flex items-center gap-2">
          <span class="text-xl"><%= meta.icon %></span>
          <h1 class="text-lg font-bold text-slate-800"><%= meta.label %></h1>
        </div>
        <p class="text-sm text-slate-500 ml-8">
          <%= report.report_date %> &middot; <%= report.submitted_by_name %>
        </p>
      </div>
      <a href="/stock/form/<%= report.report_type %>?date=<%= report.report_date %>" class="btn btn-primary text-xs py-1.5">Edytuj</a>
    </div>

    <% if (locals.success && success.length) { %>
      <div class="mb-4 bg-green-50 border border-green-200 text-green-800 rounded-lg px-4 py-3 text-sm"><%= success[0] %></div>
    <% } %>

    <% if (report.report_type === 'products_shift') { %>
      <% for (const group of grouped) { %>
        <% if (group.category) { %>
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-5 mb-3 px-1"><%= group.category %></div>
        <% } %>

        <%/* Mobile: cards */%>
        <div class="shift-mobile space-y-2 mb-3">
          <% for (const item of group.items) { %>
            <% const hasData = item.stan_otwarcie || item.dostawa || item.stan_16 || item.stan_zamkniecie || item.uszkodzone; %>
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm px-4 py-3 <%= !hasData ? 'opacity-40' : '' %>">
              <div class="text-sm font-semibold text-slate-800 mb-2"><%= item.name %></div>
              <div class="grid grid-cols-3 gap-2 mb-2 text-center">
                <div>
                  <div class="text-xs text-slate-400 mb-0.5">Otwarcie</div>
                  <div class="text-sm font-medium text-slate-700"><%= item.stan_otwarcie || '—' %></div>
                </div>
                <div>
                  <div class="text-xs text-slate-400 mb-0.5">Dostawa</div>
                  <div class="text-sm font-medium text-slate-700"><%= item.dostawa || '—' %></div>
                </div>
                <div>
                  <div class="text-xs text-slate-400 mb-0.5">16:00</div>
                  <div class="text-sm font-medium text-slate-700"><%= item.stan_16 || '—' %></div>
                </div>
              </div>
              <% const szv = parseFloat(item.stan_zamkniecie); const szBelow = item.min_qty !== null && !isNaN(szv) && szv < item.min_qty; %>
              <div class="grid grid-cols-2 gap-2 text-center">
                <div>
                  <div class="text-xs text-slate-400 mb-0.5">18:00</div>
                  <div class="text-sm font-medium flex items-center justify-center gap-1 <%= szBelow ? 'text-amber-700' : 'text-slate-700' %>">
                    <%= item.stan_zamkniecie || '—' %><% if (szBelow) { %> <span class="text-amber-500">⚠️</span><% } %>
                  </div>
                  <% if (item.min_qty !== null) { %><div class="text-xs text-slate-400">min: <%= item.min_qty %></div><% } %>
                </div>
                <div>
                  <div class="text-xs text-slate-400 mb-0.5">Uszkodzone</div>
                  <div class="text-sm font-medium <%= item.uszkodzone && item.uszkodzone !== '0' ? 'text-red-600' : 'text-slate-700' %>"><%= item.uszkodzone || '—' %></div>
                </div>
              </div>
            </div>
          <% } %>
        </div>

        <%/* Desktop: table */%>
        <div class="shift-desktop bg-white rounded-xl border border-slate-200 shadow-sm overflow-x-auto mb-3">
          <table class="w-full text-sm" style="min-width:580px">
            <thead>
              <tr class="border-b border-slate-100 bg-slate-50 text-xs text-slate-500">
                <th class="text-left px-3 py-2.5 font-semibold w-44">Produkt</th>
                <th class="px-3 py-2.5 font-semibold text-center">Otwarcie</th>
                <th class="px-3 py-2.5 font-semibold text-center">Dostawa</th>
                <th class="px-3 py-2.5 font-semibold text-center">16:00</th>
                <th class="px-3 py-2.5 font-semibold text-center">18:00</th>
                <th class="px-3 py-2.5 font-semibold text-center">Uszkodzone</th>
              </tr>
            </thead>
            <tbody>
              <% for (const item of group.items) { %>
                <% const hasData = item.stan_otwarcie || item.dostawa || item.stan_16 || item.stan_zamkniecie || item.uszkodzone; %>
                <tr class="border-b border-slate-50 last:border-0 <%= !hasData ? 'opacity-40' : '' %>">
                  <td class="px-3 py-2 text-xs font-medium text-slate-800 leading-tight"><%= item.name %></td>
                  <td class="px-3 py-2 text-center text-slate-700"><%= item.stan_otwarcie || '—' %></td>
                  <td class="px-3 py-2 text-center text-slate-700"><%= item.dostawa || '—' %></td>
                  <td class="px-3 py-2 text-center text-slate-700"><%= item.stan_16 || '—' %></td>
                  <td class="px-3 py-2 text-center text-slate-700"><%= item.stan_zamkniecie || '—' %></td>
                  <td class="px-3 py-2 text-center <%= item.uszkodzone && item.uszkodzone !== '0' ? 'text-red-600 font-semibold' : 'text-slate-700' %>"><%= item.uszkodzone || '—' %></td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      <% } %>

    <% } else { %>
      <!-- Snapshot view -->
      <% for (const group of grouped) { %>
        <% if (group.category) { %>
          <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mt-5 mb-2 px-1"><%= group.category %></div>
        <% } %>

        <div class="snapshot-card bg-white rounded-xl border border-slate-200 shadow-sm mb-3 divide-y divide-slate-50">
          <% for (const item of group.items) { %>
            <% const qVal = parseFloat(item.quantity); const qBelow = item.min_qty !== null && !isNaN(qVal) && qVal < item.min_qty; %>
            <div class="flex items-center justify-between px-4 py-2.5 <%= qBelow ? 'bg-amber-50' : '' %>">
              <div>
                <div class="text-sm font-medium text-slate-800 flex items-center gap-1.5">
                  <%= item.name %>
                  <% if (qBelow) { %><span class="text-amber-600 text-xs font-semibold">⚠️ mało</span><% } %>
                </div>
                <% if (item.min_qty !== null) { %>
                  <div class="text-xs text-amber-600">Min: <%= item.min_qty %></div>
                <% } %>
              </div>
              <div class="flex items-center gap-2">
                <% if (item.quantity) { %>
                  <span class="font-semibold text-sm <%= qBelow ? 'text-amber-700' : 'text-slate-800' %>"><%= item.quantity %></span>
                  <% if (item.unit && item.unit !== '-') { %>
                    <span class="text-xs text-slate-400"><%= item.unit %></span>
                  <% } %>
                <% } else { %>
                  <span class="text-slate-300 text-sm">—</span>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>
      <% } %>
    <% } %>

    <!-- Notes -->
    <% if (report.notes) { %>
      <div class="mt-4 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3">
        <div class="text-xs font-semibold text-amber-700 mb-1">Uwagi</div>
        <div class="text-sm text-amber-900"><%= report.notes %></div>
      </div>
    <% } %>

    <div class="mt-4 text-xs text-slate-400">
      Ostatnia aktualizacja: <%= report.updated_at || report.created_at %>
    </div>

  </div>
</div>

<%- include('../partials/footer') %>
