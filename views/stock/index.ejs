<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>

<div class="md:ml-60 pt-14 md:pt-0 min-h-screen bg-slate-50">
  <div class="p-4 md:p-6 max-w-4xl mx-auto">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-6">
      <div>
        <h1 class="text-xl font-bold text-slate-800">Raport Stanów</h1>
        <p class="text-sm text-slate-500 mt-0.5">Codzienne i cykliczne kontrole zapasów</p>
      </div>
      <div class="flex items-center gap-2">
        <!-- Day messages bell -->
        <button type="button" onclick="openMsgPanel()" title="Wiadomości na ten dzień"
          class="relative inline-flex items-center justify-center w-10 h-10 rounded-lg border border-slate-300 bg-white text-slate-600 hover:bg-slate-50 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.86 9.86 0 01-4-.84L3 20l1.07-3.21A7.96 7.96 0 013 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
          <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
            <span id="msgBadge" class="absolute -top-1.5 -right-1.5 min-w-[18px] h-[18px] px-1 rounded-full bg-red-500 text-white text-[11px] font-bold flex items-center justify-center leading-none"><%= unreadCount %></span>
          <% } %>
        </button>
        <input type="date" id="dateFilter" value="<%= reportDate %>"
          class="border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
          onchange="window.location='/stock?date='+this.value">
        <% if (user && (user.role === 'admin' || user.role === 'location_manager')) { %>
          <a href="/stock/admin" class="btn btn-secondary text-sm py-2">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Zarządzaj
          </a>
        <% } %>
      </div>
    </div>

    <% if (locals.success && success.length) { %>
      <div class="mb-4 bg-green-50 border border-green-200 text-green-800 rounded-lg px-4 py-3 text-sm"><%= success[0] %></div>
    <% } %>
    <% if (locals.error && error.length) { %>
      <div class="mb-4 bg-red-50 border border-red-200 text-red-800 rounded-lg px-4 py-3 text-sm"><%= error[0] %></div>
    <% } %>

    <!-- Report type cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      <% const types = ['daily_morning','biweekly','cakes_noon','products_shift']; %>
      <% for (const type of types) { %>
        <% const meta = REPORT_META[type]; %>
        <% const existing = reportsByType[type]; %>
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
          <div class="px-4 pt-4 pb-3 flex items-start gap-3">
            <span class="text-2xl mt-0.5"><%= meta.icon %></span>
            <div class="flex-1 min-w-0">
              <div class="font-semibold text-slate-800 text-sm leading-tight"><%= meta.label %></div>
              <div class="text-xs text-slate-500 mt-0.5"><%= meta.freq %></div>
              <div class="text-xs text-slate-400 mt-1"><%= meta.desc %></div>
            </div>
          </div>

          <% if (existing) { %>
            <div class="px-4 pb-3 flex items-center gap-2">
              <span class="inline-flex items-center gap-1 bg-green-100 text-green-700 text-xs font-medium px-2 py-0.5 rounded-full">
                <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                Wypełniony
              </span>
              <span class="text-xs text-slate-400">przez <%= existing.submitted_by_name %></span>
            </div>
            <div class="px-4 pb-4 flex gap-2">
              <a href="/stock/view/<%= existing.id %>" class="btn btn-secondary text-sm py-2.5 flex-1 justify-center">Podgląd</a>
              <a href="/stock/form/<%= type %>?date=<%= reportDate %>" class="btn btn-primary text-sm py-2.5 flex-1 justify-center">Edytuj</a>
            </div>
          <% } else { %>
            <div class="px-4 pb-3">
              <span class="inline-flex items-center gap-1 bg-slate-100 text-slate-500 text-xs font-medium px-2 py-0.5 rounded-full">
                Brak raportu
              </span>
            </div>
            <div class="px-4 pb-4">
              <a href="/stock/form/<%= type %>?date=<%= reportDate %>" class="btn btn-primary text-sm py-2.5 w-full justify-center">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                Wypełnij raport
              </a>
            </div>
          <% } %>
        </div>
      <% } %>
    </div>

    <!-- Recent history -->
    <% if (history.length > 0) { %>
    <div>
      <h2 class="text-sm font-semibold text-slate-600 uppercase tracking-wider mb-3">Ostatnie 7 dni</h2>
      <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-100 bg-slate-50">
              <th class="text-left px-4 py-2.5 text-xs font-semibold text-slate-500">Data</th>
              <th class="text-left px-4 py-2.5 text-xs font-semibold text-slate-500">Typ raportu</th>
              <th class="text-left px-4 py-2.5 text-xs font-semibold text-slate-500 hidden sm:table-cell">Wypełnił/a</th>
              <th class="px-4 py-2.5"></th>
            </tr>
          </thead>
          <tbody>
            <% for (const row of history) { %>
            <tr class="border-b border-slate-50 hover:bg-slate-50 transition-colors">
              <td class="px-4 py-2.5 text-slate-700 font-medium"><%= row.report_date %></td>
              <td class="px-4 py-2.5">
                <span class="inline-flex items-center gap-1.5 text-slate-700">
                  <span><%= REPORT_META[row.report_type].icon %></span>
                  <span class="text-xs"><%= REPORT_META[row.report_type].label %></span>
                </span>
              </td>
              <td class="px-4 py-2.5 text-slate-500 text-xs hidden sm:table-cell"><%= row.submitted_by_name %></td>
              <td class="px-4 py-2.5 text-right">
                <a href="/stock/view/<%= row.id %>" class="text-blue-600 hover:text-blue-800 text-xs font-medium">Podgląd</a>
              </td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>

  </div>
</div>

<!-- Day messages panel -->
<div id="msgPanel" class="hidden fixed inset-0 z-50">
  <div class="absolute inset-0 bg-slate-900/40" onclick="closeMsgPanel()"></div>
  <div class="absolute inset-x-0 bottom-0 sm:inset-0 sm:m-auto sm:max-w-md sm:h-fit sm:rounded-2xl bg-white rounded-t-2xl shadow-xl flex flex-col max-h-[85vh]">
    <div class="flex items-center justify-between px-4 py-3 border-b border-slate-100">
      <div>
        <h2 class="text-sm font-bold text-slate-800">Wiadomości</h2>
        <p class="text-xs text-slate-400"><%= reportDate %></p>
      </div>
      <button type="button" onclick="closeMsgPanel()" class="text-slate-400 hover:text-slate-600 p-1">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="flex-1 overflow-y-auto px-4 py-3 space-y-2">
      <% if (!messages || messages.length === 0) { %>
        <p class="text-sm text-slate-400 text-center py-6">Brak wiadomości na ten dzień.</p>
      <% } else { %>
        <% for (const m of messages) { %>
          <div class="rounded-xl border <%= m.is_read ? 'border-slate-200 bg-white' : 'border-blue-200 bg-blue-50' %> px-3 py-2">
            <div class="flex items-center justify-between gap-2">
              <div class="text-xs font-semibold text-slate-700"><%= m.author_name %></div>
              <div class="flex items-center gap-2">
                <span class="text-xs text-slate-400"><%= String(m.created_at).slice(11, 16) %></span>
                <% if (user && (m.user_id === user.id || user.role === 'admin' || user.role === 'location_manager' || user.role === 'super_admin')) { %>
                  <form method="POST" action="/stock/messages/<%= m.id %>?_method=DELETE" onsubmit="return confirm('Usunąć wiadomość?')">
                    <input type="hidden" name="message_date" value="<%= reportDate %>">
                    <button type="submit" class="text-slate-300 hover:text-red-500" title="Usuń">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
            <div class="text-sm text-slate-700 mt-1 whitespace-pre-wrap break-words"><%= m.body %></div>
          </div>
        <% } %>
      <% } %>
    </div>

    <form method="POST" action="/stock/messages" class="border-t border-slate-100 p-3 flex items-end gap-2">
      <input type="hidden" name="message_date" value="<%= reportDate %>">
      <textarea name="body" rows="1" required placeholder="Napisz wiadomość…"
        class="flex-1 resize-none border border-slate-300 rounded-lg px-3 py-2 text-sm text-slate-700 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
      <button type="submit" class="btn btn-primary text-sm py-2 px-4 shrink-0">Wyślij</button>
    </form>
  </div>
</div>

<script>
  function openMsgPanel() {
    document.getElementById('msgPanel').classList.remove('hidden');
    const badge = document.getElementById('msgBadge');
    if (badge) {
      fetch('/stock/messages/read', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ message_date: '<%= reportDate %>' }),
      }).then(() => badge.remove()).catch(() => {});
    }
  }
  function closeMsgPanel() {
    document.getElementById('msgPanel').classList.add('hidden');
  }
</script>

<%- include('../partials/footer') %>
