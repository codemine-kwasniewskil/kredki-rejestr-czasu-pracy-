<%- include('../partials/head', { title }) %>
<%- include('../partials/nav') %>

<div class="md:ml-60 pt-14 md:pt-0 min-h-screen bg-slate-50">
  <div class="p-4 md:p-6 max-w-5xl mx-auto">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-5">
      <div class="flex items-center gap-3">
        <a href="/stock" class="text-slate-400 hover:text-slate-600 p-1 -ml-1 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </a>
        <div>
          <h1 class="text-lg font-bold text-slate-800">Podsumowanie miesięczne</h1>
          <p class="text-sm text-slate-500">Produkty i ilości w podziale na dostawców — <%= monthLabel %></p>
        </div>
      </div>
      <form method="GET" action="/stock/summary" class="flex items-center gap-2">
        <select name="month" onchange="this.form.submit()"
                class="border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 bg-white">
          <% monthOptions.forEach(o => { %>
          <option value="<%= o.val %>" <%= o.val === month ? 'selected' : '' %>><%= o.label %></option>
          <% }) %>
        </select>
      </form>
    </div>

    <p class="text-xs text-slate-400 mb-4">Ilość = suma dostaw (raporty zmianowe) lub suma zgłoszonych ilości (pozostałe) w danym miesiącu.</p>

    <% if (suppliers.length === 0) { %>
    <div class="bg-white border border-slate-200 rounded-xl text-center py-12 text-slate-400">
      <p class="font-medium">Brak danych w tym miesiącu</p>
    </div>
    <% } else { %>

    <% suppliers.forEach(s => { %>
    <div class="bg-white border border-slate-200 rounded-xl shadow-sm overflow-hidden mb-5">
      <div class="px-4 py-3 border-b border-slate-100 bg-slate-50 flex items-center justify-between">
        <span class="text-sm font-semibold text-slate-700"><%= s.name %></span>
        <span class="text-xs text-slate-400"><%= s.products.length %> produkt<% if (s.products.length === 1) { %><% } else if (s.products.length < 5) { %>y<% } else { %>ów<% } %></span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-100 text-left text-xs text-slate-500">
              <th class="px-4 py-2.5 font-semibold uppercase tracking-wide">Produkt</th>
              <th class="px-4 py-2.5 font-semibold uppercase tracking-wide text-right">Ilość</th>
              <th class="px-4 py-2.5 font-semibold uppercase tracking-wide text-right hidden sm:table-cell">Wpisów</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            <% s.products.forEach(p => { %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-2.5 font-medium text-slate-800">
                <%= p.name %>
                <% if (p.grouped && p.memberCount > 1) { %><span class="ml-1 text-xs font-normal text-slate-400">(grupa: <%= p.memberCount %>)</span><% } %>
              </td>
              <td class="px-4 py-2.5 text-slate-700 text-right whitespace-nowrap">
                <%= p.totalStr %><% if (p.unit && p.unit !== '-') { %> <span class="text-slate-400"><%= p.unit %></span><% } %>
              </td>
              <td class="px-4 py-2.5 text-slate-400 text-right whitespace-nowrap hidden sm:table-cell"><%= p.entries %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% }) %>

    <% } %>

  </div>
</div>

<%- include('../partials/footer') %>
