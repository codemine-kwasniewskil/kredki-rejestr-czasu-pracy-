<% locals.currentPath = '/reports/employee'; %>
<% const canEdit = user && (user.role === 'admin' || user.role === 'super_admin'); %>
<%- include('../partials/head', { title: 'Karta czasu pracy – ' + employee.name }) %>
<%- include('../partials/nav') %>

<main class="md:ml-60 min-h-screen p-4 sm:p-6 pt-20 md:pt-6">
  <div class="max-w-4xl mx-auto">

    <!-- Toolbar (hidden on print) -->
    <div class="no-print flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-4 flex-wrap">
      <h1 class="text-xl font-bold text-slate-800">Karta czasu pracy</h1>
      <div class="flex items-center gap-3 flex-wrap">
        <span class="text-xs text-slate-400">Przed drukiem wyłącz <em>Nagłówki i stopki</em> w oknie drukowania</span>
        <a href="/reports/actual/<%= employee.id %>/<%= month %>"
           class="btn btn-secondary text-xs">🕒 Odbicia (plan vs. faktycznie)</a>
        <a href="/reports/employee/<%= employee.id %>/<%= month %>/csv"
           class="btn btn-secondary text-xs">⬇ Pobierz CSV (Excel)</a>
        <button onclick="window.print()" class="btn btn-primary text-xs">🖨 Drukuj / PDF</button>
      </div>
    </div>

    <!-- Selector (hidden on print) -->
    <div class="no-print bg-white rounded-xl border border-slate-200 p-4 mb-4">
      <form method="GET" class="flex gap-3 flex-wrap items-end">
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">Pracownik</label>
          <select name="redirect" onchange="this.form.submit()" class="px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <% employees.forEach(e => { %>
            <option value="/reports/employee/<%= e.id %>/<%= month %>" <%= e.id === employee.id ? 'selected' : '' %>><%= e.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-500 mb-1">Miesiąc</label>
          <select name="monthRedirect" onchange="this.form.submit()" class="px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <% monthOptions.forEach(o => { %>
            <option value="/reports/employee/<%= employee.id %>/<%= o.val %>" <%= o.val === month ? 'selected' : '' %>><%= o.label %></option>
            <% }) %>
          </select>
        </div>
      </form>
    </div>

    <!-- ── PRINTABLE DOCUMENT ── -->
    <div id="reportContent" class="bg-white rounded-xl border border-slate-200">

      <!-- Minimal print-only header (hidden on screen) -->
      <div class="print-header-block hidden">
        <div class="print-doc-title">KARTA CZASU PRACY</div>
        <div class="print-doc-meta">
          <span><%= employee.name %></span>
          <span class="print-sep">|</span>
          <span class="capitalize"><%= monthLabel %></span>
          <span class="print-sep">|</span>
          <span>Razem: <%= formatHours(totalHours) %> / <%= workedDays %> dni</span>
        </div>
      </div>

      <!-- Document header (hidden on print) -->
      <div class="doc-header px-8 pt-8 pb-5 border-b-2 border-slate-800 no-print">
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-3">
            <div class="logo-circle">☕</div>
            <div>
              <div class="text-xl font-black text-slate-900 leading-tight">Graficzek</div>
              <div class="text-xs text-slate-500 tracking-wide">Rejestr czasu pracy</div>
            </div>
          </div>
          <div class="text-right">
            <div class="text-xs text-slate-400 uppercase tracking-widest mb-1">Dokument</div>
            <div class="text-base font-bold text-slate-700 uppercase tracking-wider">Karta czasu pracy</div>
            <div class="text-xs text-slate-400 mt-0.5">Nr: KCP/<%= mYear %>/<%= String(mMonth).padStart(2,'0') %>/<%= employee.id %></div>
          </div>
        </div>

        <div class="mt-5 grid grid-cols-3 gap-4">
          <div class="info-box col-span-2">
            <div class="info-label">Pracownik</div>
            <div class="info-value"><%= employee.name %></div>
          </div>
          <div class="info-box">
            <div class="info-label">Okres rozliczeniowy</div>
            <div class="info-value capitalize"><%= monthLabel %></div>
          </div>
        </div>

        <div class="mt-3 grid grid-cols-3 gap-4">
          <div class="stat-box">
            <div class="info-label">Przepracowane godziny</div>
            <div class="text-2xl font-black text-slate-900"><%= formatHours(totalHours) %></div>
          </div>
          <div class="stat-box">
            <div class="info-label">Dni roboczych</div>
            <div class="text-2xl font-black text-slate-900"><%= workedDays %></div>
          </div>
          <div class="stat-box">
            <div class="info-label">Status</div>
            <div class="text-sm font-semibold text-slate-700">Zatwierdzony</div>
          </div>
        </div>
      </div>

      <!-- Day table -->
      <div class="px-8 py-5">
        <table class="w-full text-sm doc-table">
          <thead>
            <tr>
              <th class="text-left w-8">Lp.</th>
              <th class="text-left w-24">Data</th>
              <th class="text-left w-10">Dzień</th>
              <th class="text-center w-20">Od</th>
              <th class="text-center w-20">Do</th>
              <th class="text-right w-16">Godz.</th>
              <!-- Odbicia pracownika — tylko na ekranie, poza dokumentem do podpisu -->
              <th class="no-print text-center w-28 text-emerald-600">Odbite</th>
              <th class="no-print w-24"></th>
              <th class="text-left">Uwagi</th>
            </tr>
          </thead>
          <tbody>
            <% let rowNum = 0; days.forEach(d => { if (d.entry) rowNum++; %>
            <tr class="<%= d.isWeekend ? 'weekend-row' : '' %> <%= d.entry ? '' : 'empty-row' %>">
              <td class="text-slate-400 text-xs"><%= d.entry ? rowNum : '' %></td>
              <td class="text-xs font-medium text-slate-600"><%= d.date %></td>
              <td class="text-xs <%= d.isWeekend ? 'text-slate-400' : 'text-slate-600' %>"><%= d.dayLabel %></td>
              <td class="text-center font-mono">
                <% if (d.entry) { %>
                <span
                  class="time-display no-print cursor-pointer hover:text-blue-600 hover:underline"
                  data-entry-id="<%= d.entry.id %>"
                  data-field="start"
                  onclick="editTime(this)"
                ><%= d.entry.start_time %></span>
                <span class="print-only"><%= d.entry.start_time %></span>
                <input type="time" class="time-input no-print hidden text-xs px-1 py-0.5 border border-blue-400 rounded w-20 text-center" value="<%= d.entry.start_time %>">
                <% } %>
              </td>
              <td class="text-center font-mono">
                <% if (d.entry) { %>
                <span
                  class="time-display no-print cursor-pointer hover:text-blue-600 hover:underline"
                  data-entry-id="<%= d.entry.id %>"
                  data-field="end"
                  onclick="editTime(this)"
                ><%= d.entry.end_time %></span>
                <span class="print-only"><%= d.entry.end_time %></span>
                <input type="time" class="time-input no-print hidden text-xs px-1 py-0.5 border border-blue-400 rounded w-20 text-center" value="<%= d.entry.end_time %>">
                <% } %>
              </td>
              <td class="text-right font-semibold <%= d.hours > 0 ? 'text-slate-800' : 'text-slate-300' %>">
                <span class="hours-cell" data-entry-id="<%= d.entry ? d.entry.id : '' %>">
                  <%= d.hours > 0 ? formatHours(d.hours) : '0' %>
                </span>
              </td>
              <td class="no-print text-center font-mono text-xs <%= d.work.actualStart ? 'text-emerald-700 font-semibold' : 'text-slate-300' %>">
                <%= d.work.actualStart ? d.work.actualStart + '–' + (d.work.actualEnd || '?') : (d.entry ? '—' : '') %>
              </td>
              <td class="no-print text-center">
                <%
                  // Przycisk tylko gdy jest co zaciągnąć i coś to zmieni — inaczej
                  // klik tworzyłby pusty wpis w historii zmian.
                  const pullable = canEdit && d.entry && d.work.actualStart && d.work.actualEnd
                    && (d.work.actualStart !== d.entry.start_time || d.work.actualEnd !== d.entry.end_time);
                %>
                <% if (pullable) { %>
                <button onclick="pullWorkTime(this, <%= d.entry.id %>, '<%= d.work.actualStart %>', '<%= d.work.actualEnd %>')"
                        title="Wpisz odbite godziny (<%= d.work.actualStart %>–<%= d.work.actualEnd %>) do karty"
                        class="text-xs px-2 py-0.5 rounded border border-emerald-300 text-emerald-700 hover:bg-emerald-50 whitespace-nowrap">
                  ⇦ zaciągnij
                </button>
                <% } %>
              </td>
              <td>
                <% if (d.entry) { %>
                <span
                  class="note-display no-print text-xs text-slate-500 cursor-pointer hover:text-blue-600 <%= d.entry.notes ? '' : 'italic text-slate-300' %>"
                  data-entry-id="<%= d.entry.id %>"
                  onclick="editNote(this)"
                  title="Kliknij by edytować"
                ><%= d.entry.notes || 'dodaj uwagę…' %></span>
                <span class="print-only text-xs text-slate-500"><%= d.entry.notes || '' %></span>
                <div class="note-edit hidden no-print flex gap-1 items-center">
                  <input type="text" class="note-input flex-1 text-xs px-2 py-0.5 border border-slate-300 rounded focus:outline-none focus:ring-1 focus:ring-blue-400" value="<%= d.entry.notes || '' %>">
                  <button onclick="saveNote(this)" class="text-xs px-1.5 py-0.5 bg-blue-600 text-white rounded hover:bg-blue-700">✓</button>
                  <button onclick="cancelNote(this)" class="text-xs px-1.5 py-0.5 bg-slate-100 text-slate-600 rounded hover:bg-slate-200">✕</button>
                </div>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
          <tfoot>
            <tr class="total-row">
              <td colspan="4" class="text-right text-xs font-bold text-slate-700 uppercase tracking-wider">Razem</td>
              <td></td>
              <td class="text-right font-black text-slate-900" id="totalHoursCell"><%= formatHours(totalHours) %></td>
              <td class="no-print"></td>
              <td class="no-print"></td>
              <td></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- Signature section -->
      <div class="px-8 pb-8 pt-2 print-sig-section">
        <div class="grid grid-cols-2 gap-16 mt-6">
          <div>
            <div class="text-xs text-slate-400 mb-10">Podpis pracownika</div>
            <div class="border-b border-slate-400"></div>
          </div>
          <div>
            <div class="text-xs text-slate-400 mb-10">Podpis pracodawcy</div>
            <div class="border-b border-slate-400"></div>
          </div>
        </div>
      </div>

    </div><!-- /reportContent -->

    <!-- Historia zmian godzin — poza dokumentem, nigdy na wydruku -->
    <div class="no-print mt-4 bg-white rounded-xl border border-slate-200 p-4">
      <div class="flex items-baseline justify-between gap-3 flex-wrap mb-3">
        <h2 class="text-sm font-bold text-slate-700">Historia zmian godzin</h2>
        <span class="text-xs text-slate-400">Tylko do podglądu — nie drukuje się z kartą</span>
      </div>

      <% if (!changeLog || !changeLog.length) { %>
      <p class="text-xs text-slate-400">Godzin w tym miesiącu nikt nie korygował.</p>
      <% } else { %>
      <table class="w-full text-xs">
        <thead>
          <tr class="border-b border-slate-200 text-slate-400">
            <th class="text-left font-semibold py-1.5 w-32">Kiedy</th>
            <th class="text-left font-semibold py-1.5 w-40">Kto</th>
            <th class="text-left font-semibold py-1.5 w-56">Co</th>
            <th class="text-left font-semibold py-1.5">Szczegóły</th>
          </tr>
        </thead>
        <tbody>
          <% changeLog.forEach(l => { %>
          <tr class="border-b border-slate-50">
            <td class="py-1.5 text-slate-500 font-mono"><%= String(l.created_at).slice(0, 16).replace('T', ' ') %></td>
            <td class="py-1.5 text-slate-700">
              <%= l.user_name %>
              <span class="text-slate-400">(<%= l.user_role === 'super_admin' ? 'Super Admin' : l.user_role === 'admin' ? 'Admin' : l.user_role === 'location_manager' ? 'Kierownik' : 'Pracownik' %>)</span>
            </td>
            <td class="py-1.5 text-slate-600"><%= l.action %></td>
            <td class="py-1.5 text-slate-500 font-mono"><%= l.details %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>

  </div>
</main>

<style>
/* ── Screen styles ── */
.info-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px 12px; }
.info-label { font-size: 10px; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 2px; }
.info-value { font-size: 15px; font-weight: 700; color: #0f172a; }
.stat-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 8px 12px; }
.logo-circle { font-size: 28px; line-height: 1; }

.doc-table { border-collapse: collapse; width: 100%; }
.doc-table thead tr { border-bottom: 2px solid #1e293b; }
.doc-table thead th { padding: 6px 8px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #475569; }
.doc-table tbody tr { border-bottom: 1px solid #f1f5f9; }
.doc-table tbody td { padding: 5px 8px; font-size: 12px; color: #374151; }
.doc-table tfoot .total-row { border-top: 2px solid #1e293b; background: #f8fafc; border-bottom: none; }
.doc-table tfoot td { padding: 8px; font-size: 13px; }
.weekend-row { background: #f8fafc; }
.empty-row td { color: #cbd5e1 !important; }

.print-header-block { display: none; }

/* ── Print ── */
@media print {
  @page { size: A4 portrait; margin: 1cm 1.2cm; }
  * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
  .no-print { display: none !important; }
  .print-only { display: inline !important; }
  body, html { background: white !important; font-family: Arial, sans-serif; }
  main { margin: 0 !important; padding: 0 !important; }

  #reportContent { border: none !important; border-radius: 0 !important; }

  /* Simple print header */
  .print-header-block {
    display: block !important;
    padding-bottom: 5pt;
    margin-bottom: 5pt;
    border-bottom: 1pt solid #000;
  }
  .print-doc-title { font-size: 10pt; font-weight: 700; color: #000; }
  .print-doc-meta { font-size: 8pt; color: #444; margin-top: 2pt; }
  .print-sep { margin: 0 5pt; color: #aaa; }

  .doc-header { display: none !important; }

  /* Strip all container padding */
  #reportContent > div { padding: 0 !important; margin: 0 !important; }

  /* Uniform 8pt table, 1.5pt row padding */
  .doc-table { font-size: 8pt; line-height: 1.2; }
  .doc-table thead th {
    font-size: 7.5pt;
    font-weight: 700;
    padding: 3pt 4pt;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    color: #000;
    white-space: nowrap;
  }
  .doc-table tbody td {
    font-size: 8pt;
    padding: 1.5pt 4pt;
    color: #000;
    white-space: nowrap;
  }
  /* Allow notes column to wrap if needed */
  .doc-table tbody td:last-child { white-space: normal; }
  .doc-table tfoot td { font-size: 8pt; padding: 3pt 4pt; }
  .weekend-row { background: #f5f5f5 !important; }
  .empty-row td { color: #bbb !important; }

  tr { break-inside: avoid; }
  table { page-break-inside: auto; }

  /* Signature — fixed to bottom of page */
  .print-sig-section {
    position: fixed;
    bottom: 1cm;
    left: 1.2cm;
    right: 1.2cm;
    padding: 0 !important;
  }
  .print-sig-section .text-xs { font-size: 7.5pt !important; }
  .print-sig-section .mb-10 { margin-bottom: 18pt !important; }
  .print-sig-section .mt-6 { margin-top: 0 !important; }
}
.print-only { display: none; }
</style>

<script>
document.querySelectorAll('select[name="redirect"], select[name="monthRedirect"]').forEach(sel => {
  sel.addEventListener('change', () => { window.location.href = sel.value; });
});

// ── Note editing ──
function editNote(span) {
  const row = span.closest('td');
  span.classList.add('hidden');
  row.querySelector('.note-edit').classList.remove('hidden');
  row.querySelector('.note-input').focus();
}
function cancelNote(btn) {
  const row = btn.closest('td');
  row.querySelector('.note-edit').classList.add('hidden');
  row.querySelector('.note-display').classList.remove('hidden');
}
async function saveNote(btn) {
  const row = btn.closest('td');
  const span = row.querySelector('.note-display');
  const input = row.querySelector('.note-input');
  const notes = input.value.trim();
  await fetch(`/api/schedule/entry/${span.dataset.entryId}/notes`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ notes }),
  });
  span.textContent = notes || 'dodaj uwagę…';
  span.classList.toggle('italic', !notes);
  span.classList.toggle('text-slate-300', !notes);
  row.querySelector('.note-edit').classList.add('hidden');
  span.classList.remove('hidden');
}

// ── Time editing (admin only) ──
<% if (canEdit) { %>
// Wpisuje odbite godziny do karty. Ten sam endpoint co ręczna edycja, więc
// zmiana trafia do historii na dole strony (ze stanem przed i po).
async function pullWorkTime(btn, entryId, start, end) {
  btn.disabled = true;
  btn.textContent = '…';
  const r = await fetch(`/api/schedule/entry/${entryId}/times`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ start_time: start, end_time: end }),
  });
  if ((await r.json()).ok) {
    window.location.reload();   // przelicza sumę i odświeża historię zmian
  } else {
    alert('Nie udało się zaciągnąć godzin.');
    btn.disabled = false;
    btn.textContent = '⇦ zaciągnij';
  }
}

function editTime(span) {
  const cell = span.closest('td');
  const input = cell.querySelector('.time-input');
  span.classList.add('hidden');
  cell.querySelector('.print-only') && cell.querySelector('.print-only').classList.add('hidden');
  input.classList.remove('hidden');
  input.focus();
  input.addEventListener('blur', () => commitTime(input, span), { once: true });
  input.addEventListener('keydown', e => {
    if (e.key === 'Enter') input.blur();
    if (e.key === 'Escape') { input.classList.add('hidden'); span.classList.remove('hidden'); }
  });
}

async function commitTime(input, span) {
  const newVal = input.value;
  if (!newVal) { input.classList.add('hidden'); span.classList.remove('hidden'); return; }
  const entryId = span.dataset.entryId;
  const field = span.dataset.field;

  // Get sibling cell's current value
  const row = input.closest('tr');
  const startSpan = row.querySelector('[data-field="start"]');
  const endSpan   = row.querySelector('[data-field="end"]');
  const start_time = field === 'start' ? newVal : startSpan.textContent.trim();
  const end_time   = field === 'end'   ? newVal : endSpan.textContent.trim();

  const r = await fetch(`/api/schedule/entry/${entryId}/times`, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ start_time, end_time }),
  });
  if ((await r.json()).ok) {
    span.textContent = newVal;
    // Recalc hours display
    const [sh, sm] = start_time.split(':').map(Number);
    const [eh, em] = end_time.split(':').map(Number);
    let mins = (eh * 60 + em) - (sh * 60 + sm);
    if (mins < 0) mins += 24 * 60;
    const hrs = mins / 60;
    const hoursCell = row.querySelector('.hours-cell');
    if (hoursCell) {
      hoursCell.textContent = hrs > 0 ? (Number.isInteger(hrs) ? hrs + 'h' : hrs.toFixed(1).replace('.', ',') + 'h') : '—';
    }
  }
  input.classList.add('hidden');
  span.classList.remove('hidden');
}
<% } %>
</script>

<%- include('../partials/footer') %>
