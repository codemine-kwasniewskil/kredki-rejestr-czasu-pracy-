<% locals.currentPath = '/reports/employee'; %>
<%- include('../partials/head', { title: 'Raport godzin pracy' }) %>
<%- include('../partials/nav') %>

<main class="md:ml-60 min-h-screen p-4 sm:p-6 pt-20 md:pt-6">
  <div class="max-w-lg mx-auto">
    <h1 class="text-xl font-bold text-slate-800 mb-6">Raport godzin pracy</h1>

    <div class="bg-white rounded-xl border border-slate-200 p-6">
      <form method="GET" action="/reports/employee" class="space-y-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Pracownik</label>
          <select name="userId" required class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="">— wybierz pracownika —</option>
            <% employees.forEach(e => { %>
            <option value="<%= e.id %>"><%= e.name %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Miesiąc</label>
          <select name="month" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <% monthOptions.forEach(o => { %>
            <option value="<%= o.val %>" <%= o.val === month ? 'selected' : '' %>><%= o.label %></option>
            <% }) %>
          </select>
        </div>
        <button type="submit" class="w-full btn btn-primary justify-center py-2.5">Generuj raport →</button>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
