<% locals.currentPath = '/recipes'; %>
<%- include('../partials/head', { title: recipe.name }) %>
<%- include('../partials/nav') %>

<%
  const catMap = {};
  categories.forEach(c => catMap[c.value] = c);
  const c = catMap[recipe.category] || { icon: '🧾', label: recipe.category };
  const ingredients = (recipe.ingredients || '').split('\n').map(l => l.trim()).filter(Boolean);
  const steps = (recipe.steps || '').split('\n').map(l => l.trim()).filter(Boolean);
%>

<div class="md:ml-60 pt-14 md:pt-0 min-h-screen bg-slate-50">
  <div class="max-w-3xl mx-auto px-4 py-6">

    <a href="/recipes" class="inline-flex items-center gap-1 text-sm text-slate-500 hover:text-slate-700 mb-4">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      Przepisy
    </a>

    <% if (success && success.length) { %>
    <div class="mb-4 p-3 bg-green-50 border border-green-200 rounded-lg text-green-800 text-sm"><%= success[0] %></div>
    <% } %>
    <% if (error && error.length) { %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-800 text-sm"><%= error[0] %></div>
    <% } %>

    <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
      <!-- Header -->
      <div class="p-5 border-b border-slate-100 flex items-start gap-4">
        <div class="w-14 h-14 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center text-3xl flex-shrink-0"><%= c.icon %></div>
        <div class="flex-1 min-w-0">
          <h1 class="text-xl font-bold text-slate-800"><%= recipe.name %></h1>
          <div class="flex flex-wrap items-center gap-2 mt-1.5 text-xs">
            <span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600"><%= c.icon %> <%= c.label %></span>
            <% if (recipe.glass) { %><span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">🥛 <%= recipe.glass %></span><% } %>
            <% if (recipe.prep_time_min) { %><span class="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600">⏱ <%= recipe.prep_time_min %> min</span><% } %>
            <% if (!recipe.active) { %><span class="px-2 py-0.5 rounded-full bg-amber-100 text-amber-700">Nieaktywny</span><% } %>
          </div>
        </div>
        <% if (canEdit) { %>
        <div class="flex gap-2 flex-shrink-0">
          <a href="/recipes/<%= recipe.id %>/edit" class="inline-flex items-center gap-1 px-3 py-1.5 text-sm bg-white border border-slate-200 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
            Edytuj
          </a>
        </div>
        <% } %>
      </div>

      <div class="p-5 grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Ingredients -->
        <div>
          <h2 class="font-semibold text-slate-700 mb-3 flex items-center gap-2"><span>🧾</span> Składniki</h2>
          <% if (ingredients.length === 0) { %>
            <p class="text-slate-400 text-sm">Brak składników.</p>
          <% } else { %>
          <ul class="space-y-1.5">
            <% ingredients.forEach(i => { %>
            <li class="flex items-start gap-2 text-sm text-slate-700">
              <span class="text-slate-300 mt-1.5 w-1.5 h-1.5 rounded-full bg-blue-400 flex-shrink-0"></span>
              <span><%= i %></span>
            </li>
            <% }) %>
          </ul>
          <% } %>
        </div>

        <!-- Steps -->
        <div>
          <h2 class="font-semibold text-slate-700 mb-3 flex items-center gap-2"><span>👩‍🍳</span> Przygotowanie</h2>
          <% if (steps.length === 0) { %>
            <p class="text-slate-400 text-sm">Brak opisu przygotowania.</p>
          <% } else { %>
          <ol class="space-y-2">
            <% steps.forEach((s, i) => { %>
            <li class="flex items-start gap-2.5 text-sm text-slate-700">
              <span class="flex-shrink-0 w-5 h-5 rounded-full bg-blue-100 text-blue-700 text-xs font-bold flex items-center justify-center mt-0.5"><%= i + 1 %></span>
              <span><%= s %></span>
            </li>
            <% }) %>
          </ol>
          <% } %>
        </div>
      </div>

      <% if (recipe.notes) { %>
      <div class="px-5 pb-5">
        <div class="bg-amber-50 border border-amber-100 rounded-lg p-3">
          <div class="text-xs font-semibold text-amber-700 mb-1">Uwagi</div>
          <p class="text-sm text-slate-700 whitespace-pre-line"><%= recipe.notes %></p>
        </div>
      </div>
      <% } %>

      <% if (canEdit) { %>
      <div class="px-5 py-3 border-t border-slate-100 flex items-center justify-between">
        <span class="text-xs text-slate-400">
          <% if (recipe.created_by_name) { %>Dodał: <%= recipe.created_by_name %><% } %>
        </span>
        <form method="POST" action="/recipes/<%= recipe.id %>?_method=DELETE"
          onsubmit="return confirm('Na pewno usunąć ten przepis?')">
          <button type="submit" class="text-sm text-red-600 hover:text-red-700 hover:underline">Usuń przepis</button>
        </form>
      </div>
      <% } %>
    </div>

  </div>
</div>
<%- include('../partials/footer') %>
