<% locals.currentPath = '/recipes'; %>
<%- include('../partials/head', { title: 'Przepisy' }) %>
<%- include('../partials/nav') %>

<%
  const catMap = {};
  categories.forEach(c => catMap[c.value] = c);
  function previewIngredients(txt) {
    if (!txt) return '';
    const lines = txt.split('\n').map(l => l.trim()).filter(Boolean);
    return lines.slice(0, 3).join(' · ') + (lines.length > 3 ? ' …' : '');
  }
%>

<div class="md:ml-60 pt-14 md:pt-0 min-h-screen bg-slate-50">
  <div class="max-w-5xl mx-auto px-4 py-6">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-5">
      <div>
        <h1 class="text-xl font-bold text-slate-800">Przepisy</h1>
        <p class="text-sm text-slate-500 mt-0.5">Receptury napojów i produktów kawiarni</p>
      </div>
      <% if (canEdit) { %>
      <a href="/recipes/new" class="inline-flex items-center gap-1.5 px-3 py-2 text-sm bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-medium">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Dodaj przepis
      </a>
      <% } %>
    </div>

    <!-- Flash -->
    <% if (success && success.length) { %>
    <div class="mb-4 p-3 bg-green-50 border border-green-200 rounded-lg text-green-800 text-sm"><%= success[0] %></div>
    <% } %>
    <% if (error && error.length) { %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-800 text-sm"><%= error[0] %></div>
    <% } %>

    <!-- Search -->
    <form method="GET" action="/recipes" class="mb-4">
      <% if (cat) { %><input type="hidden" name="cat" value="<%= cat %>"><% } %>
      <div class="relative">
        <svg class="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
        <input type="text" name="q" value="<%= q %>" placeholder="Szukaj przepisu po nazwie…"
          class="w-full border border-slate-200 rounded-lg pl-9 pr-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-200">
      </div>
    </form>

    <!-- Category filter chips -->
    <div class="flex flex-wrap gap-2 mb-5">
      <a href="/recipes<%= q ? '?q=' + encodeURIComponent(q) : '' %>"
        class="px-3 py-1.5 rounded-full text-sm border transition-colors <%= cat === '' ? 'bg-slate-800 text-white border-slate-800' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
        Wszystkie <span class="opacity-60">(<%= total %>)</span>
      </a>
      <% categories.forEach(c => { %>
        <% const cc = counts[c.value] || 0; %>
        <a href="/recipes?cat=<%= c.value %><%= q ? '&q=' + encodeURIComponent(q) : '' %>"
          class="px-3 py-1.5 rounded-full text-sm border transition-colors <%= cat === c.value ? 'bg-slate-800 text-white border-slate-800' : 'bg-white text-slate-600 border-slate-200 hover:bg-slate-50' %>">
          <%= c.icon %> <%= c.label %> <span class="opacity-60">(<%= cc %>)</span>
        </a>
      <% }) %>
    </div>

    <!-- List -->
    <% if (recipes.length === 0) { %>
      <div class="bg-white border border-slate-200 rounded-xl p-10 text-center">
        <div class="text-4xl mb-2">🍽️</div>
        <p class="text-slate-500 text-sm">Brak przepisów<%= (q || cat) ? ' dla wybranych filtrów' : '' %>.</p>
        <% if (canEdit && !q && !cat) { %>
          <a href="/recipes/new" class="text-blue-600 hover:underline text-sm mt-2 inline-block">Dodaj pierwszy przepis →</a>
        <% } %>
      </div>
    <% } else { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        <% recipes.forEach(r => { const c = catMap[r.category] || { icon: '🧾', label: r.category }; %>
        <a href="/recipes/<%= r.id %>" class="group bg-white border border-slate-200 rounded-xl p-4 hover:border-blue-300 hover:shadow-sm transition-all flex flex-col">
          <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-lg bg-slate-50 border border-slate-100 flex items-center justify-center text-xl flex-shrink-0"><%= c.icon %></div>
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-2">
                <div class="font-semibold text-slate-800 truncate group-hover:text-blue-700"><%= r.name %></div>
                <% if (r.price != null) { %><span class="text-sm font-bold text-emerald-600 whitespace-nowrap"><%= parseFloat(r.price).toFixed(2).replace(/\.00$/,'') %> zł</span><% } %>
              </div>
              <div class="text-xs text-slate-400 mt-0.5"><%= c.label %><% if (!r.active) { %> · <span class="text-amber-600">nieaktywny</span><% } %></div>
            </div>
          </div>
          <% if (r.ingredients) { %>
            <p class="text-xs text-slate-500 mt-3 line-clamp-2"><%= previewIngredients(r.ingredients) %></p>
          <% } %>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mt-3 pt-3 border-t border-slate-50 text-xs text-slate-400">
            <% if (r.temperature_c) { %><span class="inline-flex items-center gap-1">🌡 <%= r.temperature_c %>°C</span><% } %>
            <% if (r.dose) { %><span class="inline-flex items-center gap-1">⚖ <%= r.dose %></span><% } %>
            <% if (r.glass) { %><span class="inline-flex items-center gap-1">🥛 <%= r.glass %></span><% } %>
            <% if (r.prep_time_min) { %><span class="inline-flex items-center gap-1">⏱ <%= r.prep_time_min %> min</span><% } %>
          </div>
        </a>
        <% }) %>
      </div>
    <% } %>

  </div>
</div>
<%- include('../partials/footer') %>
