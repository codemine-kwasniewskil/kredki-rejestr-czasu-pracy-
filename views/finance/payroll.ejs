<%- include('../partials/head', { title: title }) %>
<div class="flex h-screen overflow-hidden">
  <%- include('../partials/nav', { currentPath: currentPath }) %>

  <main class="flex-1 md:ml-60 overflow-y-auto">
    <div class="pt-14 md:pt-0">
      <div class="px-4 md:px-8 py-6 max-w-6xl mx-auto">

        <!-- Header -->
        <div class="mb-6 flex items-center justify-between">
          <div>
            <h1 class="text-2xl font-bold text-slate-800">Koszty pracownicze</h1>
            <p class="text-sm text-slate-500 mt-1">Lista płac — dane z raportów księgowej (360 Kadry i płace)</p>
          </div>
          <div class="flex gap-2">
            <a href="/finance/monthly" class="btn btn-secondary text-sm">Raport miesięczny</a>
            <a href="/finance/import" class="btn btn-primary text-sm">Import wyciągu</a>
          </div>
        </div>

        <% if (!payrollMonths.length) { %>
        <!-- Empty state -->
        <div class="bg-white rounded-xl border border-dashed border-slate-300 p-12 text-center">
          <div class="text-4xl mb-4">📄</div>
          <p class="text-slate-500 text-base mb-2 font-medium">Brak danych listy płac</p>
          <p class="text-slate-400 text-sm mb-5">Uruchom seed, aby załadować dane z raportów księgowej:</p>
          <code class="bg-slate-100 px-3 py-2 rounded text-slate-600 text-sm block max-w-xs mx-auto">
            node database/payroll_seed.js
          </code>
        </div>

        <% } else { %>

        <!-- Summary stats -->
        <%
          const allMonthTotals = payrollMonths.map(mk => byMonth[mk].totals);
          const grandCost = allMonthTotals.reduce((s, t) => s + t.cost, 0);
          const grandPaid = allMonthTotals.reduce((s, t) => s + t.paid, 0);
          const grandZusFirm = allMonthTotals.reduce((s, t) => s + t.zus_firm, 0);
        %>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
            <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Okresy</div>
            <div class="text-2xl font-bold text-slate-800"><%= payrollMonths.length %></div>
            <div class="text-xs text-slate-400 mt-1">miesięcy w bazie</div>
          </div>
          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
            <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">Do wypłaty (łącznie)</div>
            <div class="text-xl font-bold text-slate-700"><%= fmt(grandPaid) %></div>
            <div class="text-xs text-slate-400 mt-1">netto wypłacone pracownikom</div>
          </div>
          <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-4">
            <div class="text-xs text-slate-500 uppercase tracking-wide mb-1">ZUS firma (łącznie)</div>
            <div class="text-xl font-bold text-orange-600"><%= fmt(grandZusFirm) %></div>
            <div class="text-xs text-slate-400 mt-1">składki pracodawcy</div>
          </div>
          <div class="bg-red-50 rounded-xl border border-red-200 shadow-sm p-4">
            <div class="text-xs text-red-700 uppercase tracking-wide mb-1 font-medium">Koszt pracodawcy (łącznie)</div>
            <div class="text-xl font-bold text-red-800"><%= fmt(grandCost) %></div>
            <div class="text-xs text-slate-500 mt-1">za <%= payrollMonths.length %> mies.</div>
          </div>
        </div>

        <!-- Per-month tables -->
        <% payrollMonths.forEach(mk => { %>
        <%
          const { rows, totals } = byMonth[mk];
          const payDate = rows[0] && rows[0].payment_date ? rows[0].payment_date : null;
          const bankMk = (() => {
            // bank payments for this work period appear in next month
            const [y, m] = mk.split('-').map(Number);
            const nm = m === 12 ? 1 : m + 1;
            const ny = m === 12 ? y + 1 : y;
            return ny + '-' + String(nm).padStart(2, '0');
          })();
          const bankForMonth = bankByMonth[bankMk] || [];
          const bankTotal = bankForMonth.reduce((s, p) => s + Math.abs(p.amount), 0);
        %>
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm mb-5">
          <!-- Month header -->
          <div class="px-5 py-4 border-b border-slate-100 flex flex-wrap items-center justify-between gap-3">
            <div>
              <h2 class="text-base font-bold text-slate-800"><%= monthLabel(mk) %></h2>
              <div class="text-xs text-slate-400 mt-0.5">
                <%= rows.length %> pracowników
                <% if (payDate) { %> · Data wypłaty: <strong class="text-slate-600"><%= payDate %></strong><% } %>
              </div>
            </div>
            <div class="flex items-center gap-4">
              <% if (bankTotal > 0) { %>
              <div class="text-right">
                <div class="text-xs text-slate-400">Przelew bank (<%= bankMk %>)</div>
                <div class="text-sm font-semibold text-slate-600"><%= fmt(bankTotal) %> PLN</div>
              </div>
              <% } %>
              <div class="text-right">
                <div class="text-xs text-slate-400">ZUS firma</div>
                <div class="text-sm font-semibold text-orange-600"><%= fmt(totals.zus_firm) %> PLN</div>
              </div>
              <div class="text-right">
                <div class="text-xs font-semibold text-red-700 uppercase tracking-wide">Koszt pracodawcy</div>
                <div class="text-lg font-bold text-red-800"><%= fmt(totals.cost) %> PLN</div>
              </div>
            </div>
          </div>

          <!-- Employees table -->
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="text-left text-slate-400 border-b border-slate-100 text-xs">
                  <th class="px-5 py-2 font-medium">Pracownik</th>
                  <th class="px-3 py-2 font-medium text-right">Przychód</th>
                  <th class="px-3 py-2 font-medium text-right">ZUS prac.</th>
                  <th class="px-3 py-2 font-medium text-right">NFZ</th>
                  <th class="px-3 py-2 font-medium text-right">PIT</th>
                  <th class="px-3 py-2 font-medium text-right">Do wypłaty</th>
                  <th class="px-3 py-2 font-medium text-right">ZUS firma</th>
                  <th class="px-5 py-2 font-medium text-right text-red-600">Koszt pracodawcy</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-50">
                <% rows.forEach(r => { %>
                <tr class="hover:bg-slate-50">
                  <td class="px-5 py-2.5 font-medium text-slate-700"><%= r.employee_name || r.employee_name_raw %></td>
                  <td class="px-3 py-2.5 text-right text-slate-600 whitespace-nowrap"><%= fmt(r.gross_amount) %></td>
                  <td class="px-3 py-2.5 text-right whitespace-nowrap <%= Number(r.zus_employee) > 0 ? 'text-orange-600' : 'text-slate-300' %>">
                    <%= Number(r.zus_employee) > 0 ? fmt(r.zus_employee) : '—' %>
                  </td>
                  <td class="px-3 py-2.5 text-right whitespace-nowrap <%= Number(r.nfz_amount) > 0 ? 'text-orange-600' : 'text-slate-300' %>">
                    <%= Number(r.nfz_amount) > 0 ? fmt(r.nfz_amount) : '—' %>
                  </td>
                  <td class="px-3 py-2.5 text-right whitespace-nowrap <%= Number(r.pit_amount) > 0 ? 'text-orange-600' : 'text-slate-300' %>">
                    <%= Number(r.pit_amount) > 0 ? fmt(r.pit_amount) : '—' %>
                  </td>
                  <td class="px-3 py-2.5 text-right font-semibold text-slate-700 whitespace-nowrap"><%= fmt(r.paid_amount) %></td>
                  <td class="px-3 py-2.5 text-right whitespace-nowrap <%= Number(r.zus_employer) > 0 ? 'text-orange-600 font-medium' : 'text-slate-300' %>">
                    <%= Number(r.zus_employer) > 0 ? fmt(r.zus_employer) : '—' %>
                  </td>
                  <td class="px-5 py-2.5 text-right font-bold text-red-700 whitespace-nowrap"><%= fmt(r.employer_cost) %></td>
                </tr>
                <% }) %>
                <!-- Totals row -->
                <tr class="bg-slate-50 border-t border-slate-200 font-semibold text-sm">
                  <td class="px-5 py-2.5 text-slate-700">Razem (<%= rows.length %> os.)</td>
                  <td class="px-3 py-2.5 text-right text-slate-700 whitespace-nowrap"><%= fmt(totals.gross) %></td>
                  <td class="px-3 py-2.5 text-right text-orange-700 whitespace-nowrap"><%= totals.zus_emp > 0 ? fmt(totals.zus_emp) : '—' %></td>
                  <td class="px-3 py-2.5 text-right text-orange-700 whitespace-nowrap"><%= totals.nfz > 0 ? fmt(totals.nfz) : '—' %></td>
                  <td class="px-3 py-2.5 text-right text-orange-700 whitespace-nowrap"><%= totals.pit > 0 ? fmt(totals.pit) : '—' %></td>
                  <td class="px-3 py-2.5 text-right text-slate-700 whitespace-nowrap"><%= fmt(totals.paid) %></td>
                  <td class="px-3 py-2.5 text-right text-orange-700 whitespace-nowrap"><%= totals.zus_firm > 0 ? fmt(totals.zus_firm) : '—' %></td>
                  <td class="px-5 py-2.5 text-right text-red-800 whitespace-nowrap"><%= fmt(totals.cost) %></td>
                </tr>
              </tbody>
            </table>
          </div>

          <!-- Bank reconciliation footer -->
          <% if (bankForMonth.length > 0) { %>
          <div class="px-5 py-3 border-t border-slate-100 bg-slate-50 rounded-b-xl">
            <div class="text-xs text-slate-500 mb-1.5 font-medium">Przelewy bankowe (<%= bankMk %>):</div>
            <div class="flex flex-wrap gap-x-4 gap-y-1">
              <% bankForMonth.forEach(p => { %>
              <span class="text-xs text-slate-600">
                <span class="font-medium"><%= p.counterparty_name || '?' %></span>
                <span class="text-slate-400 ml-1"><%= fmt(Math.abs(p.amount)) %> PLN</span>
                <span class="text-slate-300 ml-1">(<%= p.booking_date %>)</span>
              </span>
              <% }) %>
            </div>
            <%
              const diff = totals.paid - bankTotal;
            %>
            <% if (Math.abs(diff) > 0.05) { %>
            <div class="mt-2 text-xs text-amber-600 font-medium">
              Różnica lista płac vs bank: <%= fmt(diff) %> PLN
              <span class="text-slate-400 font-normal ml-1">(może wynikać z wypłat gotówkowych lub zaliczek)</span>
            </div>
            <% } else { %>
            <div class="mt-2 text-xs text-green-600 font-medium">✓ Zgodność z bankiem</div>
            <% } %>
          </div>
          <% } %>
        </div>
        <% }) %>

        <!-- Source note -->
        <div class="text-xs text-slate-400 text-center mt-4">
          Źródło: Lista płac wygenerowana przez 360 Kadry i płace · Agata Grabias-Kwaśniewska · NIP 5361813052
        </div>

        <% } %>

      </div>
    </div>
  </main>
</div>
</body></html>
