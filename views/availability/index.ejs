<% locals.currentPath = '/availability'; %>
<%- include('../partials/head', { title: 'Dostępność' }) %>
<%- include('../partials/nav') %>

<main class="md:ml-60 min-h-screen pt-14 md:pt-0">
<%
const MONTHS_PL = ['styczeń','luty','marzec','kwiecień','maj','czerwiec','lipiec','sierpień','wrzesień','październik','listopad','grudzień'];
let lockFirstEditableLabel = '';
let lockLastLockedLabel = '';
const _todayMonthStr = todayStr.substring(0, 7) + '-01';
const lockIsForFutureMonths = !!(lockBeforeStr && lockBeforeStr > _todayMonthStr);
if (lockBeforeStr && lockIsForFutureMonths) {
  const [_lby, _lbm] = lockBeforeStr.split('-').map(Number);
  lockFirstEditableLabel = MONTHS_PL[_lbm - 1] + ' ' + _lby;
  const _lli = ((_lbm - 2) + 12) % 12;
  lockLastLockedLabel = MONTHS_PL[_lli] + ' ' + (_lbm === 1 ? _lby - 1 : _lby);
}
%>
  <div class="max-w-4xl mx-auto">

    <!-- Sticky header -->
    <div class="sticky top-14 md:top-0 z-10 bg-slate-50 px-6 pt-4 pb-3 shadow-[0_2px_8px_-2px_rgba(0,0,0,0.08)]">
    <div class="mb-3 flex items-center justify-between flex-wrap gap-3">
      <div>
        <h1 class="text-xl font-bold text-slate-800">Dostępność</h1>
        <% if (user.role !== 'worker') { %>
          <% if (targetUserLocked) { %>
            <p class="text-xs text-amber-600 mt-0.5 font-medium">🔒 Dostępność tego pracownika jest zablokowana przez administratora. Użyj przycisku <strong>Odblokuj wszystkich</strong> lub zmień w <a href="/users" class="underline">Użytkownicy</a>.</p>
          <% } else if (lockFirstEditableLabel) { %>
            <p class="text-xs text-slate-500 mt-0.5">Edytuj dostępność pracownika. Edytowalna od: <strong class="text-slate-700"><%= lockFirstEditableLabel %></strong>.</p>
          <% } else { %>
            <p class="text-xs text-slate-500 mt-0.5">Edytuj dostępność pracownika.</p>
          <% } %>
        <% } else { %>
          <% if (lockFirstEditableLabel) { %>
            <p class="text-xs text-slate-500 mt-0.5">Edytujesz swoją dostępność od: <strong class="text-blue-600"><%= lockFirstEditableLabel %></strong>.</p>
          <% } else { %>
            <p class="text-xs text-slate-500 mt-0.5">Edytuj swoją dostępność na przyszłe miesiące.</p>
          <% } %>
        <% } %>
      </div>

      <div class="flex items-center gap-2 flex-wrap">
        <% if (user.role !== 'worker' && allUsers.length > 0) { %>
        <form method="GET" action="/availability" class="flex items-center gap-2">
          <label class="text-sm text-slate-600 font-medium">Pracownik:</label>
          <select name="userId" onchange="this.form.submit()" class="px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
            <% allUsers.forEach(u => { %>
            <option value="<%= u.id %>" <%= u.id === targetUserId ? 'selected' : '' %>><%= u.name %></option>
            <% }) %>
          </select>
        </form>
        <button
          id="userLockBtn"
          onclick="toggleUserLock(<%= targetUserId %>, <%= targetUserLocked ? 'false' : 'true' %>)"
          class="px-3 py-2 text-xs font-medium rounded-lg border transition-colors <%= targetUserLocked ? 'bg-emerald-50 border-emerald-300 text-emerald-700 hover:bg-emerald-100' : 'bg-amber-50 border-amber-300 text-amber-700 hover:bg-amber-100' %>"
          title="<%= targetUserLocked ? 'Odblokuj dostępność dla tego pracownika' : 'Zablokuj dostępność dla tego pracownika' %>"
        ><%= targetUserLocked ? '🔓 Odblokuj' : '🔒 Zablokuj' %></button>
        <% } %>
        <% if (user.role === 'admin' || user.role === 'location_manager') { %>
          <button onclick="openMonthLockModal()" class="px-3 py-2 text-xs font-medium rounded-lg border transition-colors bg-amber-50 border-amber-300 text-amber-700 hover:bg-amber-100">📅 Blokuj / odblokuj miesiąc</button>
          <button onclick="resetToStandard()" class="px-3 py-2 text-xs font-medium rounded-lg border transition-colors bg-slate-100 border-slate-200 text-slate-600 hover:bg-slate-200" title="Usuwa wszystkie ręczne blokady miesięcy. Standard: po 10. każdego miesiąca kolejny miesiąc jest automatycznie blokowany.">↩ Standard</button>
        <% } %>
      </div>
    </div>

    <div class="flex items-center flex-wrap gap-4 p-3 bg-white rounded-xl border border-slate-200 text-xs">
      <div class="flex items-center gap-1.5">
        <span class="w-4 h-4 rounded bg-emerald-100 border-2 border-emerald-400 flex items-center justify-center text-emerald-700 text-[10px]">✓</span>
        <span class="text-slate-600">Dostępny/a</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-4 h-4 rounded bg-red-100 border-2 border-red-400 flex items-center justify-center text-red-700 text-[10px]">✕</span>
        <span class="text-slate-600">Niedostępny/a</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="w-4 h-4 rounded bg-white border-2 border-slate-300"></span>
        <span class="text-slate-600">Brak info</span>
      </div>
      <% if (lockLastLockedLabel) { %>
      <div class="flex items-center gap-1.5">
        <span class="w-4 h-4 rounded bg-slate-100 border border-slate-300"></span>
        <span class="text-slate-400">🔒 Zablokowane (do końca <%= lockLastLockedLabel %>)</span>
      </div>
      <% } %>
      <button onclick="document.getElementById('helpModal').classList.remove('hidden')" class="ml-auto flex items-center gap-1 text-slate-400 hover:text-blue-600 transition-colors text-[11px] font-medium">
        <span class="w-4 h-4 rounded-full bg-slate-100 hover:bg-blue-100 flex items-center justify-center text-[9px] font-bold leading-none">?</span>
        Jak to działa?
      </button>
    </div>
    </div><!-- end sticky header -->

    <div class="space-y-2 px-6 pb-6 pt-4">
      <% const dayNames = ['Pon', 'Wt', 'Śr', 'Czw', 'Pt', 'Sob', 'Nd']; %>
      <% let lastMonthKey = null; %>
      <% weeks.forEach((weekDays, wi) => {
        const firstDay = weekDays[0];
        const monthKey = firstDay.getMonth() + '-' + firstDay.getFullYear();
        const monthLabel = MONTHS_PL[firstDay.getMonth()] + ' ' + firstDay.getFullYear();
        const monthStr = `${firstDay.getFullYear()}-${String(firstDay.getMonth()+1).padStart(2,'0')}-01`;
        const monthLocked = lockBeforeStr && monthStr < lockBeforeStr && !unlockedMonths.has(monthStr.substring(0, 7));
        const weekStartStr = `${firstDay.getFullYear()}-${String(firstDay.getMonth()+1).padStart(2,'0')}-${String(firstDay.getDate()).padStart(2,'0')}`;
        const isCurrentWeek = weekStartStr === currentWeekStart;
        const isEntireWeekPast = weekDays.every(d => {
          const ds = `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
          return ds < todayStr;
        });
      %>
        <% if (monthKey !== lastMonthKey) { lastMonthKey = monthKey;
          const monthYearMonth = `${firstDay.getFullYear()}-${String(firstDay.getMonth()+1).padStart(2,'0')}`;
          const isMonthAdminLocked = lockedMonths.has(monthYearMonth);
          const isMonthAdminUnlocked = unlockedMonths.has(monthYearMonth);
          const isMonthAutoLocked = !isMonthAdminUnlocked && autoLockedMonths.has(monthYearMonth);
          // Workers cannot edit if admin-locked or auto-locked; admins can always edit
          const canSetMonth = user.role === 'worker'
            ? (!monthLocked && !isMonthAdminLocked && !isMonthAutoLocked)
            : true;
        %>
        <div class="<%= wi > 0 ? 'mt-5' : '' %> mb-1.5 flex items-center gap-3 flex-wrap">
          <h2 class="text-sm font-semibold <%= isEntireWeekPast && !isCurrentWeek ? 'text-slate-400' : (monthLocked || isMonthAdminLocked || (user.role==='worker' && isMonthAutoLocked)) ? 'text-slate-400' : 'text-slate-600' %> uppercase tracking-wide flex items-center gap-1.5">
            <%= monthLabel %>
            <% if (monthLocked) { %><span class="text-xs normal-case font-normal text-slate-400">⏰ termin minął</span>
            <% } else if (isMonthAdminLocked) { %><span class="text-xs normal-case font-normal text-amber-500">🔒 zablokowany</span>
            <% } else if (isMonthAutoLocked) { %><span class="text-xs normal-case font-normal text-orange-400">⏰ standard</span>
            <% } else if (isMonthAdminUnlocked) { %><span class="text-xs normal-case font-normal text-emerald-500">🔓 odblokowany (admin)</span><% } %>
          </h2>
          <div class="flex items-center gap-1 flex-wrap">
            <button
              onclick="setMonthAvailability('<%= monthYearMonth %>', 'available', event)"
              class="px-2 py-0.5 text-[10px] font-medium rounded border transition-colors <%= canSetMonth ? 'bg-emerald-50 border-emerald-300 text-emerald-700 hover:bg-emerald-100 cursor-pointer' : 'bg-slate-50 border-slate-200 text-slate-300 cursor-not-allowed' %>"
              title="<%= canSetMonth ? 'Ustaw cały miesiąc jako dostępny' : 'Miesiąc zablokowany' %>"
              <%= canSetMonth ? '' : 'disabled' %>
            >✓ Cały miesiąc</button>
            <button
              onclick="setMonthAvailability('<%= monthYearMonth %>', 'unavailable', event)"
              class="px-2 py-0.5 text-[10px] font-medium rounded border transition-colors <%= canSetMonth ? 'bg-red-50 border-red-300 text-red-700 hover:bg-red-100 cursor-pointer' : 'bg-slate-50 border-slate-200 text-slate-300 cursor-not-allowed' %>"
              title="<%= canSetMonth ? 'Ustaw cały miesiąc jako niedostępny' : 'Miesiąc zablokowany' %>"
              <%= canSetMonth ? '' : 'disabled' %>
            >✕ Cały miesiąc</button>
            <% if (user.role !== 'worker') { %>
            <% const isEffectivelyLocked = isMonthAdminLocked || isMonthAutoLocked; %>
            <button
              onclick="toggleMonthLock('<%= monthYearMonth %>', <%= isEffectivelyLocked ? 'false' : 'true' %>, event)"
              class="px-2 py-0.5 text-[10px] font-medium rounded border transition-colors <%= isEffectivelyLocked ? 'bg-amber-100 border-amber-300 text-amber-700 hover:bg-amber-200' : 'bg-slate-100 border-slate-200 text-slate-500 hover:bg-slate-200' %>"
              title="<%= isEffectivelyLocked ? 'Odblokuj ten miesiąc dla pracownika' : 'Zablokuj ten miesiąc dla pracownika' %>"
            ><%= isEffectivelyLocked ? '🔓 Odblokuj miesiąc' : '🔒 Zablokuj miesiąc' %></button>
            <% } %>
          </div>
          <div class="flex-1 h-px bg-slate-200"></div>
        </div>
        <% } %>

      <div id="<%= isCurrentWeek ? 'current-week' : '' %>" class="bg-white rounded-xl border border-slate-200 overflow-hidden <%= isEntireWeekPast ? 'opacity-60' : '' %>">
        <div class="px-3 py-1.5 bg-slate-50 border-b border-slate-200">
          <span class="text-xs text-slate-500">
            <%= weekDays[0].getDate() %>.<%= String(weekDays[0].getMonth()+1).padStart(2,'0') %> –
            <%= weekDays[6].getDate() %>.<%= String(weekDays[6].getMonth()+1).padStart(2,'0') %>.<%= weekDays[6].getFullYear() %>
          </span>
        </div>
        <div class="grid grid-cols-7">
          <% weekDays.forEach((day, di) => {
            const dateStr = `${day.getFullYear()}-${String(day.getMonth()+1).padStart(2,'0')}-${String(day.getDate()).padStart(2,'0')}`;
            const avail = availMap[dateStr] || null;
            const status = avail ? avail.status : null;
            const startTime = avail ? avail.startTime : null;
            const endTime = avail ? avail.endTime : null;
            const isPast = dateStr < todayStr;
            const dayYM = dateStr.substring(0, 7);
            const isMonthAdminLockedDay = lockedMonths.has(dayYM);
            const isMonthAutoLockedDay = !unlockedMonths.has(dayYM) && autoLockedMonths.has(dayYM);
            const isAdminUnlocked = unlockedMonths.has(dayYM);
            const isLocked = (isPast && !isAdminUnlocked)
              || !!(lockBeforeStr && dateStr < lockBeforeStr && !isAdminUnlocked)
              || (user.role === 'worker' && isMonthAdminLockedDay)
              || (user.role === 'worker' && isMonthAutoLockedDay);
            const canEdit = !isLocked;
            const isToday = dateStr === todayStr;
          %>
          <div
            class="relative group/day <%= canEdit ? 'cursor-pointer hover:brightness-95' : (!isPast ? 'opacity-50 cursor-not-allowed' : 'cursor-default') %> transition-all p-1 flex flex-col items-center justify-between border-r border-slate-100 last:border-0 min-h-16 select-none availability-day
              <%= status === 'available' ? 'bg-emerald-50' : status === 'unavailable' ? 'bg-red-50' : 'bg-white' %>
              <%= isToday ? 'ring-2 ring-blue-400 ring-inset' : '' %>"
            data-date="<%= dateStr %>"
            data-status="<%= status || '' %>"
            data-start-time="<%= startTime || '' %>"
            data-end-time="<%= endTime || '' %>"
            onclick="<%= canEdit ? `toggleAvailability('${dateStr}', this)` : '' %>"
          >
            <div class="text-[9px] font-semibold text-slate-400 uppercase"><%= dayNames[di] %></div>
            <div class="text-sm font-bold <%= isToday ? 'text-blue-700' : 'text-slate-700' %>"><%= day.getDate() %></div>
            <div class="w-5 h-5 rounded-md flex items-center justify-center text-[10px] font-bold
              <%= status === 'available' ? 'bg-emerald-200 text-emerald-700 border-2 border-emerald-400' : status === 'unavailable' ? 'bg-red-200 text-red-700 border-2 border-red-400' : 'bg-slate-100 text-transparent border-2 border-slate-200' %>">
              <%= status === 'available' ? '✓' : status === 'unavailable' ? '✕' : '·' %>
            </div>
            <div class="time-range text-[8px] leading-tight text-center w-full min-h-[12px] <%= startTime && endTime ? 'text-emerald-700 font-semibold' : 'text-transparent' %>">
              <%= startTime && endTime ? startTime + '–' + endTime : '·' %>
            </div>
            <% if (canEdit && status === 'available') { %>
              <button
                class="tp-btn text-[10px] text-slate-400 hover:text-blue-600 leading-none transition-colors"
                title="Ustaw godziny"
                onclick="openTimePicker('<%= dateStr %>', '<%= startTime || '' %>', '<%= endTime || '' %>', event)"
              >⏱</button>
            <% } else { %>
              <div class="h-[14px]"></div>
            <% } %>
          </div>
          <% }) %>
        </div>
      </div>
      <% }) %>
    </div>
  </div>
</main>

<!-- Help Modal -->
<div id="helpModal" class="hidden fixed inset-0 bg-black/40 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm max-h-[90vh] overflow-y-auto">
    <div class="flex items-center justify-between p-5 border-b border-slate-200 sticky top-0 bg-white rounded-t-2xl">
      <h3 class="font-semibold text-slate-800 text-sm">Jak działa dostępność?</h3>
      <button onclick="document.getElementById('helpModal').classList.add('hidden')" class="text-slate-400 hover:text-slate-600 text-xl leading-none">✕</button>
    </div>
    <div class="p-5 space-y-4 text-xs text-slate-600">

      <!-- Edycja dnia -->
      <div>
        <p class="font-semibold text-slate-700 mb-1.5">📅 Edycja dnia</p>
        <ul class="space-y-1 pl-1">
          <li class="flex gap-2"><span class="shrink-0">🖱️</span><span>Kliknij dzień, by przełączyć: <strong>brak → ✓ dostępny → ✕ niedostępny → brak</strong></span></li>
          <li class="flex gap-2"><span class="shrink-0">⏱</span><span>Kliknij zegarek przy dostępnym dniu, by ustawić godziny pracy</span></li>
        </ul>
      </div>

      <!-- Miesiąc -->
      <div>
        <p class="font-semibold text-slate-700 mb-1.5">📆 Cały miesiąc</p>
        <ul class="space-y-1 pl-1">
          <li class="flex gap-2"><span class="shrink-0">✓</span><span><strong>Cały miesiąc</strong> — ustaw wszystkie dni jako dostępne</span></li>
          <li class="flex gap-2"><span class="shrink-0">✕</span><span><strong>Cały miesiąc</strong> — ustaw wszystkie dni jako niedostępne</span></li>
        </ul>
      </div>

      <!-- Blokady -->
      <div>
        <p class="font-semibold text-slate-700 mb-1.5">🔒 Blokady — kiedy nie możesz edytować</p>
        <ul class="space-y-1 pl-1">
          <li class="flex gap-2"><span class="shrink-0">⏰</span><span><strong>Minione miesiące</strong> — zablokowane automatycznie</span></li>
          <li class="flex gap-2"><span class="shrink-0">⏰</span><span><strong>Standard:</strong> po 10. każdego miesiąca kolejny miesiąc jest automatycznie blokowany (nie możesz już zmieniać dostępności na następny miesiąc)</span></li>
          <li class="flex gap-2"><span class="shrink-0">🔒</span><span><strong>Ręczna blokada</strong> — administrator zablokował ten miesiąc lub Twoje konto</span></li>
        </ul>
      </div>

      <% if (user.role !== 'worker') { %>
      <!-- Admin section -->
      <div class="border-t border-slate-100 pt-3">
        <p class="font-semibold text-slate-700 mb-1.5">👤 Zarządzanie pracownikami (admin/kierownik)</p>
        <ul class="space-y-1.5 pl-1">
          <li class="flex gap-2"><span class="shrink-0">▾</span><span><strong>Lista rozwijana</strong> — wybierz pracownika, by edytować jego dostępność</span></li>
          <li class="flex gap-2"><span class="shrink-0">🔒🔓</span><span><strong>obok listy</strong> — zablokuj / odblokuj całą dostępność wybranego pracownika</span></li>
          <li class="flex gap-2"><span class="shrink-0">🔒</span><span><strong>Zablokuj miesiąc</strong> (przy nagłówku miesiąca) — blokada konkretnego miesiąca tylko dla wybranego pracownika</span></li>
        </ul>
      </div>
      <div>
        <p class="font-semibold text-slate-700 mb-1.5">👥 Blokowanie dla wszystkich</p>
        <ul class="space-y-1.5 pl-1">
          <li class="flex gap-2"><span class="shrink-0">📅</span><span><strong>Blokuj / odblokuj miesiąc</strong> — wybierz miesiąc i zablokuj lub odblokuj go dla wszystkich pracowników jednocześnie</span></li>
          <li class="flex gap-2"><span class="shrink-0">↩</span><span><strong>Standard</strong> — usuwa wszystkie ręczne blokady miesięcy; zostaje automatyczna reguła (po 10. blokuje kolejny miesiąc)</span></li>
        </ul>
      </div>
      <div>
        <p class="font-semibold text-slate-700 mb-1.5">Oznaczenia nagłówka miesiąca</p>
        <ul class="space-y-1 pl-1">
          <li class="flex gap-2"><span class="shrink-0 text-orange-400">⏰ standard</span><span>— miesiąc zablokowany przez regułę automatyczną (po 10.)</span></li>
          <li class="flex gap-2"><span class="shrink-0 text-amber-500">🔒 zablokowany</span><span>— miesiąc zablokowany ręcznie przez admina</span></li>
        </ul>
      </div>
      <% } %>

    </div>
  </div>
</div>

<!-- Month Lock Modal (admin/kierownik) -->
<div id="monthLockModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm">
    <div class="flex items-center justify-between p-5 border-b border-slate-200">
      <h3 class="font-semibold text-slate-800 text-sm">Blokada miesiąca – wszyscy pracownicy</h3>
      <button onclick="closeMonthLockModal()" class="text-slate-400 hover:text-slate-600 text-xl leading-none">✕</button>
    </div>
    <div class="p-5 space-y-4">
      <p class="text-xs text-slate-500 bg-slate-50 rounded-lg p-3 border border-slate-200">
        <strong class="text-slate-600">Standard:</strong> po 10. każdego miesiąca kolejny miesiąc jest automatycznie blokowany dla pracowników — nie mogą już zmieniać dostępności.<br>
        <span class="mt-1 block">Ręczna blokada/odblokowanie nadpisuje standard dla wybranego miesiąca. <em>↩ Standard</em> usuwa wszystkie ręczne blokady.</span>
      </p>
      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Miesiąc</label>
        <select id="lockModalMonthSelect" class="w-full px-3 py-2.5 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"></select>
      </div>
      <div class="flex gap-2 pt-1">
        <button onclick="lockMonthForAll(true)" class="flex-1 py-2.5 bg-amber-600 text-white rounded-lg text-sm font-medium hover:bg-amber-700 transition-colors">🔒 Zablokuj wszystkich</button>
        <button onclick="lockMonthForAll(false)" class="flex-1 py-2.5 bg-emerald-600 text-white rounded-lg text-sm font-medium hover:bg-emerald-700 transition-colors">🔓 Odblokuj wszystkich</button>
      </div>
    </div>
  </div>
</div>

<!-- Time Picker Modal -->
<div id="timePickerModal" class="hidden fixed inset-0 bg-black/50 flex items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm">
    <div class="flex items-center justify-between p-5 border-b border-slate-200">
      <h3 class="font-semibold text-slate-800 text-sm">Godziny dostępności</h3>
      <button onclick="closeTimePicker()" class="text-slate-400 hover:text-slate-600 text-xl leading-none">✕</button>
    </div>
    <div class="p-5 space-y-4">
      <input type="hidden" id="tpDate">
      <p class="text-xs text-slate-500">Zostaw puste = cały dzień</p>
      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1.5">Od</label>
          <div id="tpStartPicker" class="time-picker flex items-center gap-1">
            <select class="tp-hour flex-1 px-2 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="syncTimePicker(this.closest('.time-picker'))">
              <option value="">--</option>
              <% for(let h=0;h<24;h++){const hh=String(h).padStart(2,'0'); %><option value="<%= hh %>"><%= hh %></option><% } %>
            </select>
            <span class="text-slate-400 text-sm">:</span>
            <select class="tp-min w-14 px-2 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="syncTimePicker(this.closest('.time-picker'))">
              <option value="">--</option>
              <option value="00">00</option><option value="15">15</option><option value="30">30</option><option value="45">45</option>
            </select>
            <input type="hidden" id="tpStart">
          </div>
        </div>
        <div>
          <label class="block text-xs font-medium text-slate-600 mb-1.5">Do</label>
          <div id="tpEndPicker" class="time-picker flex items-center gap-1">
            <select class="tp-hour flex-1 px-2 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="syncTimePicker(this.closest('.time-picker'))">
              <option value="">--</option>
              <% for(let h=0;h<24;h++){const hh=String(h).padStart(2,'0'); %><option value="<%= hh %>"><%= hh %></option><% } %>
            </select>
            <span class="text-slate-400 text-sm">:</span>
            <select class="tp-min w-14 px-2 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" onchange="syncTimePicker(this.closest('.time-picker'))">
              <option value="">--</option>
              <option value="00">00</option><option value="15">15</option><option value="30">30</option><option value="45">45</option>
            </select>
            <input type="hidden" id="tpEnd">
          </div>
        </div>
      </div>
      <div id="tpError" class="hidden text-xs text-red-600 p-2 bg-red-50 rounded-lg"></div>
      <div class="flex gap-3 pt-1">
        <button type="button" onclick="clearTimeRange()" class="flex-1 py-2.5 border border-slate-300 text-slate-600 rounded-lg text-sm font-medium hover:bg-slate-50">Usuń godziny</button>
        <button type="button" onclick="saveTimeRange()" class="flex-1 py-2.5 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700">Zapisz</button>
      </div>
    </div>
  </div>
</div>

<div id="toastContainer" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-50 pointer-events-none"></div>

<script>
const availabilityTargetUserId = <%= targetUserId %>;

// Scroll to current week on load
window.addEventListener('DOMContentLoaded', () => {
  const el = document.getElementById('current-week');
  if (el) el.scrollIntoView({ behavior: 'instant', block: 'start' });
});
function showToast(msg, type) {
  const tc = document.getElementById('toastContainer');
  const t = document.createElement('div');
  t.className = 'px-4 py-2.5 rounded-xl shadow-lg text-sm font-medium pointer-events-auto mb-2 ' + (type === 'error' ? 'bg-red-600 text-white' : 'bg-emerald-600 text-white');
  t.textContent = msg;
  tc.appendChild(t);
  setTimeout(() => t.remove(), 3000);
}
const _MONTHS_PL_JS = ['Styczeń','Luty','Marzec','Kwiecień','Maj','Czerwiec','Lipiec','Sierpień','Wrzesień','Październik','Listopad','Grudzień'];
function openMonthLockModal() {
  const sel = document.getElementById('lockModalMonthSelect');
  sel.innerHTML = '';
  const today = new Date();
  for (let i = -2; i <= 12; i++) {
    const d = new Date(today.getFullYear(), today.getMonth() + i, 1);
    const ym = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
    const opt = document.createElement('option');
    opt.value = ym;
    opt.textContent = `${_MONTHS_PL_JS[d.getMonth()]} ${d.getFullYear()}`;
    if (i === 1) opt.selected = true;
    sel.appendChild(opt);
  }
  document.getElementById('monthLockModal').classList.remove('hidden');
}
function closeMonthLockModal() {
  document.getElementById('monthLockModal').classList.add('hidden');
}
async function lockMonthForAll(lock) {
  const yearMonth = document.getElementById('lockModalMonthSelect').value;
  try {
    const res = await fetch(`/api/availability/month/${yearMonth}/lock-all`, {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ locked: lock })
    });
    const data = await res.json();
    if (res.ok) {
      showToast(lock ? `🔒 Miesiąc ${yearMonth} zablokowany dla ${data.count} osób.` : `🔓 Miesiąc ${yearMonth} odblokowany dla ${data.count} osób.`);
      closeMonthLockModal();
      setTimeout(() => location.reload(), 900);
    } else {
      showToast(data.error || 'Wystąpił błąd.', 'error');
    }
  } catch(e) {
    showToast('Błąd połączenia.', 'error');
  }
}
async function resetToStandard() {
  if (!confirm('Usunąć wszystkie ręczne blokady miesięcy?\n\nStandard: po 10. każdego miesiąca kolejny miesiąc jest automatycznie blokowany dla pracowników.')) return;
  try {
    const res = await fetch('/api/availability/month-locks', { method: 'DELETE' });
    if (res.ok) {
      showToast('Przywrócono standard. Automatyczne blokady miesięcy aktywne.');
      setTimeout(() => location.reload(), 900);
    } else {
      const data = await res.json();
      showToast(data.error || 'Błąd.', 'error');
    }
  } catch(e) {
    showToast('Błąd połączenia.', 'error');
  }
}
async function toggleUserLock(userId, lock) {
  try {
    const res = await fetch(`/api/users/${userId}/availability-lock`, {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ locked: lock })
    });
    if (res.ok) {
      showToast(lock ? 'Dostępność zablokowana.' : 'Dostępność odblokowana.');
      setTimeout(() => location.reload(), 900);
    } else {
      showToast('Wystąpił błąd.', 'error');
    }
  } catch(e) {
    showToast('Błąd połączenia.', 'error');
  }
}
async function toggleMonthLock(yearMonth, lock, event) {
  if (event) event.stopPropagation();
  try {
    const res = await fetch(`/api/availability/month/${yearMonth}/lock`, {
      method: 'PUT', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ locked: lock, targetUserId: availabilityTargetUserId })
    });
    const data = await res.json();
    if (res.ok) {
      showToast(lock ? 'Miesiąc zablokowany dla pracownika.' : 'Miesiąc odblokowany dla pracownika.');
      setTimeout(() => location.reload(), 900);
    } else {
      showToast(data.error || 'Wystąpił błąd.', 'error');
    }
  } catch(e) {
    showToast('Błąd połączenia.', 'error');
  }
}
document.getElementById('monthLockModal').addEventListener('click', e => {
  if (e.target === document.getElementById('monthLockModal')) closeMonthLockModal();
});
document.getElementById('helpModal').addEventListener('click', e => {
  if (e.target === document.getElementById('helpModal')) document.getElementById('helpModal').classList.add('hidden');
});
</script>
<script src="/js/availability.js"></script>
<%- include('../partials/footer') %>
