<% locals.currentPath = '/deliveries'; %>
<%- include('../partials/head', { title: 'Raport dostaw' }) %>
<%- include('../partials/nav') %>

<%
function fmtDate(dateVal) {
  if (!dateVal) return '—';
  const d = new Date(dateVal);
  const dd = String(d.getUTCDate()).padStart(2,'0');
  const mm = String(d.getUTCMonth()+1).padStart(2,'0');
  const yyyy = d.getUTCFullYear();
  return `${dd}.${mm}.${yyyy}`;
}
%>

<div class="md:ml-60 pt-14 md:pt-0 min-h-screen bg-slate-50">
  <div class="max-w-5xl mx-auto px-4 py-6">

    <!-- Header -->
    <div class="flex items-center gap-3 mb-5">
      <a href="/deliveries" class="p-2 rounded-lg bg-white border border-slate-200 text-slate-500 hover:text-slate-700 hover:bg-slate-50 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <div>
        <h1 class="text-xl font-bold text-slate-800">Raport dostaw</h1>
        <p class="text-sm text-slate-500">Filtrowalny raport dla administratorów</p>
      </div>
    </div>

    <!-- Filters -->
    <form method="GET" action="/deliveries/report" class="bg-white border border-slate-200 rounded-xl p-4 mb-5">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Od</label>
          <input type="date" name="from" value="<%= from %>"
                 class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Do</label>
          <input type="date" name="to" value="<%= to %>"
                 class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400">
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Kategoria</label>
          <select name="category" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 bg-white">
            <option value="">Wszystkie</option>
            <% CATEGORIES.forEach(cat => { %>
            <option value="<%= cat %>" <%= categoryFilter === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-600 mb-1">Dostawca</label>
          <select name="supplier" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 bg-white">
            <option value="">Wszyscy</option>
            <% supplierRows.forEach(s => { %>
            <option value="<%= s.supplier %>" <%= supplierFilter === s.supplier ? 'selected' : '' %>><%= s.supplier %></option>
            <% }) %>
          </select>
        </div>
      </div>
      <div class="flex gap-2 mt-3">
        <button type="submit" class="px-4 py-2 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700 transition-colors">
          Filtruj
        </button>
        <a href="/deliveries/report" class="px-4 py-2 bg-white border border-slate-300 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50 transition-colors">
          Resetuj
        </a>
      </div>
    </form>

    <!-- Summary stats by category -->
    <% if (Object.keys(statsByCategory).length > 0) { %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 mb-5">
      <% Object.entries(statsByCategory).sort((a,b) => b[1]-a[1]).forEach(([cat, cnt]) => { %>
      <div class="bg-white border border-slate-200 rounded-xl px-4 py-3">
        <div class="text-xs text-slate-500 font-medium truncate"><%= cat %></div>
        <div class="text-2xl font-bold text-slate-800 mt-0.5"><%= cnt %></div>
        <div class="text-xs text-slate-400">dostaw<% if (cnt === 1) { %>a<% } else if (cnt < 5) { %>y<% } %></div>
      </div>
      <% }) %>
      <div class="bg-blue-600 border border-blue-700 rounded-xl px-4 py-3">
        <div class="text-xs text-blue-100 font-medium">Łącznie</div>
        <div class="text-2xl font-bold text-white mt-0.5"><%= deliveries.length %></div>
        <div class="text-xs text-blue-200">dostaw<% if (deliveries.length === 1) { %>a<% } else if (deliveries.length < 5) { %>y<% } %></div>
      </div>
    </div>
    <% } %>

    <!-- Results table -->
    <div class="bg-white border border-slate-200 rounded-xl overflow-hidden">
      <div class="px-4 py-3 border-b border-slate-200 bg-slate-50 flex items-center justify-between">
        <span class="text-sm font-semibold text-slate-700">Wyniki</span>
        <span class="text-xs text-slate-400"><%= deliveries.length %> rekord<% if (deliveries.length === 1) { %><% } else if (deliveries.length < 5) { %>y<% } else { %>ów<% } %></span>
      </div>

      <% if (deliveries.length === 0) { %>
      <div class="text-center py-12 text-slate-400">
        <p class="font-medium">Brak dostaw dla wybranych filtrów</p>
      </div>
      <% } else { %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-slate-100 text-left">
              <th class="px-4 py-3 font-semibold text-slate-600 text-xs uppercase tracking-wide">Data</th>
              <th class="px-4 py-3 font-semibold text-slate-600 text-xs uppercase tracking-wide">Dostawca</th>
              <th class="px-4 py-3 font-semibold text-slate-600 text-xs uppercase tracking-wide">Kategoria</th>
              <th class="px-4 py-3 font-semibold text-slate-600 text-xs uppercase tracking-wide">Opis</th>
              <th class="px-4 py-3 font-semibold text-slate-600 text-xs uppercase tracking-wide">Ilość</th>
              <th class="px-4 py-3 font-semibold text-slate-600 text-xs uppercase tracking-wide">Dodał(a)</th>
              <th class="px-4 py-3 font-semibold text-slate-600 text-xs uppercase tracking-wide">Uwagi</th>
              <th class="px-4 py-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-50">
            <% deliveries.forEach(d => { %>
            <tr class="hover:bg-slate-50 transition-colors">
              <td class="px-4 py-3 font-medium text-slate-800 whitespace-nowrap"><%= fmtDate(d.delivered_at) %></td>
              <td class="px-4 py-3 text-slate-700 whitespace-nowrap"><%= d.supplier || '—' %></td>
              <td class="px-4 py-3">
                <% if (d.category) { %>
                <span class="px-2 py-0.5 bg-blue-50 text-blue-700 border border-blue-100 rounded-full text-xs font-medium"><%= d.category %></span>
                <% } else { %><span class="text-slate-400">—</span><% } %>
              </td>
              <td class="px-4 py-3 text-slate-700 max-w-xs"><%= d.description %></td>
              <td class="px-4 py-3 text-slate-600 whitespace-nowrap"><%= d.quantity || '—' %></td>
              <td class="px-4 py-3 text-slate-500 whitespace-nowrap text-xs"><%= d.created_by_name || '—' %></td>
              <td class="px-4 py-3 text-slate-400 text-xs max-w-xs"><%= d.notes || '—' %></td>
              <td class="px-4 py-3 whitespace-nowrap">
                <a href="/deliveries/<%= d.id %>/edit" class="text-slate-400 hover:text-blue-600 transition-colors">
                  <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/></svg>
                </a>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <% } %>
    </div>

  </div>
</div>
