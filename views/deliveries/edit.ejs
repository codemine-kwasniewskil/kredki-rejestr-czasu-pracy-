<% locals.currentPath = '/deliveries'; %>
<%- include('../partials/head', { title: 'Edytuj dostawę' }) %>
<%- include('../partials/nav') %>

<div class="md:ml-60 pt-14 md:pt-0 min-h-screen bg-slate-50">
  <div class="max-w-xl mx-auto px-4 py-6">

    <div class="flex items-center gap-3 mb-5">
      <a href="/deliveries" class="p-2 rounded-lg bg-white border border-slate-200 text-slate-500 hover:text-slate-700 hover:bg-slate-50 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      </a>
      <h1 class="text-xl font-bold text-slate-800">Edytuj dostawę</h1>
    </div>

    <% if (error && error.length) { %>
    <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-800 text-sm"><%= error[0] %></div>
    <% } %>

    <form method="POST" action="/deliveries/<%= delivery.id %>?_method=PUT" class="bg-white border border-slate-200 rounded-xl p-5 space-y-4">

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Data dostawy <span class="text-red-500">*</span></label>
          <input type="date" name="delivered_at" value="<%= delivery.delivered_at %>" required
                 class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-100">
        </div>

        <div>
          <label class="block text-sm font-medium text-slate-700 mb-1.5">Kategoria</label>
          <select name="category" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-100 bg-white">
            <option value="">— wybierz —</option>
            <% CATEGORIES.forEach(cat => { %>
            <option value="<%= cat %>" <%= delivery.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Dostawca / Firma</label>
        <input type="text" name="supplier" value="<%= delivery.supplier || '' %>" placeholder="np. Inter-Mlecz, Cafex, Frisco…"
               class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-100">
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Opis dostawy <span class="text-red-500">*</span></label>
        <textarea name="description" rows="3" required
                  class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-100 resize-none"><%= delivery.description %></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Ilość / Liczba opakowań</label>
        <input type="text" name="quantity" value="<%= delivery.quantity || '' %>" placeholder="np. 5 kg, 3 skrzynki, 20 szt."
               class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-100">
      </div>

      <div>
        <label class="block text-sm font-medium text-slate-700 mb-1.5">Uwagi</label>
        <textarea name="notes" rows="2"
                  class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-blue-400 focus:ring-1 focus:ring-blue-100 resize-none"><%= delivery.notes || '' %></textarea>
      </div>

      <div class="flex gap-3 pt-1">
        <button type="submit" class="flex-1 sm:flex-none px-5 py-2.5 bg-blue-600 text-white rounded-lg text-sm font-medium hover:bg-blue-700 transition-colors">
          Zapisz zmiany
        </button>
        <a href="/deliveries" class="flex-1 sm:flex-none px-5 py-2.5 bg-white border border-slate-300 text-slate-700 rounded-lg text-sm font-medium hover:bg-slate-50 transition-colors text-center">
          Anuluj
        </a>
      </div>
    </form>

    <div class="mt-4 pt-4 border-t border-slate-200">
      <form method="POST" action="/deliveries/<%= delivery.id %>?_method=DELETE" onsubmit="return confirm('Usunąć tę dostawę?')">
        <button type="submit" class="text-sm text-red-500 hover:text-red-700 transition-colors">
          Usuń dostawę
        </button>
      </form>
    </div>

  </div>
</div>
