<% locals.currentPath = '/dashboard'; %>
<%- include('partials/head', { title: 'Panel główny' }) %>
<%- include('partials/nav') %>

<main class="md:ml-60 min-h-screen p-6 pt-20 md:pt-6">
  <div class="max-w-6xl mx-auto">
    <h1 class="text-xl font-bold text-slate-800 mb-6">Witaj, <%= user.name %>!</h1>

    <% if (success && success.length) { %>
      <div class="mb-4 p-3 bg-emerald-50 border border-emerald-200 rounded-lg text-emerald-700 text-sm"><%= success[0] %></div>
    <% } %>
    <% if (error && error.length) { %>
      <div class="mb-4 p-3 bg-red-50 border border-red-200 rounded-lg text-red-700 text-sm"><%= error[0] %></div>
    <% } %>

    <% if (user.role === 'admin') { %>
      <!-- Admin dashboard -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
        <div class="bg-white rounded-xl border border-slate-200 p-5">
          <div class="text-3xl font-bold text-blue-600"><%= workers %></div>
          <div class="text-sm text-slate-500 mt-1">Aktywni pracownicy</div>
          <a href="/users" class="text-xs text-blue-600 hover:underline mt-2 inline-block">Zarządzaj →</a>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-5">
          <div class="text-3xl font-bold text-amber-500"><%= pending %></div>
          <div class="text-sm text-slate-500 mt-1">Grafiki czekające na akceptację</div>
          <a href="/schedule" class="text-xs text-blue-600 hover:underline mt-2 inline-block">Otwórz grafik →</a>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-5">
          <div class="text-2xl font-bold text-slate-700">Grafik</div>
          <div class="text-sm text-slate-500 mt-1">Bieżący tydzień</div>
          <a href="/schedule" class="text-xs text-blue-600 hover:underline mt-2 inline-block">Otwórz grafik →</a>
        </div>
      </div>

      <!-- Pending approval -->
      <% if (pendingSchedules.length > 0) { %>
      <div class="bg-white rounded-xl border border-slate-200 p-5 mb-4">
        <h2 class="font-semibold text-slate-700 mb-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-amber-400"></span> Grafiki do zatwierdzenia
        </h2>
        <div class="space-y-2">
          <% pendingSchedules.forEach(s => { %>
          <div class="flex items-center justify-between p-3 bg-amber-50 border border-amber-200 rounded-lg">
            <div>
              <span class="font-medium text-slate-700">Tydzień: <%= s.week_start %></span>
              <span class="ml-2 text-xs bg-amber-100 text-amber-700 px-2 py-0.5 rounded-full">Oczekuje</span>
            </div>
            <a href="/schedule/week/<%= s.week_start %>" class="btn btn-primary text-xs">Zatwierdź</a>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <!-- Approved schedules -->
      <% if (approvedSchedules.length > 0) { %>
      <div class="bg-white rounded-xl border border-slate-200 p-5 mb-4">
        <h2 class="font-semibold text-slate-700 mb-3 flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span> Zatwierdzone grafiki
        </h2>
        <div class="space-y-2">
          <% approvedSchedules.forEach(s => { %>
          <div class="flex items-center justify-between p-3 bg-emerald-50 border border-emerald-100 rounded-lg">
            <div>
              <span class="font-medium text-slate-700">Tydzień: <%= s.week_start %></span>
              <span class="ml-2 text-xs bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full">Zatwierdzony</span>
            </div>
            <a href="/schedule/week/<%= s.week_start %>" class="btn btn-secondary text-xs">Edytuj</a>
          </div>
          <% }) %>
        </div>
      </div>
      <% } %>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="bg-white rounded-xl border border-slate-200 p-5">
          <h2 class="font-semibold text-slate-700 mb-3">Godziny pracowników (bieżący miesiąc)</h2>
          <% if (workerHours.length === 0) { %>
            <p class="text-slate-400 text-sm">Brak pracowników.</p>
          <% } else { %>
          <div class="space-y-2">
            <% workerHours.forEach(w => { %>
            <div class="flex items-center gap-3">
              <div class="w-28 text-sm font-medium text-slate-700 truncate"><%= w.name %></div>
              <div class="flex-1">
                <div class="flex items-center gap-2">
                  <div class="flex-1 bg-slate-100 rounded-full h-2">
                    <div class="h-2 rounded-full <%= w.scheduledHours >= (w.min_hours_per_month||0) ? 'bg-emerald-500' : 'bg-blue-500' %>"
                         style="width:<%= w.min_hours_per_month ? Math.min(100, (w.scheduledHours/w.min_hours_per_month)*100) : 0 %>%"></div>
                  </div>
                  <span class="text-xs text-slate-500 whitespace-nowrap">
                    <%= w.scheduledHours.toFixed(1) %>h<% if(w.min_hours_per_month){ %> / <%= w.min_hours_per_month %>h<% } %>
                  </span>
                </div>
              </div>
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>

        <div class="bg-white rounded-xl border border-slate-200 p-5">
          <h2 class="font-semibold text-slate-700 mb-3">Moje godziny — ostatnie miesiące</h2>
          <% if (monthlyHoursHistory.length === 0) { %>
            <p class="text-slate-400 text-sm">Brak danych.</p>
          <% } else { %>
          <div class="space-y-2">
            <% monthlyHoursHistory.forEach(m => { %>
            <div class="flex items-center justify-between text-sm">
              <span class="text-slate-600 capitalize"><%= m.label %></span>
              <span class="font-semibold <%= m.hours > 0 ? 'text-slate-800' : 'text-slate-400' %>">
                <%= m.hours > 0 ? (Math.floor(m.hours) + 'h' + (Math.round((m.hours % 1) * 60) > 0 ? ' ' + Math.round((m.hours % 1) * 60) + 'm' : '')) : '—' %>
              </span>
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>
      </div>

    <% } else if (user.role === 'location_manager') { %>
      <!-- Manager dashboard -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
        <div class="bg-white rounded-xl border border-slate-200 p-5">
          <div class="flex items-center justify-between mb-3">
            <h2 class="font-semibold text-slate-700">Grafik tego tygodnia</h2>
            <% if (mySchedule) { %>
              <span class="text-xs px-2 py-1 rounded-full badge-<%= mySchedule.status %>">
                <%= mySchedule.status === 'draft' ? 'Szkic' : mySchedule.status === 'submitted' ? 'Oczekuje' : mySchedule.status === 'approved' ? 'Zatwierdzony' : 'Odrzucony' %>
              </span>
            <% } %>
          </div>
          <a href="/schedule" class="btn btn-primary w-full justify-center">Otwórz grafik</a>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-5">
          <h2 class="font-semibold text-slate-700 mb-3">Godziny pracowników</h2>
          <% if (workerHours.length === 0) { %>
            <p class="text-slate-400 text-sm">Brak pracowników.</p>
          <% } else { %>
          <div class="space-y-2">
            <% workerHours.slice(0,5).forEach(w => { %>
            <div class="flex items-center gap-2">
              <div class="w-24 text-sm text-slate-700 truncate"><%= w.name %></div>
              <div class="flex-1 bg-slate-100 rounded-full h-2">
                <div class="h-2 rounded-full <%= w.scheduledHours >= (w.min_hours_per_month||0) ? 'bg-emerald-500' : 'bg-blue-500' %>"
                     style="width:<%= w.min_hours_per_month ? Math.min(100,(w.scheduledHours/w.min_hours_per_month)*100) : 0 %>%"></div>
              </div>
              <span class="text-xs text-slate-500"><%= w.scheduledHours.toFixed(1) %>h</span>
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>
      <% if (monthlyHoursHistory.length > 0) { %>
      <div class="bg-white rounded-xl border border-slate-200 p-5">
        <div class="flex items-center justify-between">
          <h2 class="font-semibold text-slate-700">Moje godziny — <span class="capitalize"><%= monthlyHoursHistory[0].label %></span></h2>
          <span class="text-2xl font-bold text-slate-800">
            <% const mh = monthlyHoursHistory[0]; %>
            <%= mh.hours > 0 ? Math.floor(mh.hours) + 'h' + (Math.round((mh.hours % 1)*60) > 0 ? ' ' + Math.round((mh.hours % 1)*60) + 'm' : '') : '—' %>
          </span>
        </div>
      </div>
      <% } %>

    <% } else { %>
      <!-- Worker dashboard -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
        <div class="bg-white rounded-xl border border-slate-200 p-5 flex flex-col">
          <h2 class="font-semibold text-slate-700 mb-3">Moje nadchodzące zmiany</h2>
          <% if (myShifts.length === 0) { %>
            <p class="text-slate-400 text-sm">Brak zaplanowanych zmian.</p>
          <% } else { %>
          <div class="space-y-1.5 overflow-y-auto max-h-72 pr-1">
            <% myShifts.forEach(s => { %>
            <div class="flex items-center gap-3 p-2 rounded-lg" style="background-color:<%= s.color %>18">
              <div class="w-2 h-2 rounded-full flex-shrink-0" style="background-color:<%= s.color %>"></div>
              <div class="flex-1 min-w-0">
                <div class="text-sm font-medium text-slate-700"><%= s.date %></div>
                <div class="text-xs text-slate-500"><%= s.shift_name %> (<%= s.start_time %> – <%= s.end_time %>)</div>
              </div>
              <button
                id="confirm-<%= s.id %>"
                onclick="toggleConfirm(<%= s.id %>, this)"
                class="flex-shrink-0 w-7 h-7 rounded-full border-2 flex items-center justify-center text-xs transition-colors <%= s.confirmed_by_employee ? 'bg-emerald-500 border-emerald-500 text-white' : 'border-slate-300 text-slate-300 hover:border-emerald-400 hover:text-emerald-400' %>"
                title="<%= s.confirmed_by_employee ? 'Potwierdzona — kliknij by cofnąć' : 'Kliknij by potwierdzić zmianę' %>"
              ><%= s.confirmed_by_employee ? '✓' : '○' %></button>
            </div>
            <% }) %>
          </div>
          <% } %>
        </div>
      </div>
      <% if (monthlyHoursHistory.length > 0) { %>
      <div class="bg-white rounded-xl border border-slate-200 p-5 mb-4">
        <div class="flex items-center justify-between">
          <h2 class="font-semibold text-slate-700">Moje godziny — <span class="capitalize"><%= monthlyHoursHistory[0].label %></span></h2>
          <span class="text-2xl font-bold text-slate-800">
            <% const wh = monthlyHoursHistory[0]; %>
            <%= wh.hours > 0 ? Math.floor(wh.hours) + 'h' + (Math.round((wh.hours % 1)*60) > 0 ? ' ' + Math.round((wh.hours % 1)*60) + 'm' : '') : '—' %>
          </span>
        </div>
      </div>
      <% } %>
    <% } %>
  </div>
</main>

<script>
function toggleConfirm(entryId, btn) {
  fetch(`/api/schedule/entry/${entryId}/confirm`, { method: 'POST' })
    .then(r => r.json())
    .then(d => {
      if (!d.ok) return;
      if (d.confirmed) {
        btn.className = btn.className.replace('border-slate-300 text-slate-300 hover:border-emerald-400 hover:text-emerald-400', 'bg-emerald-500 border-emerald-500 text-white');
        btn.textContent = '✓';
        btn.title = 'Potwierdzona — kliknij by cofnąć';
      } else {
        btn.className = btn.className.replace('bg-emerald-500 border-emerald-500 text-white', 'border-slate-300 text-slate-300 hover:border-emerald-400 hover:text-emerald-400');
        btn.textContent = '○';
        btn.title = 'Kliknij by potwierdzić zmianę';
      }
    })
    .catch(console.error);
}
</script>
<%- include('partials/footer') %>
