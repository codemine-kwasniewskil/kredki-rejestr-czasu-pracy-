{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ],
  "crons": [
    {
      "path": "/orders/cron/sync-catalog",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/orders/cron/sync-availability",
      "schedule": "0 * * * *"
    }
  ]
}
